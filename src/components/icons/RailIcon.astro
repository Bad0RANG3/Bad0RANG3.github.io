---
export type RailIconName = 'home' | 'posts' | 'projects' | 'tools' | 'about' | 'more';

interface Props {
  name: RailIconName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

{name === 'home' && <svg class={`rail-glyph ${className}`} viewBox="0 0 24 24" aria-hidden="true"><path d="m4 10.8 8-6.7 8 6.7v8.1a1.8 1.8 0 0 1-1.8 1.8H5.8A1.8 1.8 0 0 1 4 18.9v-8.1Z"/><path d="M9.2 20.7v-5.2h5.6v5.2"/><path d="M12 8.5v.1"/></svg>}
{name === 'posts' && <svg class={`rail-glyph ${className}`} viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3.5" width="16" height="17" rx="3"/><path d="M8 8h8M8 12h8M8 16h4.2"/><circle cx="17" cy="16" r="1"/></svg>}
{name === 'projects' && <svg class={`rail-glyph ${className}`} viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="17.5" r="2"/><circle cx="17.5" cy="6.5" r="2"/><circle cx="18" cy="18" r="2"/><path d="m7.5 16.2 8.5-8.4M8 18h8"/></svg>}
{name === 'tools' && <svg class={`rail-glyph ${className}`} viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5h14M5 12h14M5 18.5h14"/><circle cx="9" cy="5.5" r="2"/><circle cx="15.5" cy="12" r="2"/><circle cx="11.5" cy="18.5" r="2"/></svg>}
{name === 'about' && <svg class={`rail-glyph ${className}`} viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20c.7-3.6 3.1-5.6 7-5.6s6.3 2 7 5.6"/><path d="M4 4.5h2M18 4.5h2M12 2v2"/></svg>}
{name === 'more' && <svg class={`rail-glyph ${className}`} viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="7" r="1.6"/><circle cx="17" cy="7" r="1.6"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/><path d="M9.6 7h4.8M7 9.6v4.8M17 9.6v4.8M9.6 17h4.8"/></svg>}
