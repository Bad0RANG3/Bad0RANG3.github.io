---
import { withBase } from '../../lib/urls';

type CardTone = 'default' | 'teal' | 'coral' | 'citrus';

interface Props {
  href: string;
  title: string;
  description: string;
  label?: string;
  meta?: string;
  icon?: string;
  tone?: CardTone;
  headingTag?: 'h2' | 'h3';
}

const {
  href,
  title,
  description,
  label,
  meta,
  icon,
  tone = 'default',
  headingTag = 'h3',
} = Astro.props;
const Heading = headingTag;
---

<a href={withBase(href)} class="group block h-full reveal">
  <article
    class:list={[
      'hard-card flex h-full flex-col rounded-[1.5rem] bg-base-100/90 p-5 sm:p-6',
      tone === 'teal' && 'hard-card-teal',
      tone === 'citrus' && 'hard-card-citrus',
    ]}
  >
    {(icon || label) && (
      <div class="flex min-h-8 items-center gap-3">
        {icon && <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border-2 border-base-content/10 bg-base-200 text-xl">{icon}</span>}
        {label && <p class="eyebrow">{label}</p>}
      </div>
    )}

    <Heading class:list={['text-xl font-black leading-tight text-base-content transition-colors group-hover:text-primary sm:text-2xl', (icon || label) && 'mt-5']}>
      {title}
    </Heading>
    <p class="mt-3 line-clamp-3 text-sm leading-7 text-base-content/60">{description}</p>
    {meta && <p class="mt-auto pt-6 text-xs font-bold text-base-content/45">{meta}</p>}
  </article>
</a>
