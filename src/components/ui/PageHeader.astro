---
import { isLatinOnly } from '../../lib/text';

interface Props {
  label: string;
  title: string;
  description?: string;
}
const { label, title, description } = Astro.props;
---

<div class="page-header reveal mb-7 sm:mb-10">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
      <p class:list={['eyebrow', isLatinOnly(label) && 'eyebrow-latin']}>{label}</p>
      <h1 class="display-title mt-2 text-3xl sm:text-4xl md:text-5xl lg:text-6xl">{title}</h1>
      {description && (
        <p class="mt-4 max-w-2xl text-sm leading-7 text-base-content/80 sm:text-base">
          {description}
        </p>
      )}
    </div>

  </div>
  <div class="page-header-line mt-6"></div>
</div>
