---
interface Props {
  label: string;
  title: string;
  description?: string;
}
const { label, title, description } = Astro.props;
---

<div class="reveal mb-7 sm:mb-10">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
      <p class="eyebrow">{label}</p>
      <h1 class="display-title mt-2 text-3xl sm:text-4xl md:text-5xl lg:text-6xl">{title}</h1>
      {description && (
        <p class="mt-4 max-w-2xl text-sm leading-7 text-base-content/60 sm:text-base">
          {description}
        </p>
      )}
    </div>

  </div>
  <div class="mt-6 h-1.5 w-full bg-gradient-to-r from-primary via-secondary to-accent"></div>
</div>
