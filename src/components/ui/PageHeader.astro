---
interface Props {
  label: string;
  title: string;
  description?: string;
}
const { label, title, description } = Astro.props;
---

<div class="reveal mb-8 sm:mb-12 text-center max-w-3xl mx-auto">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">{label}</p>
  <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold" style="--reveal-delay:80ms">{title}</h1>
  {description && <p class="mt-3 text-sm sm:text-base text-base-content/60" style="--reveal-delay:150ms">{description}</p>}
</div>
