---
import { isLatinOnly } from '../../lib/text';

interface Props { label: string; title: string; titleId?: string; }
const { label, title, titleId } = Astro.props;
---

<div class="section-heading mb-5">
  <p class:list={['eyebrow', isLatinOnly(label) && 'eyebrow-latin']}>{label}</p>
  <h2 id={titleId} class="mt-2 text-xl font-bold sm:text-2xl">{title}</h2>
</div>
