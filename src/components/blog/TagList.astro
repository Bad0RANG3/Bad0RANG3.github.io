---
interface Props { tags: string[]; linked?: boolean; }
const { tags, linked = true } = Astro.props;
---
{tags.length > 0 && <div class="flex flex-wrap gap-1.5">{tags.map(t => linked ? <a href={`/tags/${encodeURIComponent(t)}`} class="badge badge-ghost badge-sm transition-colors hover:badge-primary">#{t}</a> : <span class="badge badge-ghost badge-sm">#{t}</span>)}</div>}
