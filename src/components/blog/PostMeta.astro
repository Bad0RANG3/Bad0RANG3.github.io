---
import { formatDate, formatLongDate } from '../../lib/date';
interface Props { date: Date; updatedDate?: Date; centered?: boolean; long?: boolean; }
const { date, updatedDate, centered = false, long = false } = Astro.props;
const fmt = long ? formatLongDate : formatDate;
---
<div class:list={['flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-400', centered && 'justify-center']}>
  <time datetime={date.toISOString()} class="inline-flex items-center gap-1.5">
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
    {fmt(date)}
  </time>
  {updatedDate && updatedDate.valueOf() !== date.valueOf() && (
    <time datetime={updatedDate.toISOString()} class="inline-flex items-center gap-1.5">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      更新于 {fmt(updatedDate)}
    </time>
  )}
</div>
