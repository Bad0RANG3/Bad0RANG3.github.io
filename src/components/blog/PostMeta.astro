---
import { formatDate, formatLongDate } from '../../lib/date';
import Icon from '../icons/Icons.astro';
interface Props { date: Date; updatedDate?: Date; centered?: boolean; long?: boolean; }
const { date, updatedDate, centered = false, long = false } = Astro.props;
const fmt = long ? formatLongDate : formatDate;
---

<div class:list={['flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content/50', centered && 'justify-center']}>
  <time datetime={date.toISOString()} class="inline-flex items-center gap-1.5">
    <Icon name="calendar" class="h-3.5 w-3.5" />
    {fmt(date)}
  </time>
  {updatedDate && updatedDate.valueOf() !== date.valueOf() && (
    <time datetime={updatedDate.toISOString()} class="inline-flex items-center gap-1.5">
      <Icon name="clock" class="h-3.5 w-3.5" />
      更新于 {fmt(updatedDate)}
    </time>
  )}
</div>
