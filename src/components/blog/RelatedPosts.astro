---
import { withBase } from '../../lib/urls';
import type { Post } from '../../lib/content';
import PostCard from './PostCard.astro';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
{posts.length > 0 && (
  <section class="mt-14 border-t-2 border-base-content/10 pt-8" aria-labelledby="related-title">
    <div class="mb-5 flex items-end justify-between gap-4"><div><p class="eyebrow">Keep exploring</p><h2 id="related-title" class="display-title text-3xl">相关文章</h2></div><a class="link-underline text-sm font-bold" href={withBase('/posts/')}>查看全部 →</a></div>
    <div class="grid gap-4 md:grid-cols-3">{posts.map((post) => <PostCard post={post} />)}</div>
  </section>
)}