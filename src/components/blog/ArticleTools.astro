---
interface Props {
  slug: string;
  title?: string;
}
const { slug, title } = Astro.props;
---

<div class="article-tools not-prose" data-article-tools data-slug={slug} data-title={title}>
  <button type="button" class="btn btn-sm btn-ghost gap-2" data-bookmark aria-pressed="false">
    <span aria-hidden="true">☆</span><span data-bookmark-label>收藏</span>
  </button>
  <button type="button" class="btn btn-sm btn-ghost gap-2" data-share-link>
    <span aria-hidden="true">↗</span><span data-copy-link-label>分享</span>
  </button>
</div>
