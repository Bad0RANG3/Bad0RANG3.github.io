---
import { siteConfig, SITE } from '../../config/site';
const { repo, repoId, categoryId, category } = siteConfig.giscus;
const themeDark = SITE.THEME_DARK;
---

<section
  class="deferred-section mx-auto mt-12 border-t border-base-content/10 pt-8 sm:mt-16 sm:pt-10"
  data-comments
  data-repo={repo}
  data-repo-id={repoId}
  data-category={category}
  data-category-id={categoryId}
  data-theme-dark={themeDark}
>
  <h2 class="mt-2 text-lg font-bold sm:text-xl">评论</h2>
  <div class="giscus mt-6 min-h-24" data-giscus-container><p class="text-sm text-base-content/45">滚动到这里时加载评论…</p></div>
</section>
