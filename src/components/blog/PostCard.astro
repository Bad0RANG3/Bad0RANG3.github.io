---
import type { Post } from '../../lib/content';
import { getPostReadingMinutes } from '../../lib/content';
import { formatDate } from '../../lib/date';
import { postPath } from '../../config/routes';
import ContentCard from '../ui/ContentCard.astro';

interface Props {
  post: Post;
  headingTag?: 'h2' | 'h3';
}

const { post, headingTag = 'h3' } = Astro.props;
const readingMinutes = getPostReadingMinutes(post);
const latestDate = post.data.updatedDate ?? post.data.date;
const meta = `${formatDate(latestDate)} · ${readingMinutes} 分钟阅读`;
---

<ContentCard
  href={postPath(post.slug)}
  title={post.data.title}
  description={post.data.description}
  label={post.data.category}
  meta={meta}
  tone="teal"
  headingTag={headingTag}
/>
