---
import { withBase } from '../../lib/urls';
import type { Project } from '../../config/projects';
import Icon from '../icons/Icons.astro';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article
  class:list={[
    'hard-card flex h-full flex-col rounded-[1.5rem] border-2 border-base-content/15 bg-base-100/90 p-5 sm:p-6',
    project.tone === 'teal' && 'hard-card-teal',
    project.tone === 'coral' && 'hard-card',
    project.tone === 'citrus' && 'hard-card-citrus',
    featured && 'min-h-[18rem]',
  ]}
  data-project-card
  data-project-type={project.type}
  data-project-status={project.status}
  data-project-tags={project.tags.join('|')}
>
  <div class="flex items-start justify-between gap-4">
    <span class="font-mono text-xs font-black tracking-[0.22em] text-base-content/40">{project.code}</span>
    <span class:list={['chip-signal', project.tone === 'teal' && 'chip-teal', project.tone === 'citrus' && 'chip-lime']}>{project.type}</span>
  </div>
  <div class="mt-8">
    <div class="flex items-center gap-2 text-xs font-black uppercase tracking-[0.16em] text-primary">
      <span class="h-2 w-2 rounded-full bg-current"></span>
      {project.status}
    </div>
    <h3 class="mt-3 text-2xl font-black tracking-tight sm:text-3xl">{project.name}</h3>
    <p class="mt-3 text-sm font-bold leading-6 text-base-content/75">{project.summary}</p>
    {featured && <p class="mt-3 text-sm leading-7 text-base-content/55">{project.description}</p>}
  </div>
  <div class="mt-auto pt-8">
    <div class="flex flex-wrap gap-1.5">
      {project.tags.map((tag) => <span class="badge badge-ghost badge-sm border border-base-content/10 bg-base-200/70">{tag}</span>)}
    </div>
    <div class="mt-5 flex flex-wrap gap-2">
      <a href={withBase(`/projects/${project.slug}/`)} class="btn btn-sm border-2 border-base-content bg-primary font-black text-primary-content shadow-[3px_3px_0_0] shadow-base-content hover:-translate-y-0.5">
        查看案例
      </a>
      <a href={withBase(project.href)} class="btn btn-sm btn-ghost border-2 border-base-content/15 font-bold hover:border-primary/60 hover:bg-primary/10">
        {project.primaryActionLabel}
        <Icon name="arrow-up-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</article>
