---
import type { Project } from '../../config/projects';
import ContentCard from '../ui/ContentCard.astro';

interface Props {
  project: Project;
  headingTag?: 'h2' | 'h3';
}

const { project, headingTag = 'h3' } = Astro.props;
---

<ContentCard
  href={project.href}
  title={project.name}
  description={project.summary}
  tone={project.tone}
  headingTag={headingTag}
/>
