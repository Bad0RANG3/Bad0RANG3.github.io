---
import { ROUTES } from '../../config/routes';
import { LAYOUT } from '../../config/ui';
import { withBase } from '../../lib/urls';
---

<dialog id="search-modal" class="modal" aria-label="搜索文章">
  <div class="modal-box max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-2xl border-2 border-base-content/10 bg-base-100 p-0 shadow-[10px_10px_0_0] shadow-primary/40">
    <div class="flex items-center gap-3 border-b-2 border-base-content/10 bg-secondary/20 px-4 py-3">
      <svg class="h-5 w-5 shrink-0 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input id="search-input" type="search" class="flex-1 bg-transparent text-base outline-none placeholder:text-base-content/40" placeholder="搜索标题、摘要、正文、标签..." autocomplete="off" aria-label="搜索文章" />
      <kbd class="hidden sm:inline-flex items-center rounded bg-base-200 px-1.5 py-0.5 font-mono text-xs text-base-content/40">ESC</kbd>
    </div>
    <div id="search-filters" class="flex flex-wrap gap-2 border-b border-base-content/10 px-4 py-2" hidden></div>
    <div id="search-results" class="max-h-[min(28rem,60dvh)] overflow-y-auto" aria-live="polite">
      <div class="px-4 py-8 text-center text-sm text-base-content/50">打开搜索后加载索引...</div>
    </div>
    <div id="search-footer" class="hidden border-t border-base-content/10 px-4 py-2 text-center text-xs text-base-content/40"></div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>关闭</button></form>
</dialog>

<script is:inline data-astro-rerun define:vars={{ indexUrl: withBase(ROUTES.SEARCH_INDEX), postsUrl: withBase(ROUTES.POSTS), defaultCount: LAYOUT.SEARCH_DEFAULT_COUNT, focusDelay: LAYOUT.SEARCH_FOCUS_DELAY }}>
  // @ts-nocheck
  (() => {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const footer = document.getElementById('search-footer');
    const filters = document.getElementById('search-filters');
    const openButton = document.getElementById('search-btn');
    if (!modal || !input || !results || !footer || !openButton) return;
    if (modal.dataset.bound === '1') return;
    modal.dataset.bound = '1';

    let documents = [];
    let activeType = 'all';
    const typeLabels = { all: '全部', post: '文章', thought: '碎碎念', project: '项目', tool: '工具' };

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const tokens = (query) => query.toLowerCase().trim().split(/\s+/).filter(Boolean).slice(0, 8);
    // Highlight in ONE pass over the raw text. Replacing token-by-token on
    // already-rendered HTML lets a later token match the <mark> markup (a query
    // like "class" or "primary" corrupts the result), so only the gaps and the
    // matches are escaped and the markup is never re-scanned.
    const highlight = (value, query) => {
      const text = String(value ?? '');
      const patterns = tokens(query).map(escapeRegExp).sort((a, b) => b.length - a.length);
      if (!patterns.length) return escapeHtml(text);
      const matcher = new RegExp(patterns.join('|'), 'gi');
      let html = '';
      let cursor = 0;
      for (const match of text.matchAll(matcher)) {
        html += escapeHtml(text.slice(cursor, match.index)) + '<mark class="rounded bg-primary/20 px-0.5 text-inherit">' + escapeHtml(match[0]) + '</mark>';
        cursor = match.index + match[0].length;
      }
      return html + escapeHtml(text.slice(cursor));
    };
    // Lower-cased haystacks are built once when the index loads, not per
    // keystroke × token × document.
    const prepare = (item) => ({
      ...item,
      searchText: [item.title, item.description, item.body, ...(item.tags || []), item.category, item.series].filter(Boolean).join(' ').toLowerCase(),
      titleText: String(item.title || '').toLowerCase(),
      tagText: (item.tags || []).join(' ').toLowerCase(),
      descriptionText: String(item.description || '').toLowerCase(),
    });
    const score = (item, queryTokens) => queryTokens.reduce((total, token) => total
      + (item.titleText.includes(token) ? 20 : 0)
      + (item.tagText.includes(token) ? 12 : 0)
      + (item.descriptionText.includes(token) ? 8 : 0)
      + (item.searchText.includes(token) ? 2 : 0), item.featured ? 3 : 0);
    const excerpt = (item, query) => {
      const body = item.body || item.description || '';
      const token = tokens(query)[0];
      if (!token) return item.description;
      const index = body.toLowerCase().indexOf(token);
      if (index < 0) return item.description;
      const start = Math.max(0, index - 55);
      return `${start > 0 ? '…' : ''}${body.slice(start, index + 130)}${index + 130 < body.length ? '…' : ''}`;
    };
    const renderFilters = () => {
      const types = [...new Set(documents.map((item) => item.type).filter(Boolean))];
      if (types.length < 2) { filters.hidden = true; return; }
      filters.hidden = false;
      filters.innerHTML = ['all', ...types].map((type) => `<button type="button" data-search-type="${escapeHtml(type)}" aria-pressed="${activeType === type}" class="chip-signal ${activeType === type ? 'bg-primary/20' : ''}">${escapeHtml(typeLabels[type] ?? type)}</button>`).join('');
      filters.querySelectorAll('[data-search-type]').forEach((button) => button.addEventListener('click', () => { activeType = button.dataset.searchType || 'all'; renderFilters(); render(); }));
    };
    const render = () => {
      const query = input.value;
      const queryTokens = tokens(query);
      let items = documents.filter((item) => activeType === 'all' || item.type === activeType);
      if (queryTokens.length) items = items.filter((item) => queryTokens.every((token) => item.searchText.includes(token))).sort((a, b) => score(b, queryTokens) - score(a, queryTokens) || b.date.localeCompare(a.date));
      else items = items.slice(0, Number(defaultCount));
      if (!items.length) {
        results.innerHTML = '<div class="px-4 py-8 text-center text-sm text-base-content/50">没有找到匹配内容。试试标题、标签或正文里的其他关键词。</div>';
        footer.classList.add('hidden');
        return;
      }
      results.innerHTML = items.map((item) => `<a href="${escapeHtml(item.url)}" class="block border-b border-base-content/5 px-4 py-3 transition-colors last:border-0 hover:bg-base-200 focus:bg-base-200 focus:outline-none">
        <div class="flex items-start justify-between gap-3"><span class="text-sm font-bold text-base-content">${highlight(item.title, query)}</span>${item.date ? `<time class="shrink-0 text-xs text-base-content/40" datetime="${escapeHtml(item.date)}">${escapeHtml(item.date)}</time>` : `<span class="shrink-0 text-xs text-base-content/40">${escapeHtml(typeLabels[item.type] ?? '')}</span>`}</div>
        <p class="mt-1 line-clamp-2 text-xs leading-5 text-base-content/55">${highlight(excerpt(item, query), query)}</p>
        <div class="mt-2 flex flex-wrap gap-1.5">${(item.tags || []).slice(0, 4).map((tag) => `<span class="badge badge-ghost badge-xs">#${escapeHtml(tag)}</span>`).join('')}</div>
      </a>`).join('');
      footer.classList.remove('hidden');
      footer.textContent = `${items.length} 个结果${query.trim() ? '' : ' · 输入关键词搜索全文'}`;
    };
    // One in-flight request shared by every open(); a failed load clears it so
    // the next open retries.
    let loadPromise = null;
    const load = () => {
      if (documents.length) return Promise.resolve();
      if (loadPromise) return loadPromise;
      results.innerHTML = '<div class="px-4 py-8 text-center text-sm text-base-content/50">正在加载搜索索引...</div>';
      loadPromise = (async () => {
        try {
          const response = await fetch(indexUrl, { headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const payload = await response.json();
          documents = Array.isArray(payload) ? payload.map(prepare) : [];
        } catch {
          results.innerHTML = `<div class="px-4 py-8 text-center text-sm text-base-content/50">搜索索引加载失败，请直接浏览<a class="ml-1 font-bold text-primary underline" href="${postsUrl}">文章列表</a>。</div>`;
        } finally { loadPromise = null; }
      })();
      return loadPromise;
    };
    const open = () => {
      if (modal instanceof HTMLDialogElement && !modal.open) modal.showModal();
      input.value = '';
      activeType = 'all';
      // Only re-render once the index is in memory; otherwise load() owns the
      // results pane and its failure message must not be replaced by "no match".
      load().then(() => {
        if (!documents.length) return;
        renderFilters();
        render();
      });
      window.setTimeout(() => input.focus(), Number(focusDelay));
    };
    openButton.addEventListener('click', open);
    input.addEventListener('input', () => { if (documents.length) render(); });
    if (!window.__b0SearchShortcutBound) {
      window.__b0SearchShortcutBound = true;
      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          document.getElementById('search-btn')?.click();
        }
      });
    }
  })();
</script>
