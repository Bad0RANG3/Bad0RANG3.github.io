---
import { siteConfig } from '../../config/site';
import { SOCIAL_ICONS } from '../../constants';
import { withBase } from '../../lib/urls';

const { author, socials, navigation } = siteConfig;
const footerNav = [...navigation, { href: '/explore/', label: '探索' }, { href: '/tags/', label: '标签' }, { href: '/series/', label: '系列' }, { href: '/library/', label: '本地书架' }, { href: '/privacy/', label: '隐私说明' }].filter((item, index, items) => items.findIndex((candidate) => candidate.href === item.href) === index).map((item) => ({ href: item.href, text: item.label }));
const marquee = ['Stay Curious', 'Ship the Work', 'Keep Going', 'Make It Sing', 'Trust the Process', 'Finish with Heart', 'Create Daily', 'Own Your Craft', 'Light the Signal', 'Begin Again'];
---

<footer class="relative mt-auto overflow-hidden border-t-2 border-base-content/10 bg-base-200/80">
  <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-primary via-secondary to-accent"></div>
  <div class="pointer-events-none absolute -right-20 bottom-0 h-56 w-56 rounded-full bg-primary/15 blur-3xl"></div>
  <div class="pointer-events-none absolute -left-16 top-10 h-40 w-40 rounded-full bg-secondary/30 blur-3xl"></div>

  <div class="site-frame relative py-12 md:py-14">
    <div class="grid gap-10 grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]">
      <div>
        <div class="flex items-start gap-4">
          <figure class="h-16 w-16 shrink-0 overflow-hidden rounded-2xl border-2 border-base-content shadow-[5px_5px_0_0] shadow-primary">
            <img src={withBase(author.avatar)} alt={author.name} class="h-full w-full object-cover" width="64" height="64" loading="lazy" />
          </figure>
          <div>
            <a href={withBase('/')} class="text-xl font-black tracking-tight">
              <span class="bg-gradient-to-r from-primary via-[#ff7a45] to-accent bg-clip-text text-transparent">{siteConfig.title}</span>
            </a>
            <p class="mt-2 max-w-md text-sm leading-7 text-base-content/60">{siteConfig.description}</p>
          </div>
        </div>

        <div class="marquee-band mt-8 overflow-hidden rounded-2xl border-2 px-4 py-3">
          <div class="marquee-track gap-6 text-xs font-black uppercase tracking-[0.24em]">
            {[...marquee, ...marquee].map((t) => (
              <span class="inline-flex items-center gap-6 whitespace-nowrap">
                <span>{t}</span>
                <span class="marquee-dot h-1.5 w-1.5 rounded-full"></span>
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.22em] text-base-content/40">Navigate</p>
          <ul class="mt-4 space-y-2">
            {footerNav.map((item) => (
              <li>
                <a href={withBase(item.href)} class="link-underline text-sm font-bold text-base-content/70 hover:text-primary">
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="text-xs font-black uppercase tracking-[0.22em] text-base-content/40">Connect</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {socials.map((social) => (
              <a
                href={social.url}
                target={social.url.startsWith('mailto:') ? undefined : '_blank'}
                rel={social.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                class="inline-flex items-center gap-2 rounded-full border-2 border-base-content/10 bg-base-100 px-3 py-1.5 text-xs font-bold text-base-content/70 transition hover:-translate-y-0.5 hover:border-primary/40 hover:text-primary"
                aria-label={social.name}
              >
                {SOCIAL_ICONS[social.name as keyof typeof SOCIAL_ICONS] ? (
                  <img src={withBase(SOCIAL_ICONS[social.name as keyof typeof SOCIAL_ICONS])} alt="" class="h-3.5 w-3.5 opacity-70" width="14" height="14" loading="lazy" />
                ) : null}
                <span>{social.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t-2 border-base-content/10 pt-6 text-xs font-bold uppercase tracking-[0.18em] text-base-content/40 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {author.name}</p>
      <p class="text-base-content/35"><a class="hover:text-primary" href={withBase('/rss.xml')}>RSS</a> · <a class="hover:text-primary" href={withBase('/atom.xml')}>Atom</a> · <a class="hover:text-primary" href={withBase('/feed.json')}>JSON Feed</a></p>
    </div>
  </div>
</footer>
