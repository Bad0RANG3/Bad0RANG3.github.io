---
import { siteConfig } from '../../config/site';
import { ROUTES } from '../../config/routes';
import { withBase } from '../../lib/urls';

interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const { author } = siteConfig;
---

<footer class:list={['site-footer', compact && 'site-footer--compact']}>
  <div class="site-frame footer-inner">
    <p>© {new Date().getFullYear()}{' '}{author.name}</p>
    <nav aria-label="页脚导航">
      {!compact && <>
        <a href={withBase(ROUTES.ARCHIVE)}>归档</a>
        <a href={withBase(ROUTES.ABOUT)}>关于</a>
        <a href={withBase(ROUTES.PRIVACY)}>隐私</a>
        <a href={'mailto:' + author.email}>联系</a>
      </>}
      <a href={withBase(ROUTES.RSS)}>RSS</a>
    </nav>
  </div>
</footer>

<style>
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
    color: var(--fx-faint);
    font-size: var(--type-meta);
  }
  p { margin: 0; }
  nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  a { display: inline-flex; align-items: center; min-height: 2rem; }
  a:hover { color: var(--fx-accent); }
  .site-footer--compact { border: 0; }
  .site-footer--compact .footer-inner { width: min(calc(100% - 3rem), 60rem); }
  @media (max-width: 720px) {
    .site-footer--compact .footer-inner { max-width: 27rem; }
  }
</style>
