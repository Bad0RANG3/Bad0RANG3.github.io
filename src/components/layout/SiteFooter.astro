---
import { siteConfig } from '../../config/site';
import { SOCIAL_ICONS } from '../../constants';

const { author, socials, navigation } = siteConfig;
const footerNav = navigation.map((item) => ({ href: item.href, text: item.label }));
---

<footer class="mt-auto bg-base-200 relative">
  <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-primary to-secondary"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-10">

    <!-- Upper section -->
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <!-- Left: Brand -->
      <div class="flex items-start gap-4 max-w-md">
        <figure class="shrink-0 w-14 h-14 sm:w-16 sm:h-16 rounded-2xl overflow-hidden ring-2 ring-base-content/10">
          <img src={author.avatar} alt={author.name} class="w-full h-full object-cover" width="64" height="64" loading="lazy" />
        </figure>
        <div>
          <a href="/" class="text-lg font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">{siteConfig.title}</a>
          <p class="mt-1.5 text-sm text-base-content/60 leading-relaxed">{siteConfig.description}</p>
        </div>
      </div>

      <!-- Right: Nav links -->
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label="页脚导航">
        {footerNav.map(item => (
          <a href={item.href} class="text-base-content/70 hover:text-primary transition-colors duration-200">{item.text}</a>
        ))}
      </nav>
    </div>

    <!-- Social icons row -->
    <div class="mt-6 flex flex-wrap items-center gap-3">
      {socials.map(s => {
        const iconSrc = SOCIAL_ICONS[s.name as keyof typeof SOCIAL_ICONS];
        return iconSrc ? (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name} title={s.name}
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-base-100 hover:bg-primary/15 transition-all duration-200 hover:scale-110">
            <img src={iconSrc} alt={s.name} class="h-4 w-4" loading="lazy" />
          </a>
        ) : (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-base-100 hover:bg-primary/15 text-xs text-base-content/50 transition-colors duration-200">
            {s.name[0]}
          </a>
        );
      })}
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 pt-5 border-t border-base-content/10 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between text-xs text-base-content/40">
      <span>&copy; {new Date().getFullYear()} {author.name}</span>
      <span>Built with Astro &middot; Deployed on GitHub Pages</span>
    </div>
  </div>
</footer>
