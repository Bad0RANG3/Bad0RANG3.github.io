---
import { siteConfig } from '../../config/site';
import Icon from '../icons/Icons.astro';

interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
const drawerId = 'mobile-drawer';
---

<dialog id={drawerId} class="modal mobile-nav-dialog" aria-label="移动端导航">
  <div class="flex h-dvh w-screen justify-start">
    <div class="drawer-panel flex h-dvh w-80 max-w-[86vw] flex-col border-r-2 border-base-content/10 bg-base-100 shadow-2xl sm:max-w-sm">
      <div class="flex items-center justify-between border-b-2 border-base-content/10 bg-gradient-to-r from-primary/15 via-secondary/30 to-accent/15 px-5 pb-5 pt-[max(1.25rem,env(safe-area-inset-top))]">
        <div>
          <p class="font-black tracking-tight">{siteConfig.title}</p>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-base-content/55">paper navigation</p>
        </div>
        <button type="button" class="btn btn-sm btn-ghost btn-circle" aria-label="关闭导航" data-close-drawer="true">
          <Icon name="close" class="h-5 w-5" />
        </button>
      </div>
      <div class="flex-1 space-y-6 overflow-y-auto px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-5">
        <nav class="flex flex-col gap-2" aria-label="主要导航">
          {siteConfig.navigation.map(item => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-3 rounded-2xl border-2 px-4 py-3 text-sm font-bold transition-all',
                  active
                    ? 'border-base-content bg-primary text-primary-content shadow-[4px_4px_0_0] shadow-base-content'
                    : 'border-base-content/10 bg-base-200/50 text-base-content/75 hover:border-primary/40 hover:bg-secondary/20',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                <Icon name="chevron-right" class="h-4 w-4" />
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>
      </div>
    </div>
    <button type="button" class="h-full flex-1 transition-colors duration-200" data-close-drawer="true" aria-label="点击关闭导航"><span class="sr-only">关闭导航</span></button>
  </div>
</dialog>

<style is:inline>
  @keyframes slideInDrawer {
    from { transform: translateX(-100%); }
    to   { transform: translateX(0); }
  }
  @keyframes slideOutDrawer {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
  }
  .drawer-panel { transform: translateX(-100%); }
  dialog[open] .drawer-panel { animation: slideInDrawer 0.3s ease forwards; }
  dialog .drawer-panel.animate-out { animation: slideOutDrawer 0.3s ease forwards; }
  .mobile-nav-dialog::backdrop { background: color-mix(in oklab, var(--color-ink) 42%, transparent); }
</style>

<script is:inline>
  (function(){
    const d=document.getElementById('mobile-drawer'),b=document.getElementById('mobile-menu-btn');
    if(!d||!b)return;
    b.addEventListener('click',function(){if(d instanceof HTMLDialogElement&&!d.open){d.showModal();b.setAttribute('aria-expanded','true')}});
    const p=d.querySelector('.drawer-panel');
    const close=function(){if(!(d instanceof HTMLDialogElement)||!d.open)return;if(!p){d.close();return}p.classList.add('animate-out');const h=function(){p.classList.remove('animate-out');p.removeEventListener('animationend',h);if(d instanceof HTMLDialogElement&&d.open)d.close()};p.addEventListener('animationend',h,{once:!0})};
    d.querySelectorAll('[data-close-drawer]').forEach(function(e){e.addEventListener('click',function(e){e.preventDefault();close()})});
    d.addEventListener('cancel',function(e){e.preventDefault();close()});d.addEventListener('close',function(){if(p)p.classList.remove('animate-out');b.setAttribute('aria-expanded','false')});
  })();
</script>
