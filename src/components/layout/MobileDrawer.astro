---
import { siteConfig } from '../../config/site';
import Icon from '../icons/Icon.astro';
import { isActivePath, withBase } from '../../lib/urls';

interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const isActive = (href: string) => isActivePath(currentPath, href);
const drawerId = 'mobile-drawer';
const navigationGroups = [
  { label: '主导航', items: siteConfig.navigation },
  { label: '更多入口', items: siteConfig.secondaryNavigation },
];
---

<dialog id={drawerId} class="modal mobile-nav-dialog" aria-label="站点导航与全部入口">
  <div class="flex h-dvh w-screen justify-start">
    <div class="drawer-panel flex h-dvh w-80 max-w-[86vw] flex-col border-r border-base-content/10 bg-base-100 shadow-2xl sm:max-w-sm">
      <div class="drawer-heading flex items-center justify-between border-b border-base-content/10 px-5 pb-5 pt-[max(1.25rem,env(safe-area-inset-top))]">
        <div>
          <p class="font-black tracking-tight">{siteConfig.title}</p>
          <p class="mt-1 text-xs font-bold uppercase tracking-[0.18em] text-base-content/45">导航与全部入口</p>
        </div>
        <button type="button" class="header-action" aria-label="关闭导航" data-close-drawer="true">
          <Icon name="close" class="h-5 w-5" />
        </button>
      </div>
      <div class="flex-1 space-y-7 overflow-y-auto px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-5">
        {navigationGroups.map((group) => (
          <div>
            <p class="drawer-label">{group.label}</p>
            <nav class="mt-3 flex flex-col gap-2" aria-label={group.label}>
              {group.items.map(item => {
                const active = isActive(item.href);
                return (
                  <a href={withBase(item.href)} class:list={['drawer-link', active && 'is-active']} aria-current={active ? 'page' : undefined}>
                    <Icon name="chevron-right" class="h-4 w-4" />
                    <span>{item.label}</span>
                  </a>
                );
              })}
            </nav>
          </div>
        ))}
        <div>
          <p class="drawer-label">账号与音乐</p>
          <div class="drawer-featured-links">
            <a href={siteConfig.github.profileUrl} target="_blank" rel="noreferrer" class="drawer-featured-link">
              <span class="drawer-featured-icon"><Icon name="github" class="h-4 w-4" /></span>
              <span><strong>GitHub</strong><small>@{siteConfig.github.username}</small></span>
              <Icon name="arrow-up-right" class="h-4 w-4" />
            </a>
            <a href={siteConfig.music.officialUrl} target="_blank" rel="noreferrer" class="drawer-featured-link">
              <span class="drawer-featured-icon"><Icon name="music" class="h-4 w-4" /></span>
              <span><strong>网易云音乐</strong><small>{siteConfig.music.title}</small></span>
              <Icon name="arrow-up-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
    <button type="button" class="h-full flex-1 transition-colors duration-200" data-close-drawer="true" aria-label="点击关闭导航"><span class="sr-only">关闭导航</span></button>
  </div>
</dialog>

<style is:inline>
  @keyframes slideInDrawer {
    from { transform: translateX(-100%); }
    to   { transform: translateX(0); }
  }
  @keyframes slideOutDrawer {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
  }
  .drawer-panel { transform: translateX(-100%); }
  dialog[open] .drawer-panel { animation: slideInDrawer 0.3s ease forwards; }
  dialog .drawer-panel.animate-out { animation: slideOutDrawer 0.3s ease forwards; }
  .mobile-nav-dialog::backdrop { background: color-mix(in oklab, var(--color-ink) 42%, transparent); }
</style>

<script is:inline data-astro-rerun>
  (function(){
    const d=document.getElementById('mobile-drawer'),triggers=[...document.querySelectorAll('[data-drawer-trigger]')];
    if(!d||!triggers.length)return;
    const setExpanded=function(value){triggers.forEach(function(trigger){trigger.setAttribute('aria-expanded',value?'true':'false')})};
    triggers.forEach(function(trigger){trigger.addEventListener('click',function(){if(d instanceof HTMLDialogElement&&!d.open){d.showModal();setExpanded(true)}})});
    const p=d.querySelector('.drawer-panel');
    const close=function(){if(!(d instanceof HTMLDialogElement)||!d.open)return;if(!p){d.close();return}p.classList.add('animate-out');const h=function(){p.classList.remove('animate-out');p.removeEventListener('animationend',h);if(d instanceof HTMLDialogElement&&d.open)d.close()};p.addEventListener('animationend',h,{once:!0})};
    d.querySelectorAll('[data-close-drawer]').forEach(function(e){e.addEventListener('click',function(e){e.preventDefault();close()})});
    d.addEventListener('cancel',function(e){e.preventDefault();close()});d.addEventListener('close',function(){if(p)p.classList.remove('animate-out');setExpanded(false)});
  })();
</script>
