---
import { siteConfig } from '../../config/site';
import { ROUTES } from '../../config/routes';
import MobileDrawer from './MobileDrawer.astro';
import Icon from '../icons/Icon.astro';
import RailIcon from '../icons/RailIcon.astro';
import { isActivePath, withBase } from '../../lib/urls';

interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const isActive = (href: string) => isActivePath(currentPath, href);
const islandHrefs = [ROUTES.HOME, ROUTES.POSTS, ROUTES.PROJECTS, ROUTES.TOOLS, ROUTES.ABOUT];
const islandNavigation = islandHrefs
  .map((href) => siteConfig.navigation.find((item) => item.href === href))
  .filter((item): item is (typeof siteConfig.navigation)[number] => Boolean(item));
const player = siteConfig.music;
const navigationIconByHref = {
  [ROUTES.HOME]: 'home',
  [ROUTES.POSTS]: 'posts',
  [ROUTES.PROJECTS]: 'projects',
  [ROUTES.TOOLS]: 'tools',
  [ROUTES.ABOUT]: 'about',
} as const;
const playerCover = withBase(player.cover);
const playerAudio = withBase(player.audio);
const playerLyrics = withBase(player.lyrics);
---

<header class="site-header">
  <a href="#main-content" class="skip-link">跳到内容</a>

  <div class="dynamic-island music-island" id="site-island" data-open="false" data-volume-open="false" data-cue-active="false" data-player-state="idle" data-api-base={player.apiBase} data-audio-src={playerAudio} data-lyrics-src={playerLyrics} data-song-id={String(player.id)} data-song-duration={String(player.durationSeconds)} data-song-title={player.title} transition:persist="site-music-player">
    <button
      class="island-summary"
      id="site-island-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-island-panel"
      aria-label={`展开 ${player.title} 的播放器`}
    >
      <img class="island-mini-art" src={playerCover} alt="" width="32" height="32" loading="eager" />
      <span class="island-summary-copy">
        <span class="island-track-title">{player.title}</span>
        <span class="island-track-artist">{player.artist}</span>
      </span>
      <span class="island-mini-wave" data-audio-visualizer="compact" aria-hidden="true">
        {Array.from({ length: 6 }).map((_, index) => <i style={`--visualizer-index:${index}`} />)}
      </span>
    </button>

    <div class="island-section-cue" id="island-section-cue" aria-hidden="true">
      <span class="island-cue-pulse"></span>
      <span class="island-cue-copy">
        <small>SECTION</small>
        <strong id="island-section-label">首页概览</strong>
      </span>
    </div>

    <div class="island-panel island-player-panel" id="site-island-panel">
      <div class="island-player-heading">
        <img class="island-player-art" src={playerCover} alt={`${player.album} 封面`} width="96" height="96" loading="eager" />
        <div class="island-player-copy">
          <p class="island-player-lyric" id="island-player-lyric">前奏里，故事正准备开始。</p>
          <span>{player.artist}/{player.title}</span>
          <span class="island-player-status" id="island-player-status" role="status" aria-live="polite"></span>
        </div>
        <span class="island-expanded-wave" data-audio-visualizer="expanded" aria-hidden="true">
          {Array.from({ length: 6 }).map((_, index) => <i style={`--visualizer-index:${index}`} />)}
        </span>
      </div>
      <div class="island-player-timeline">
        <input id="island-player-scrubber" type="range" min="0" max={player.durationSeconds} value="0" step="0.1" disabled aria-label="播放进度" />
        <div><span id="island-player-elapsed">0:00</span><span id="island-player-duration">−{player.durationLabel}</span></div>
      </div>
      <div class="island-player-actions">
        <a class="island-player-favorite" href={player.officialUrl} target="_blank" rel="noreferrer" aria-label="在网易云音乐中打开这首歌" title="在网易云音乐中打开">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.8 2.75 5.57 6.15.9-4.45 4.34 1.05 6.13L12 16.84l-5.5 2.9 1.05-6.13L3.1 9.27l6.15-.9L12 2.8Z" /></svg>
        </a>
        <button class="island-player-skip island-player-skip--previous" id="island-player-restart" type="button" aria-label="从头播放">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6v12l8-6-8-6Zm9.5 0v12l8-6-8-6Z" /></svg>
        </button>
        <button class="island-player-toggle" id="island-player-toggle" type="button" aria-label={`播放 ${player.title}`}>
          <svg class="player-icon player-icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
          <svg class="player-icon player-icon--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h6v18H4zm10 0h6v18h-6z" /></svg>
        </button>
        <button class="island-player-skip island-player-skip--next" id="island-player-forward" type="button" aria-label="快进 10 秒">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6v12l8-6-8-6Zm9.5 0v12l8-6-8-6Z" /></svg>
        </button>
        <div class="island-volume-control" id="island-volume-control">
          <button class="island-volume-button" id="island-volume-button" type="button" aria-label="调整音量" aria-controls="island-volume-menu" aria-expanded="false">
            <svg class="volume-icon volume-icon--on island-output-icon" viewBox="0 0 32 32" aria-hidden="true"><path d="m16 20-6.5 9h13L16 20Z"/><path d="M11.6 19.2a6 6 0 1 1 8.8 0M8.5 22.2a10 10 0 1 1 15 0M5.5 25.2a14 14 0 1 1 21 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg class="volume-icon volume-icon--muted island-output-icon" viewBox="0 0 32 32" aria-hidden="true"><path d="m16 20-6.5 9h13L16 20Z"/><path d="M11.6 19.2a6 6 0 1 1 8.8 0M8.5 22.2a10 10 0 1 1 15 0M5.5 25.2a14 14 0 1 1 21 0M6 6l20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <div class="island-volume-menu" id="island-volume-menu" role="group" aria-label="音量控制">
            <button class="island-volume-mute" id="island-volume-mute" type="button" aria-label="静音">
              <svg class="volume-icon volume-icon--on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8.5a5 5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <svg class="volume-icon volume-icon--muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="m17 9 4 4m0-4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <input id="island-volume-slider" type="range" min="0" max="1" value="0.72" step="0.01" aria-label="播放器音量" />
            <output id="island-volume-value" for="island-volume-slider">72%</output>
          </div>
        </div>
      </div>
    </div>
    <audio id="site-island-audio" src={playerAudio} preload="metadata" data-source-ready="true"></audio>
  </div>

  <div class="header-actions">
    <button id="theme-toggle" type="button" class="header-action" aria-label="切换深色模式" title="切换亮色 / 深色">
      <span class="theme-icon-sun" aria-hidden="true"><Icon name="sun" class="h-4 w-4" /></span>
      <span class="theme-icon-moon" aria-hidden="true"><Icon name="moon" class="h-4 w-4" /></span>
    </button>
    <button id="search-btn" type="button" class="header-action" aria-label="搜索" title="搜索"><Icon name="search" class="h-4 w-4" /></button>
    <button id="mobile-menu-btn" type="button" class="header-action mobile-menu-action" aria-label="打开全部入口" aria-controls="mobile-drawer" aria-expanded="false" data-drawer-trigger><Icon name="menu" class="h-4 w-4" /></button>
  </div>
</header>

<aside class="site-nav-rail" aria-label="站点导航">
  <nav>
    {islandNavigation.map((item) => {
      const active = isActive(item.href);
      return (
        <a href={withBase(item.href)} class:list={['rail-link', active && 'is-active']} aria-current={active ? 'page' : undefined}>
          <span class="rail-icon"><RailIcon name={navigationIconByHref[item.href as keyof typeof navigationIconByHref]} /></span>
          <span class="rail-label">{item.label}</span>
        </a>
      );
    })}
    <span class="rail-divider" aria-hidden="true"></span>
    <button class="rail-link rail-menu-button" id="rail-menu-btn" type="button" aria-label="打开全部入口" aria-controls="mobile-drawer" aria-expanded="false" data-drawer-trigger>
      <span class="rail-icon"><RailIcon name="more" /></span>
      <span class="rail-label">全部入口</span>
    </button>
  </nav>
</aside>

<MobileDrawer currentPath={currentPath} />

<script>
  // The music island persists across ClientRouter navigations, so this module
  // initialises it once and reacts to astro:page-load for per-page work.
  import '../../scripts/player';
</script>
