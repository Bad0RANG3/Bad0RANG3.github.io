---
import { siteConfig } from '../config/site';
const { repo, repoId, categoryId, category } = siteConfig.giscus;
---

<section class="mx-auto mt-12 border-t border-base-content/10 pt-8 sm:mt-16 sm:pt-10" data-comments>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div><p class="eyebrow">Community notes</p><h2 class="mt-2 text-lg font-bold sm:text-xl">评论</h2></div>
    <button type="button" class="btn-brutal-outline text-sm" data-load-comments>加载评论</button>
  </div>
  <p class="mt-3 max-w-xl text-sm leading-6 text-base-content/55" data-comments-hint>评论由 Giscus 提供。只有点击加载后，页面才会连接 GitHub。</p>
  <div class="giscus mt-6" data-giscus-container></div>
</section>

<script is:inline define:vars={{ repo, repoId, category, categoryId }}>
  (() => {
    const root = document.querySelector('[data-comments]');
    if (!(root instanceof HTMLElement) || root.dataset.bound === '1') return;
    root.dataset.bound = '1';
    const button = root.querySelector('[data-load-comments]');
    const hint = root.querySelector('[data-comments-hint]');
    const container = root.querySelector('[data-giscus-container]');
    button?.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement) || !(container instanceof HTMLElement)) return;
      button.disabled = true;
      button.textContent = '正在加载…';
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      [['data-repo', repo], ['data-repo-id', repoId], ['data-category', category], ['data-category-id', categoryId], ['data-mapping', 'pathname'], ['data-strict', '0'], ['data-reactions-enabled', '1'], ['data-emit-metadata', '0'], ['data-input-position', 'bottom'], ['data-theme', document.documentElement.getAttribute('data-theme') === 'paper-dark' ? 'dark' : 'light'], ['data-lang', 'zh-CN']].forEach(([key, value]) => script.setAttribute(key, value));
      script.addEventListener('load', () => { button.remove(); if (hint) hint.textContent = '评论加载自 GitHub Discussions。'; });
      script.addEventListener('error', () => { button.disabled = false; button.textContent = '重新加载评论'; if (hint) hint.textContent = '评论服务暂时不可用，正文不受影响。'; });
      container.append(script);
    });
    window.addEventListener('b0-theme-change', (event) => {
      const theme = event.detail?.theme === 'paper-dark' ? 'dark' : 'light';
      const iframe = document.querySelector('iframe.giscus-frame');
      iframe?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
    });
  })();
</script>
