---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { projects } from '../config/projects';
import { ROUTES, postPath } from '../config/routes';
import { siteConfig } from '../config/site';
import { getPublishedPosts, getPostReadingMinutes } from '../lib/content';
import { getTagGroups } from '../lib/taxonomy';
import { formatDate } from '../lib/date';
import { withBase } from '../lib/urls';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 4);
const tagGroups = await getTagGroups();
const { author, hero, music, netease, github, about } = siteConfig;

const nameChars = [...author.name];
const roles = ['拆解软件', '写点代码', '折腾配置'];
const featuredProjects = projects.slice(0, 3);
const keywords = tagGroups.slice(0, 10).map((group) => group.name);
/* The ribbon loops by translating -50%, so one copy has to stay wider than the
   widest viewport; four passes cover screens up to ~4300px without a gap. */
const marqueeLoop = [...keywords, ...keywords, ...keywords, ...keywords];
const toolCount = about.techStack.length + about.devTools.length;
const indexItems = [
  { value: posts.length, label: '篇文章' },
  { value: projects.length, label: '个项目' },
  { value: toolCount, label: '件常用工具' },
  { value: tagGroups.length, label: '个标签' },
];
const waveHeights = [42, 68, 34, 84, 52, 74, 38];
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="home-stage">
    <section class="stage-hero site-frame" aria-labelledby="home-title" data-island-cue="首页概览">
      <div class="stage-copy">
        <p class="stage-kicker"><span class="stage-dot" aria-hidden="true"></span>你好，我是</p>

        <h1 id="home-title" class="stage-name" aria-label={author.name}>
          {nameChars.map((char, index) => (
            <span class="stage-name__char" style={`--i:${index}`} aria-hidden="true">{char}</span>
          ))}
          <span class="stage-name__dot" aria-hidden="true">.</span>
        </h1>

        <p class="stage-role">
          <span>正在</span>
          <span class="stage-role__window">
            <span class="stage-role__list" aria-hidden="true">
              {roles.map((role) => <span>{role}</span>)}
              <span>{roles[0]}</span>
            </span>
          </span>
          <span class="sr-only">拆解软件、写点代码、折腾配置</span>
        </p>

        <p class="stage-intro">
          {author.intro} 这里记录软件折腾、开发实验、游戏，以及那些值得留下来的小发现。
        </p>

        <div class="stage-actions">
          <a href={withBase(ROUTES.POSTS)} class="stage-btn stage-btn--primary">
            阅读文章 <Icon name="arrow-up-right" class="h-4 w-4" />
          </a>
          <a href={withBase(ROUTES.PROJECTS)} class="stage-btn">看看项目</a>
          <a href={`mailto:${author.email}`} class="stage-link">直接找我</a>
        </div>
      </div>

      <aside class="stage-now" data-now-card data-playing="false" aria-label="当前曲目与播放状态">
        <div class="stage-now__head">
          <span class="stage-now__label">NOW PLAYING</span>
          <span class="stage-now__state"><i aria-hidden="true"></i><span data-now-state>准备播放</span></span>
        </div>

        <p class="stage-now__title">{music.title}</p>
        <p class="stage-now__meta">{music.artist} · {music.album}</p>

        <div class="stage-now__wave" aria-hidden="true">
          {waveHeights.map((height, index) => (
            <i style={`--i:${index};--h:${height}%`}></i>
          ))}
        </div>

        <div class="stage-now__foot">
          <span data-live-elapsed>0:00</span>
          <span class="stage-now__bar" data-live-progress><i></i></span>
          <span data-live-duration>{music.durationLabel}</span>
        </div>

        <button class="stage-now__toggle" type="button" data-now-toggle aria-label="播放音乐">
          <span class="stage-now__glyph" aria-hidden="true"></span>
          <span data-now-toggle-copy>听一下</span>
        </button>
      </aside>

      <ul class="stage-index" aria-label="站点概览">
        {indexItems.map((item) => (
          <li>
            <strong data-count={item.value}>{item.value}</strong>
            <span>{item.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <div class="stage-marquee" role="presentation">
      <p class="sr-only">关键词：{keywords.join('、')}</p>
      <div class="stage-marquee__track" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="stage-marquee__group">
            {marqueeLoop.map((word) => <span class="stage-marquee__item">{word}</span>)}
          </div>
        ))}
      </div>
    </div>

    <section id="home-projects" class="stage-section site-frame" aria-labelledby="projects-title" data-island-cue="项目与实验" data-motion>
      <div class="section-heading-row">
        <SectionHeader label="Selected" title="项目与实验" titleId="projects-title" />
        <a href={withBase(ROUTES.PROJECTS)} class="stage-link">全部项目 <Icon name="arrow-up-right" class="h-3.5 w-3.5" /></a>
      </div>

      <ul class="stage-list">
        {featuredProjects.map((project, index) => (
          <li data-motion style={`--d:${index * 70}ms`}>
            <a href={withBase(project.href)} class="stage-row">
              <span class="stage-row__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="stage-row__body">
                <strong class="stage-row__title">{project.name}</strong>
                <span class="stage-row__desc">{project.summary}</span>
              </span>
              <Icon name="arrow-up-right" class="stage-row__arrow h-4 w-4" />
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="home-journal" class="stage-section site-frame" aria-labelledby="recent-posts-title" data-island-cue="最近更新" data-motion>
      <div class="section-heading-row">
        <SectionHeader label="Journal" title="最近更新" titleId="recent-posts-title" />
        <a href={withBase(ROUTES.POSTS)} class="stage-link">全部文章 <Icon name="arrow-up-right" class="h-3.5 w-3.5" /></a>
      </div>

      <ul class="stage-list">
        {recentPosts.map((post, index) => (
          <li data-motion style={`--d:${index * 60}ms`}>
            <a href={withBase(postPath(post.slug))} class="stage-row stage-row--post">
              <span class="stage-row__index">{formatDate(post.data.date)}</span>
              <span class="stage-row__body">
                <strong class="stage-row__title">{post.data.title}</strong>
                <span class="stage-row__meta">{post.data.category} · {getPostReadingMinutes(post)} 分钟</span>
              </span>
              <Icon name="arrow-up-right" class="stage-row__arrow h-4 w-4" />
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="home-presence" class="stage-section site-frame" aria-labelledby="presence-title" data-island-cue="音乐与开发" data-motion>
      <div class="section-heading-row">
        <SectionHeader label="Presence" title="音乐与开发" titleId="presence-title" />
      </div>

      <div class="presence-grid">
        <article
          class="profile-card presence-card ncm-profile-card"
          data-ncm-profile
          data-api-base={netease.apiBase}
          data-user-id={netease.userId}
        >
          <header class="presence-card-header">
            <span class="presence-provider"><Icon name="music" class="h-4 w-4" /> 网易云音乐</span>
            <a href={netease.profileUrl} target="_blank" rel="noreferrer" aria-label={`前往 ${netease.fallback.nickname} 的网易云主页`}><Icon name="arrow-up-right" class="h-4 w-4" /></a>
          </header>

          <div class="ncm-profile-layout">
            <div class="ncm-avatar-shell">
              <img src={netease.fallback.avatarUrl} alt={`${netease.fallback.nickname} 的网易云头像`} width="116" height="116" loading="lazy" data-ncm-avatar />
            </div>

            <div class="ncm-profile-copy">
              <div class="presence-name-line ncm-name-line">
                <h3 data-ncm-name>{netease.fallback.nickname}</h3>
                <span class="ncm-vip-badge" data-ncm-vip>{netease.fallback.vipLabel}</span>
              </div>
              <p class="ncm-profile-signature" data-ncm-signature>{netease.fallback.signature}</p>
              <div class="ncm-profile-meta" aria-label="网易云身份信息">
                <span><Icon name="star" class="h-3.5 w-3.5" /><b data-ncm-medals>{netease.fallback.medalNum}</b> 枚徽章</span>
                <span><Icon name="music" class="h-3.5 w-3.5" /><b data-ncm-fan>{netease.fallback.fanLabel}</b></span>
              </div>
            </div>
          </div>

          <dl class="ncm-profile-metrics">
            <div><dt>关注</dt><dd data-ncm-follows>{netease.fallback.follows}</dd></div>
            <div><dt>粉丝</dt><dd data-ncm-followeds>{netease.fallback.followeds}</dd></div>
            <div><dt>等级</dt><dd>Lv.<span data-ncm-level>{netease.fallback.level}</span></dd></div>
            <div><dt>播放</dt><dd data-ncm-listens>{netease.fallback.listenSongs.toLocaleString('zh-CN')}</dd></div>
          </dl>
        </article>

        <article class="profile-card presence-card presence-github-card" data-github-profile data-api-url={github.apiUrl}>
          <header class="presence-card-header">
            <span class="presence-provider"><Icon name="github" class="h-4 w-4" /> GitHub</span>
            <a href={github.profileUrl} target="_blank" rel="noreferrer" aria-label={`前往 ${github.username} 的 GitHub`}><Icon name="arrow-up-right" class="h-4 w-4" /></a>
          </header>

          <div class="github-profile-row">
            <div class="github-avatar-shell">
              <img src={withBase(author.avatar)} alt={`${github.username} 的头像`} width="116" height="116" loading="lazy" />
            </div>
            <div class="github-profile-copy">
              <div class="presence-name-line github-name-line">
                <h3>{author.name}</h3>
                <span class="github-profile-badge">PUBLIC</span>
              </div>
              <a href={github.profileUrl} target="_blank" rel="noreferrer">@{github.username}</a>
              <p class="github-profile-bio" data-github-bio>代码、博客与持续进行中的小实验。</p>
            </div>
          </div>

          <dl class="github-metrics">
            <div><dt>仓库</dt><dd data-github-repos>—</dd></div>
            <div><dt>关注者</dt><dd data-github-followers>—</dd></div>
            <div><dt>正在关注</dt><dd data-github-following>—</dd></div>
          </dl>
        </article>
      </div>
    </section>

    <section class="stage-quote site-frame" aria-label="此刻循环的歌词" data-motion>
      <p class="stage-quote__label">此刻循环 · {music.title}</p>
      <blockquote>{hero.lyric}</blockquote>
    </section>

    <section id="home-contact" class="site-frame stage-contact" aria-labelledby="contact-title" data-island-cue="保持联系" data-motion>
      <div class="stage-contact__inner">
        <div>
          <p class="stage-kicker">保持联系</p>
          <h2 id="contact-title">想聊点什么？</h2>
          <p class="stage-contact__copy">工具、配置、特效实验都欢迎交流，也可以从页脚的社交链接找到我。</p>
        </div>
        <div class="stage-actions">
          <a href={`mailto:${author.email}`} class="stage-btn stage-btn--primary">发送邮件 <Icon name="arrow-up-right" class="h-4 w-4" /></a>
          <a href={withBase(ROUTES.ABOUT)} class="stage-btn">关于我</a>
        </div>
      </div>
    </section>
  </div>

  <script>
    import '../scripts/home';
    import '../scripts/home-motion';
  </script>
</BaseLayout>

<style>
  .home-stage {
    --ink: var(--fx-text);
    --muted: var(--fx-muted);
    --soft: var(--text-faint);
    --line: var(--fx-line);
    --accent: var(--fx-pink);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  /* ------------------------------------------------------------------
     Opening: oversized name, a cycling role, and the live player card.
     ------------------------------------------------------------------ */
  .stage-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(17rem, 0.88fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
    overflow: clip;
    /* The player card keeps the site's 7px offset shadow; this padding keeps
       that shadow inside the clip box instead of slicing its right edge. */
    padding-right: 0.6rem;
    padding-block: clamp(2.2rem, 6vw, 4.5rem) clamp(1rem, 3vw, 1.75rem);
  }

  /* One slow glow behind the copy. It drifts on transform only, so it never
     triggers layout, and it is clipped by the section. */
  .stage-hero::before {
    position: absolute;
    z-index: 0;
    top: -8rem;
    right: -6rem;
    width: min(34rem, 74vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 20%, transparent), transparent 64%);
    filter: blur(26px);
    content: '';
    opacity: 0.6;
    pointer-events: none;
    animation: stage-drift 19s ease-in-out infinite alternate;
  }

  .stage-copy,
  .stage-now,
  .stage-index { position: relative; z-index: 1; }

  .stage-copy { min-width: 0; }

  .stage-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .stage-dot {
    position: relative;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .stage-dot::after {
    position: absolute;
    inset: -0.28rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 50%;
    content: '';
    animation: stage-ping 2.8s ease-out infinite;
  }

  .stage-name {
    display: flex;
    flex-wrap: wrap;
    margin: 0.85rem 0 0;
    color: var(--ink);
    font-size: clamp(3.1rem, 8.6vw, 6.1rem);
    font-weight: 820;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .stage-name__char,
  .stage-name__dot {
    display: inline-block;
    animation: stage-rise 0.85s var(--ease) both;
    animation-delay: calc(90ms + var(--i, 9) * 42ms);
  }

  .stage-name__dot { color: var(--accent); }

  .stage-role {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 1.35rem 0 0;
    color: var(--soft);
    font-size: clamp(0.9rem, 1.3vw, 1rem);
  }

  .stage-role__window {
    display: inline-flex;
    height: 1.55em;
    overflow: hidden;
  }

  .stage-role__list {
    display: flex;
    flex-direction: column;
    animation: stage-role 12s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .stage-role__list > span {
    height: 1.55em;
    color: var(--ink);
    font-weight: 700;
    line-height: 1.55em;
    white-space: nowrap;
  }

  .stage-intro {
    max-width: 33rem;
    margin: 1.4rem 0 0;
    color: var(--muted);
    font-size: clamp(0.95rem, 1.25vw, 1.02rem);
    line-height: 1.95;
  }

  .stage-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.8rem;
  }

  .stage-btn {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.7rem 1.15rem;
    background: color-mix(in srgb, var(--fx-surface-strong) 72%, transparent);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    transition: transform 0.25s var(--ease), border-color 0.25s ease, background 0.25s ease;
  }

  .stage-btn:hover,
  .stage-btn:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    transform: translateY(-2px);
  }

  .stage-btn:focus-visible,
  .stage-link:focus-visible,
  .stage-row:focus-visible,
  .stage-now__toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .stage-btn--primary {
    border-color: transparent;
    background: var(--accent);
    color: #2a1220;
  }

  .stage-btn--primary:hover,
  .stage-btn--primary:focus-visible {
    background: color-mix(in srgb, var(--accent) 88%, black);
    color: #2a1220;
  }

  .stage-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--soft);
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .stage-link:hover,
  .stage-link:focus-visible { color: var(--ink); gap: 0.45rem; }

  /* The player card reports the island's real state; see home-motion.ts. */
  .stage-now {
    align-self: start;
    border: 1px solid var(--line);
    border-radius: 1.35rem;
    padding: 1.3rem 1.35rem 1.2rem;
    background: color-mix(in srgb, var(--fx-surface-strong) 84%, transparent);
    box-shadow: 7px 7px 0 color-mix(in srgb, var(--accent) 14%, transparent), 0 28px 60px -45px var(--fx-shadow);
    backdrop-filter: blur(14px);
  }

  .stage-now__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
  }

  .stage-now__label { font-weight: 700; }

  .stage-now__state {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    letter-spacing: 0.06em;
  }

  .stage-now__state i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--soft) 70%, transparent);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .stage-now[data-playing="true"] .stage-now__state i {
    background: var(--accent);
    box-shadow: 0 0 0 0.22rem color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .stage-now__title {
    margin: 1.15rem 0 0;
    color: var(--ink);
    font-size: clamp(1.3rem, 2.4vw, 1.55rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .stage-now__meta {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .stage-now__wave {
    display: flex;
    height: 2rem;
    align-items: flex-end;
    gap: 3px;
    margin: 1.15rem 0 0.9rem;
  }

  .stage-now__wave i {
    flex: 1;
    height: var(--h, 40%);
    border-radius: 2px;
    background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 42%, transparent));
    transform-origin: bottom;
  }

  /* Bars only move while audio is actually playing. */
  .stage-now[data-playing="true"] .stage-now__wave i {
    animation: stage-eq 1.05s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.13s);
  }

  .stage-now__foot {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }

  .stage-now__bar {
    flex: 1;
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .stage-now__bar i {
    display: block;
    width: var(--live-progress, 0%);
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transition: width 0.2s linear;
  }

  .stage-now__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.5rem;
    margin-top: 1.15rem;
    border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 700;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .stage-now__toggle:hover,
  .stage-now__toggle:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .stage-now__glyph {
    width: 0;
    height: 0;
    margin-left: 0.12rem;
    border-top: 0.34rem solid transparent;
    border-bottom: 0.34rem solid transparent;
    border-left: 0.52rem solid currentColor;
  }

  .stage-now__toggle[data-playing="true"] .stage-now__glyph {
    width: 0.16rem;
    height: 0.7rem;
    margin-left: 0;
    border: 0;
    background: currentColor;
    box-shadow: 0.3rem 0 0 currentColor;
  }

  /* ------------------------------------------------------------------
     Numbers
     ------------------------------------------------------------------ */
  .stage-index {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0.75rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .stage-index li {
    display: grid;
    gap: 0.35rem;
    border-left: 1px solid var(--line);
    padding: 1.1rem 1rem 0;
  }

  .stage-index li:first-child { border-left: 0; padding-left: 0; }

  .stage-index strong {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: clamp(1.45rem, 3vw, 1.95rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stage-index span { color: var(--soft); font-size: 0.74rem; }

  /* ------------------------------------------------------------------
     Keyword ribbon
     ------------------------------------------------------------------ */
  .stage-marquee {
    overflow: hidden;
