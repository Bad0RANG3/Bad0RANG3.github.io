---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL_ICONS, siteConfig } from '../config/site';
import { withBase } from '../lib/urls';

const { author, socials } = siteConfig;
const displaySocials = socials.filter((social) => ['GitHub', 'X', 'Telegram', 'BiliBili'].includes(social.name));
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="home-hero site-frame" aria-labelledby="home-title">
    <figure class="hero-portrait" data-hero-portrait>
      <div class="hero-portrait__float">
      <img src={withBase('/HP.webp')} alt={author.name + ' portrait illustration'} width="1200" height="1200" fetchpriority="high" decoding="async" />
      </div>
    </figure>
    <div class="hero-identity">
      <h1 id="home-title">{author.name}</h1>
      <p class="hero-description">Computer enthusiast and software tinkerer.<br />Notes on code, games, and everyday discoveries.</p>
      <a class="hero-email" href={'mailto:' + author.email}>{author.email}</a>
      <ul class="hero-socials" aria-label="Social links">
        {displaySocials.map((social, index) => (
          <li style={`--social-index: ${index}`}>
            <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} title={social.name}>
              <img src={withBase(SOCIAL_ICONS[social.name as keyof typeof SOCIAL_ICONS])} alt="" width="18" height="18" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/home-hero-motion';
</script>

<style>
  .home-hero {
    display: grid;
    width: min(calc(100% - 3rem), 60rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-block: clamp(2rem, 6svh, 5rem);
  }

  .hero-portrait { width: 100%; margin: 0; }
  .hero-portrait__float { overflow: hidden; border-radius: 50%; aspect-ratio: 1; }
  .hero-portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero-identity { min-width: 0; }
  h1 {
    margin: 0;
    color: var(--fx-text);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.2vw, 4.5rem);
    font-weight: var(--weight-serif);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  .hero-description {
    margin: 1.5rem 0 1.25rem;
    color: var(--fx-muted);
    font-size: var(--type-small);
    line-height: 1.9;
  }
  .hero-email {
    color: var(--fx-muted);
    font-size: var(--type-small);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--fx-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: color 0.2s var(--ease), text-decoration-color 0.2s var(--ease);
  }
  .hero-email:hover { color: var(--fx-accent); text-decoration-color: currentColor; }
  .hero-socials {
    display: flex;
    gap: 0.5rem;
    margin: 1.75rem 0 0 -0.5rem;
    padding: 0;
    list-style: none;
  }
  .hero-socials a {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    opacity: 0.55;
    border-radius: 50%;
    transition: opacity 0.2s var(--ease), transform 0.3s var(--spring), background-color 0.2s var(--ease);
  }
  .hero-socials a:hover,
  .hero-socials a:focus-visible {
    opacity: 1;
    background-color: color-mix(in srgb, var(--fx-accent) 9%, transparent);
    transform: translateY(-4px);
  }
  .hero-socials a:active { transform: translateY(-1px) scale(0.94); }
  .hero-socials img { display: block; filter: grayscale(1); }
  :global(html[data-theme="paper-dark"]) .hero-socials img { filter: grayscale(1) invert(1); }

  /* Content is visible by default; CSS alone supplies the entrance, including
     visits through ClientRouter. Each transform has its own wrapper so entry,
     floating and pointer motion never overwrite one another. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-portrait {
      transform: perspective(900px) translate3d(var(--hero-x, 0px), var(--hero-y, 0px), 0)
        rotateX(var(--hero-rx, 0deg)) rotateY(var(--hero-ry, 0deg));
      transition: transform 0.65s var(--ease);
    }
    .hero-portrait__float { animation: hero-float 7s ease-in-out 1.1s infinite; }
    .hero-portrait img { animation: hero-portrait-enter 1s var(--ease) both; }
    .hero-identity > h1,
    .hero-description,
    .hero-email,
    .hero-socials li { animation: hero-copy-enter 0.8s var(--ease) both; }
    .hero-identity > h1 { animation-delay: 0.12s; }
    .hero-description { animation-delay: 0.23s; }
    .hero-email { display: inline-block; animation-delay: 0.34s; }
    .hero-socials li { animation-delay: calc(0.4s + var(--social-index) * 0.07s); }
    .home-hero[data-motion-paused] .hero-portrait__float { animation-play-state: paused; }
    /* Keyboard focus must never wait for a delayed entrance to become visible. */
    .hero-identity:focus-within > *,
    .hero-socials:focus-within li { animation: none; }
  }

  @keyframes hero-portrait-enter {
    from { opacity: 0; transform: translateY(18px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes hero-copy-enter {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (max-width: 720px) {
    .home-hero {
      width: min(calc(100% - 3rem), 27rem);
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 2.5rem 4rem;
    }
    .hero-portrait { width: min(100%, 19rem); }
    h1 { font-size: clamp(2.5rem, 10vw, 3.5rem); }
    .hero-description { margin-top: 1.1rem; }
    .hero-socials { margin-top: 1.25rem; }
  }
</style>
