---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/blog/PostCard.astro';
import ProjectCard from '../components/profile/ProjectCard.astro';
import ProfileOverviewCard from '../components/profile/ProfileOverviewCard.astro';
import Icon from '../components/icons/Icons.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { projects } from '../config/projects';
import { siteConfig } from '../config/site';
import { getPublishedPosts } from '../lib/content';
import { LAYOUT, ROUTES, STAGGER } from '../constants';
import { withBase } from '../lib/urls';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, LAYOUT.RECENT_POSTS_COUNT);
const { author, hero } = siteConfig;

const profileMetrics = [
  { label: '文章', value: String(posts.length).padStart(2, '0') },
  { label: '项目', value: String(projects.length).padStart(2, '0') },
  { label: '状态', value: '在线' },
];
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="site-frame py-5 sm:py-8">
    <div class="hero-grid">
      <ProfileOverviewCard
        layout="stack"
        eyebrow="个人档案"
        heading={author.name}
        headingTag="h2"
        subtitle=""
        metrics={profileMetrics}
      />

      <section class="reveal relative overflow-hidden rounded-[2rem] border-2 dark-soft-border-strong bg-base-100/80 p-6 shadow-hard sm:p-8 lg:p-9" aria-labelledby="home-title">
        <div class="flex h-full flex-col">
          <div class="flex flex-1 flex-col justify-center py-4 sm:py-6">
            <p class="eyebrow">欢迎</p>
            <h1 id="home-title" class="display-title mt-3 max-w-3xl text-4xl leading-[1.14] sm:text-5xl lg:text-6xl">
              {hero.lyric}
            </h1>
            <p class="mt-5 text-xs font-bold text-base-content/60">{hero.lyricSource}</p>
          </div>

          <div class="grid gap-3 border-t-2 border-dashed border-base-content/10 pt-5 sm:grid-cols-[1.1fr_0.9fr]">
            <a href={withBase(ROUTES.POSTS)} class="btn-brutal w-full">
              <Icon name="book" class="h-4 w-4" />
              我的博文
            </a>
            <div class="grid grid-cols-2 gap-3">
              <a href={withBase(ROUTES.TOOLS)} class="btn-brutal-outline w-full px-3 text-sm">工具页</a>
              <a href={withBase(ROUTES.ABOUT)} class="btn-brutal-outline w-full px-3 text-sm">关于我</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>

  <section class="site-frame pb-12 sm:pb-16" aria-labelledby="projects-title">
    <SectionHeader label="Projects" title="项目" titleId="projects-title" />
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((project, index) => (
        <div class="min-w-0" style={`--reveal-delay:${STAGGER.CARD_START + index * STAGGER.CARD_STEP}ms`}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </section>

  <section class="site-frame pb-12 sm:pb-16" aria-labelledby="recent-posts-title">
    <SectionHeader label="Latest" title="最近更新" titleId="recent-posts-title" />
    <div class="grid gap-6 md:grid-cols-2">
      {recentPosts.map((post, index) => (
        <div class="min-w-0" style={`--reveal-delay:${STAGGER.LIST_START + index * STAGGER.LIST_STEP}ms`}>
          <PostCard post={post} />
        </div>
      ))}
    </div>

    {posts.length > LAYOUT.RECENT_POSTS_COUNT && (
      <div class="mt-10 text-center reveal" style="--reveal-delay:500ms">
        <a href={withBase(ROUTES.POSTS)} class="btn-brutal-outline">
          查看全部文章
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>
      </div>
    )}
  </section>

  <section class="site-frame pb-12 sm:pb-16" aria-labelledby="contact-title">
    <div class="reveal rounded-[2rem] border-2 dark-soft-border-strong bg-base-100/80 p-6 shadow-hard sm:p-8 lg:p-10">
      <div class="grid gap-8 lg:grid-cols-[1.4fr_0.8fr] lg:items-end">
        <div>
          <SectionHeader label="Contact" title="想聊点什么？" titleId="contact-title" />
          <p class="max-w-xl text-sm leading-7 text-base-content/65 sm:text-base">
            工具、配置、特效实验都欢迎交流。
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a href={withBase(ROUTES.ABOUT)} class="btn-brutal-outline w-full">关于我</a>
          <a href={`mailto:${author.email}`} class="btn-brutal w-full">发送邮件</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
