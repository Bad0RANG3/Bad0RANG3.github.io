---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/blog/PostCard.astro';
import { siteConfig } from '../config/site';
import { getPublishedPosts } from '../lib/content';

const posts = await getPublishedPosts();
const featuredPosts = posts.filter(p => p.data.featured);
const heroPosts = featuredPosts.length > 0 ? featuredPosts.slice(0, 3) : posts.slice(0, 3);
const recentPosts = posts.slice(0, 6);
const { hero, author } = siteConfig;
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="relative overflow-hidden">
    <div class="absolute top-0 left-0 w-64 h-64 sm:w-96 sm:h-96 bg-primary/20 rounded-full filter blur-3xl opacity-50 animate-blob ease-in-out"></div>
    <div class="absolute bottom-0 right-0 w-64 h-64 sm:w-96 sm:h-96 bg-secondary/20 rounded-full filter blur-3xl opacity-50 animate-blob animation-delay-4000 ease-in-out"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-24 md:py-32">
      <div class="text-center max-w-3xl mx-auto">
        <div class="relative inline-block mb-6 sm:mb-8" data-reveal>
          <div class="absolute -inset-1.5 rounded-full bg-gradient-to-br from-primary/30 to-secondary/30 blur-md"></div>
          <img class="reveal relative h-24 w-24 sm:h-28 sm:w-28 md:h-32 md:w-32 rounded-full object-cover ring-4 ring-base-100 shadow-xl animate-float" style="--reveal-delay:60ms" src={author.avatar} alt={author.name} />
        </div>
        <div class="space-y-3 sm:space-y-4" data-reveal>
          <h1 class="reveal text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tight bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent" style="--reveal-delay:140ms">{hero.lyric}</h1>
          <p class="reveal text-base sm:text-lg text-base-content/80 leading-relaxed" style="--reveal-delay:240ms">{hero.lyricSource}</p>
        </div>
        <div class="reveal flex flex-wrap justify-center gap-4 mt-10" style="--reveal-delay:340ms">
          <a href="/posts" class="btn btn-primary gap-2 rounded-xl"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>查看文章</a>
          <a href="/about" class="btn btn-outline gap-2 rounded-xl"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>关于我</a>
        </div>
        <div class="reveal mt-12 flex items-center justify-center space-x-6 text-sm text-base-content/60" style="--reveal-delay:440ms">
          <span class="flex items-center space-x-2"><svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>数字世界</span>
          <span class="flex items-center space-x-2"><svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>持续更新</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div data-reveal class="reveal mb-8"><h2 class="text-2xl font-bold sm:text-3xl"><span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">精选文章</span></h2></div>
    {heroPosts.length === 0 ? <div class="card bg-base-100 shadow-sm"><div class="card-body items-center text-base-content/50">还没有文章哦</div></div> : <div class="grid gap-5 sm:gap-6 lg:grid-cols-3">{heroPosts.map((p,i) => <div style={`--reveal-delay:${i*80}ms`}><PostCard post={p} /></div>)}</div>}
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12">
    <div data-reveal class="reveal mb-8"><h2 class="text-2xl font-bold sm:text-3xl">最近更新</h2></div>
    <div class="grid gap-4 sm:gap-5">{recentPosts.map((p,i) => <div style={`--reveal-delay:${i*60}ms`}><PostCard post={p} /></div>)}</div>
    {posts.length > 6 && <div class="mt-8 text-center"><a data-reveal href="/posts" class="reveal btn btn-outline gap-2 rounded-xl">查看全部文章<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a></div>}
  </section>
</BaseLayout>
