---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';
import PostCard from '../components/blog/PostCard.astro';
import ProjectCard from '../components/profile/ProjectCard.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { projects } from '../config/projects';
import { ROUTES } from '../config/routes';
import { siteConfig } from '../config/site';
import { LAYOUT, STAGGER } from '../config/ui';
import { getPublishedPosts } from '../lib/content';
import { withBase } from '../lib/urls';

const posts = await getPublishedPosts();
const { author, music, netease, github } = siteConfig;

const recentPosts = posts.slice(0, LAYOUT.RECENT_POSTS_COUNT);
const featuredProjects = projects.slice(0, 3);
const songUrl = music.officialUrl;
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="home site-frame">
    <header class="home-intro" data-island-cue="首页概览">
      <p class="eyebrow">Index</p>
      <h1 id="home-title" class="home-title">{author.name}</h1>
      <p class="home-lede">
        拆解软件、写点代码、折腾配置。文章在左边，正在听的东西和开发动态在右边。
      </p>
    </header>

    <div class="home-layout">
      <div class="home-main">
        <section id="home-posts" aria-labelledby="recent-posts-title" data-island-cue="最新文章">
          <div class="section-heading-row">
            <SectionHeader label="Recent" title="最新文章" titleId="recent-posts-title" />
            <a href={withBase(ROUTES.POSTS)} class="home-more">
              全部 {posts.length} 篇 <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
            </a>
          </div>

          <div class="grid gap-4 sm:gap-5 sm:grid-cols-2">
            {recentPosts.map((post, index) => (
              <div style={`--reveal-delay:${STAGGER.LIST_START + index * STAGGER.LIST_STEP}ms`}>
                <PostCard post={post} />
              </div>
            ))}
          </div>
        </section>

        <section id="home-projects" class="home-section" aria-labelledby="projects-title" data-island-cue="项目">
          <div class="section-heading-row">
            <SectionHeader label="Projects" title="在做的东西" titleId="projects-title" />
            <a href={withBase(ROUTES.PROJECTS)} class="home-more">
              全部 {projects.length} 个 <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
            </a>
          </div>

          <div class="grid gap-4 sm:gap-5 sm:grid-cols-2">
            {featuredProjects.map((project, index) => (
              <div style={`--reveal-delay:${STAGGER.CARD_START + index * STAGGER.CARD_STEP}ms`}>
                <ProjectCard project={project} />
              </div>
            ))}
          </div>
        </section>
      </div>

      <aside class="home-side" aria-label="音乐与开发动态">
        <!-- The player card is the anchor of this column: it mirrors the island. -->
        <section class="player-card" data-now-card data-playing="false" data-island-cue="正在播放">
          <div class="player-card__art">
            <img src={withBase(music.cover)} alt={`${music.album} 专辑封面`} width="320" height="320" loading="eager" />
          </div>

          <h2 class="player-card__title">{music.title}</h2>
          <p class="player-card__artist">{music.artist} · {music.album}</p>

          <!-- Progress only. The lyric line and the 0:00 / 4:26 row both repeated
               what the island already shows when it is expanded, and the play
               button already carries the state. -->
          <div class="player-card__bar" data-live-progress><i></i></div>

          <div class="player-card__actions">
            <button class="player-card__toggle" type="button" data-now-toggle aria-label="播放音乐">
              <span class="player-card__glyph" aria-hidden="true"></span>
              <span data-now-toggle-copy>播放</span>
            </button>
            <a class="player-card__link" href={songUrl} target="_blank" rel="noreferrer">
              网易云 <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
            </a>
          </div>
        </section>

        <section
          class="side-block"
          data-ncm-profile
          data-api-base={netease.apiBase}
          data-user-id={netease.userId}
          aria-labelledby="side-ncm-title"
        >
          <header class="side-block__head">
            <h2 id="side-ncm-title">在别处</h2>
            <div class="side-block__links">
              <a href={netease.profileUrl} target="_blank" rel="noreferrer" aria-label={`前往 ${netease.fallback.nickname} 的网易云主页`}><Icon name="arrow-up-right" class="h-3.5 w-3.5" /></a>
              <a href={github.profileUrl} target="_blank" rel="noreferrer" aria-label={`前往 ${github.username} 的 GitHub`}><Icon name="github" class="h-3.5 w-3.5" /></a>
            </div>
          </header>

          <div class="side-person">
            <img data-ncm-avatar src={netease.fallback.avatarUrl} alt={`${netease.fallback.nickname} 的网易云头像`} width="80" height="80" loading="lazy" />
            <div>
              <p class="side-person__name">
                <strong data-ncm-name>{netease.fallback.nickname}</strong>
                <span class="side-badge" data-ncm-vip>{netease.fallback.vipLabel}</span>
              </p>
              <p class="side-person__note" data-ncm-signature>{netease.fallback.signature}</p>
            </div>
          </div>

          <dl class="side-metrics">
            <div><dt>关注</dt><dd data-ncm-follows>{netease.fallback.follows}</dd></div>
            <div><dt>粉丝</dt><dd data-ncm-followeds>{netease.fallback.followeds}</dd></div>
            <div><dt>播放</dt><dd data-ncm-listens>{netease.fallback.listenSongs.toLocaleString('zh-CN')}</dd></div>
          </dl>
        </section>

      </aside>
    </div>

  </div>

  <script>
    import '../scripts/home';
    import '../scripts/home-motion';
  </script>
</BaseLayout>

<style>
  .home {
    --ink: var(--fx-text);
    --muted: var(--fx-muted);
    --soft: var(--text-faint);
    --line: var(--fx-line);
    --accent: var(--fx-pink);
    padding-block: clamp(1.5rem, 3.5vw, 2.4rem) clamp(2rem, 5vw, 3.5rem);
  }

  /* ------------------------------------------------------------------
     Intro line
     ------------------------------------------------------------------ */
  /* One column of copy, so no flex row: the counts that used to sit on the
     opposite side were removed as duplicates of the nav and footer. */
  .home-intro {
    padding-bottom: clamp(1.2rem, 3vw, 1.8rem);
    border-bottom: 1px solid var(--line);
  }

  /* The wordmark stays monospace on purpose: it is Latin-only, and it is the
     one place the "terminal" character of the old design still earns its keep. */
  .home-title {
    margin: 0.45rem 0 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--type-display);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }

  .home-lede {
    max-width: 31rem;
    margin: 0.55rem 0 0;
    color: var(--muted);
    font-size: var(--type-small);
    line-height: var(--leading-prose);
  }

  /* ------------------------------------------------------------------
     Two-column shell: content left, live column right.
     ------------------------------------------------------------------ */
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
    align-items: start;
    gap: clamp(1.6rem, 3vw, 2.4rem);
    margin-top: clamp(1.4rem, 3vw, 2rem);
  }

  .home-side {
    position: sticky;
    top: 5.25rem;
    display: grid;
    gap: 0.9rem;
  }

  .home-section { margin-top: clamp(2.2rem, 4vw, 3rem); }

  .home-more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 1.15rem;
    color: var(--soft);
    font-size: var(--type-meta);
    font-weight: var(--weight-strong);
    text-decoration: none;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .home-more:hover,
  .home-more:focus-visible { color: var(--accent); gap: 0.42rem; }

  /* ------------------------------------------------------------------
     Player card
     ------------------------------------------------------------------ */
  .player-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.35rem;
    padding: 0.8rem 0.8rem 1rem;
    background: color-mix(in srgb, var(--fx-surface-strong) 92%, transparent);
    box-shadow: 0 22px 50px -44px var(--fx-shadow);
  }

  .player-card__art {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .player-card__art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .player-card[data-playing='true'] .player-card__art img { transform: scale(1.04); }

  /* The play/pause button already states the state, so the floating status
     chip over the artwork was a second copy of the same information. */
  .player-card__title {
    margin: 0.8rem 0 0;
    color: var(--ink);
    font-size: var(--type-lead);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-heading);
  }

  .player-card__artist {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: var(--type-meta);
  }

  .player-card__bar {
    height: 3px;
    margin-top: 0.8rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .player-card__bar i {
    display: block;
    width: var(--live-progress, 0%);
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transition: width 0.2s linear;
  }

  .player-card__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }

  .player-card__toggle {
    display: inline-flex;
    flex: 1;
    min-height: 2.35rem;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #2a1220;
    font-size: var(--type-small);
    font-weight: var(--weight-display);
    transition: background 0.25s ease;
  }

  .player-card__toggle:hover,
  .player-card__toggle:focus-visible { background: color-mix(in srgb, var(--accent) 86%, black); }

  .player-card__glyph {
    width: 0;
    height: 0;
    margin-left: 0.1rem;
    border-top: 0.3rem solid transparent;
    border-bottom: 0.3rem solid transparent;
    border-left: 0.46rem solid currentColor;
  }

  .player-card__toggle[data-playing='true'] .player-card__glyph {
    width: 0.14rem;
    height: 0.62rem;
    margin-left: 0;
    border: 0;
    background: currentColor;
    box-shadow: 0.26rem 0 0 currentColor;
  }

  .player-card__link {
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    gap: 0.28rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 0.7rem;
    color: var(--soft);
    font-size: var(--type-meta);
    font-weight: var(--weight-strong);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .player-card__link:hover,
  .player-card__link:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    color: var(--ink);
  }

  /* ------------------------------------------------------------------
     Sidebar data blocks
     ------------------------------------------------------------------ */
  .side-block {
    border: 1px solid var(--line);
    border-radius: 1.1rem;
    padding: 0.85rem 0.9rem 0.9rem;
    background: color-mix(in srgb, var(--fx-surface-strong) 82%, transparent);
  }

  .side-block__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }

  .side-block__head h2 {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: var(--soft);
    font-size: var(--type-meta);
    font-weight: var(--weight-strong);
  }

  .side-block__links {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .side-block__head a { display: inline-grid; width: 2rem; height: 2rem; place-items: center; border-radius: 0.5rem; color: var(--soft); transition: color 0.2s ease; }
  .side-block__head a:focus-visible,
  .player-card__toggle:focus-visible,
  .player-card__link:focus-visible,
  .home-more:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .side-block__head a:hover,
  .side-block__head a:focus-visible { color: var(--accent); }

  .side-person {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .side-person img {
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    object-fit: cover;
  }

  .side-person__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: var(--ink);
    font-size: var(--type-small);
    font-weight: var(--weight-strong);
  }

  .side-badge {
    border-radius: 999px;
    padding: 0.08rem 0.36rem;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: color-mix(in srgb, var(--accent) 82%, var(--ink));
    font-size: var(--type-meta);
    font-weight: var(--weight-strong);
  }

  .side-person__note {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.16rem 0 0;
    color: var(--soft);
    font-size: var(--type-meta);
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .side-metrics {
    display: grid;
    /* Three columns for three numbers; the fourth slot went with the level
       metric, and an empty track would have halved the card's density. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.3rem;
    margin: 0.75rem 0 0;
    border-top: 1px solid var(--line);
    padding-top: 0.65rem;
  }

  .side-metrics > div { display: grid; gap: 0.1rem; }
  .side-metrics dt { color: var(--soft); font-size: var(--type-meta); }
  .side-metrics dd {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--type-small);
    font-weight: var(--weight-strong);
    font-variant-numeric: tabular-nums;
  }

  /* ------------------------------------------------------------------
     Below 1024px the live column moves above the articles: the page is
     about "音乐与动态", so the player leads instead of trailing.
     ------------------------------------------------------------------ */
  @media (max-width: 1023px) {
    .home-layout {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1.6rem;
    }

    .home-side { display: contents; }

    .player-card { order: -2; }
    .home-main { order: -1; }
    .side-block { order: 0; }

    .player-card { max-width: 22rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .player-card__art img,
    .player-card__bar i {
      animation: none;
      transition: none;
      transform: none;
    }
  }
</style>
