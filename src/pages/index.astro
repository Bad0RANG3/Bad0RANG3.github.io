---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';
import PostCard from '../components/blog/PostCard.astro';
import ProjectCard from '../components/profile/ProjectCard.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { projects } from '../config/projects';
import { ROUTES, postPath, tagPath } from '../config/routes';
import { siteConfig } from '../config/site';
import { LAYOUT, STAGGER } from '../config/ui';
import { getPublishedPosts, getPostReadingMinutes } from '../lib/content';
import { getTagGroups } from '../lib/taxonomy';
import { formatDate } from '../lib/date';
import { withBase } from '../lib/urls';

const posts = await getPublishedPosts();
const tagGroups = await getTagGroups();
const { author, music, netease, github, about } = siteConfig;

/* Lead with a featured post, preferring one that also ships a cover image. */
const featured =
  posts.find((post) => post.data.featured && post.data.cover) ??
  posts.find((post) => post.data.featured) ??
  posts[0];

const latestPosts = posts
  .filter((post) => post.slug !== featured?.slug)
  .slice(0, LAYOUT.RECENT_POSTS_COUNT);

const featuredProjects = projects.slice(0, 3);
const topTags = tagGroups.slice(0, 8);

const stats = [
  { label: '文章', value: posts.length },
  { label: '项目', value: projects.length },
  { label: '标签', value: tagGroups.length },
  { label: '工具', value: about.techStack.length + about.devTools.length },
];

const newest = posts[0];
const updatedLabel = newest ? formatDate(newest.data.updatedDate ?? newest.data.date) : '—';
const featuredMeta = featured
  ? `${formatDate(featured.data.date)} · ${getPostReadingMinutes(featured)} 分钟阅读`
  : '';
const featuredTags = featured?.data.tags.slice(0, 3) ?? [];
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="index-page site-frame">
    <header class="index-head" data-island-cue="首页概览">
      <div class="index-head__main">
        <img
          class="index-avatar"
          src={withBase(author.avatar)}
          alt={author.name}
          width="64"
          height="64"
          loading="eager"
        />
        <div>
          <p class="eyebrow">Index</p>
          <h1 id="home-title" class="index-title">{author.name}</h1>
          <p class="index-lede">
            拆解软件、写点代码、折腾配置。这里收着最新的文章、项目，和那些值得留下来的记录。
          </p>
        </div>
      </div>

      <dl class="index-stats">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
        <div>
          <dt>更新于</dt>
          <dd class="index-stats__date">{updatedLabel}</dd>
        </div>
      </dl>
    </header>

    <!-- Collapsed until the island reports real audio; driven by home-motion.ts. -->
    <div class="now-pill" data-now-pill data-visible="false" data-playing="false" aria-hidden="true" inert>
      <span class="now-pill__eq" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="now-pill__state" data-now-state-label>正在播放</span>
      <span class="now-pill__text">
        <strong>{music.title}</strong>
        <span>{music.artist} · {music.album}</span>
      </span>
      <span class="now-pill__time"><span data-live-elapsed>0:00</span> / <span data-live-duration>{music.durationLabel}</span></span>
      <button class="now-pill__toggle" type="button" data-now-toggle aria-label="暂停音乐">暂停</button>
    </div>

    {featured && (
      <a class="feature-card" href={withBase(postPath(featured.slug))} aria-labelledby="featured-title">
        {featured.data.cover && (
          <span class="feature-card__media">
            <img
              src={withBase(featured.data.cover)}
              alt={featured.data.coverAlt ?? featured.data.title}
              loading="eager"
              decoding="async"
            />
          </span>
        )}
        <span class="feature-card__body">
          <span class="feature-card__label">
            <span class="feature-card__dot" aria-hidden="true"></span>
            精选 · {featured.data.category ?? '文章'}
          </span>
          <h2 id="featured-title" class="feature-card__title">{featured.data.title}</h2>
          <span class="feature-card__desc">{featured.data.description}</span>
          <span class="feature-card__foot">
            <span class="feature-card__meta">{featuredMeta}</span>
            {featuredTags.length > 0 && (
              <span class="feature-card__tags">{featuredTags.map((tag) => `#${tag}`).join('  ')}</span>
            )}
            <Icon name="arrow-up-right" class="feature-card__arrow h-4 w-4" />
          </span>
        </span>
      </a>
    )}

    <section id="home-posts" class="index-section" aria-labelledby="recent-posts-title" data-island-cue="最新文章">
      <div class="section-heading-row">
        <SectionHeader label="Recent" title="最新文章" titleId="recent-posts-title" />
        <a href={withBase(ROUTES.POSTS)} class="index-more">
          全部 {posts.length} 篇 <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="grid gap-4 sm:gap-5 md:grid-cols-2 xl:grid-cols-3">
        {latestPosts.map((post, index) => (
          <div style={`--reveal-delay:${STAGGER.LIST_START + index * STAGGER.LIST_STEP}ms`}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    </section>

    <section id="home-projects" class="index-section" aria-labelledby="projects-title" data-island-cue="项目">
      <div class="section-heading-row">
        <SectionHeader label="Projects" title="在做的东西" titleId="projects-title" />
        <a href={withBase(ROUTES.PROJECTS)} class="index-more">
          全部 {projects.length} 个 <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="grid gap-4 sm:gap-5 md:grid-cols-2 xl:grid-cols-3">
        {featuredProjects.map((project, index) => (
          <div style={`--reveal-delay:${STAGGER.CARD_START + index * STAGGER.CARD_STEP}ms`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </section>

    <section id="home-presence" class="index-section" aria-labelledby="presence-title" data-island-cue="音乐与开发">
      <div class="section-heading-row">
        <SectionHeader label="Presence" title="音乐与开发" titleId="presence-title" />
        <a href={withBase(ROUTES.ABOUT)} class="index-more">
          关于我 <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="presence-grid">
        <article
          class="profile-card presence-card ncm-profile-card"
          data-ncm-profile
          data-api-base={netease.apiBase}
          data-user-id={netease.userId}
        >
          <header class="presence-card-header">
            <span class="presence-provider"><Icon name="music" class="h-4 w-4" /> 网易云音乐</span>
            <a href={netease.profileUrl} target="_blank" rel="noreferrer" aria-label={`前往 ${netease.fallback.nickname} 的网易云主页`}><Icon name="arrow-up-right" class="h-4 w-4" /></a>
          </header>

          <div class="ncm-profile-layout">
            <div class="ncm-avatar-shell">
              <img src={netease.fallback.avatarUrl} alt={`${netease.fallback.nickname} 的网易云头像`} width="116" height="116" loading="lazy" data-ncm-avatar />
            </div>

            <div class="ncm-profile-copy">
              <div class="presence-name-line ncm-name-line">
                <h3 data-ncm-name>{netease.fallback.nickname}</h3>
                <span class="ncm-vip-badge" data-ncm-vip>{netease.fallback.vipLabel}</span>
              </div>
              <p class="ncm-profile-signature" data-ncm-signature>{netease.fallback.signature}</p>
              <div class="ncm-profile-meta" aria-label="网易云身份信息">
                <span><Icon name="star" class="h-3.5 w-3.5" /><b data-ncm-medals>{netease.fallback.medalNum}</b> 枚徽章</span>
                <span><Icon name="music" class="h-3.5 w-3.5" /><b data-ncm-fan>{netease.fallback.fanLabel}</b></span>
              </div>
            </div>
          </div>

          <dl class="ncm-profile-metrics">
            <div><dt>关注</dt><dd data-ncm-follows>{netease.fallback.follows}</dd></div>
            <div><dt>粉丝</dt><dd data-ncm-followeds>{netease.fallback.followeds}</dd></div>
            <div><dt>等级</dt><dd>Lv.<span data-ncm-level>{netease.fallback.level}</span></dd></div>
            <div><dt>播放</dt><dd data-ncm-listens>{netease.fallback.listenSongs.toLocaleString('zh-CN')}</dd></div>
          </dl>
        </article>

        <article class="profile-card presence-card presence-github-card" data-github-profile data-api-url={github.apiUrl}>
          <header class="presence-card-header">
            <span class="presence-provider"><Icon name="github" class="h-4 w-4" /> GitHub</span>
            <a href={github.profileUrl} target="_blank" rel="noreferrer" aria-label={`前往 ${github.username} 的 GitHub`}><Icon name="arrow-up-right" class="h-4 w-4" /></a>
          </header>

          <div class="github-profile-row">
            <div class="github-avatar-shell">
              <img src={withBase(author.avatar)} alt={`${github.username} 的头像`} width="116" height="116" loading="lazy" />
            </div>
            <div class="github-profile-copy">
              <div class="presence-name-line github-name-line">
                <h3>{author.name}</h3>
                <span class="github-profile-badge">PUBLIC</span>
              </div>
              <a href={github.profileUrl} target="_blank" rel="noreferrer">@{github.username}</a>
              <p class="github-profile-bio" data-github-bio>代码、博客与持续进行中的小实验。</p>
            </div>
          </div>

          <dl class="github-metrics">
            <div><dt>仓库</dt><dd data-github-repos>—</dd></div>
            <div><dt>关注者</dt><dd data-github-followers>—</dd></div>
            <div><dt>正在关注</dt><dd data-github-following>—</dd></div>
          </dl>
        </article>
      </div>
    </section>

    <section class="index-tags" aria-labelledby="home-tags-title">
      <h2 id="home-tags-title" class="index-tags__title">常用标签</h2>
      <ul>
        {topTags.map((tag) => (
          <li>
            <a href={withBase(tagPath(tag.name))}>
              {tag.name}<span>{tag.posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="home-contact" class="index-contact" aria-labelledby="contact-title" data-island-cue="保持联系">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">想聊点什么？</h2>
        <p class="index-contact__copy">工具、配置、特效实验都欢迎，直接发邮件就好。</p>
      </div>
      <div class="index-contact__actions">
        <a class="index-action index-action--primary" href={`mailto:${author.email}`}>
          发送邮件 <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
        <a class="index-action" href={withBase(ROUTES.ABOUT)}>关于我</a>
      </div>
    </section>
  </div>

  <script>
    import '../scripts/home';
    import '../scripts/home-motion';
  </script>
</BaseLayout>

<style>
  .index-page {
    --ink: var(--fx-text);
    --muted: var(--fx-muted);
    --soft: var(--text-faint);
    --line: var(--fx-line);
    --accent: var(--fx-pink);
    padding-block: clamp(1.6rem, 4vw, 2.6rem) clamp(2rem, 5vw, 3.5rem);
  }

  /* ------------------------------------------------------------------
     Header: identity in one compact block, then the numbers.
     ------------------------------------------------------------------ */
  .index-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.5rem 2rem;
  }

  .index-head__main {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .index-avatar {
    width: 3.4rem;
    height: 3.4rem;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    object-fit: cover;
  }

  .index-title {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .index-lede {
    max-width: 32rem;
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .index-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.4rem 1.5rem;
    margin: 0;
  }

  .index-stats > div {
    display: grid;
    gap: 0.2rem;
    min-width: 3rem;
  }

  .index-stats dt {
    color: var(--soft);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .index-stats dd {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .index-stats .index-stats__date {
    font-family: inherit;
    font-size: 0.8rem;
    letter-spacing: -0.01em;
  }

  /* ------------------------------------------------------------------
     Now-playing pill: collapsed until audio is actually in the pipe.
     ------------------------------------------------------------------ */
  .now-pill {
    display: flex;
    max-height: 0;
    align-items: center;
    gap: 0.7rem;
    overflow: hidden;
    border-radius: 999px;
    opacity: 0;
    transition: max-height 0.35s var(--ease), opacity 0.3s ease, margin-top 0.35s var(--ease);
  }

  .now-pill[data-visible='true'] {
    max-height: 4rem;
    margin-top: 1.3rem;
    opacity: 1;
  }

  .now-pill__eq {
    display: flex;
    height: 0.9rem;
    flex-shrink: 0;
    align-items: flex-end;
    gap: 2px;
  }

  .now-pill__eq i {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: var(--accent);
    transform-origin: bottom;
  }

  .now-pill__eq i:nth-child(2) { height: 65%; }
  .now-pill__eq i:nth-child(3) { height: 82%; }

  .now-pill[data-playing='true'] .now-pill__eq i {
    animation: pill-eq 0.9s ease-in-out infinite alternate;
  }

  .now-pill[data-playing='true'] .now-pill__eq i:nth-child(2) { animation-delay: 0.15s; }
  .now-pill[data-playing='true'] .now-pill__eq i:nth-child(3) { animation-delay: 0.3s; }

  .now-pill__state {
    flex-shrink: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .now-pill__text {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.5rem;
  }

  .now-pill__text strong {
    overflow: hidden;
    color: var(--ink);
    font-size: 0.84rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .now-pill__text span {
    overflow: hidden;
    color: var(--soft);
    font-size: 0.76rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .now-pill__time {
    margin-left: auto;
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .now-pill__toggle {
    flex-shrink: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--line));
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 700;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .now-pill__toggle:hover,
  .now-pill__toggle:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 62%, var(--line));
    background: color-mix(in srgb, var(--accent) 20%, transparent);
  }

  /* ------------------------------------------------------------------
     Featured post
     ------------------------------------------------------------------ */
  .feature-card {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: stretch;
    margin-top: clamp(1.5rem, 3.5vw, 2.2rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--fx-surface-strong) 90%, transparent);
    box-shadow: 0 24px 60px -46px var(--fx-shadow);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s var(--ease);
  }

  .feature-card:hover,
  .feature-card:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    transform: translateY(-2px);
  }

  .feature-card__media {
    display: block;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .feature-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 11rem;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .feature-card:hover .feature-card__media img { transform: scale(1.03); }

  .feature-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.15rem, 2.5vw, 1.8rem);
  }

  .feature-card__label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
  }

  .feature-card__dot {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .feature-card__title {
    margin: 0;
    font-size: clamp(1.2rem, 2.3vw, 1.65rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.32;
    transition: color 0.25s ease;
  }

  .feature-card:hover .feature-card__title { color: var(--accent); }

  .feature-card__desc {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.8;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .feature-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .feature-card__meta,
  .feature-card__tags {
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .feature-card__tags { color: color-mix(in srgb, var(--accent) 72%, var(--soft)); }

  .feature-card__arrow {
    margin-left: auto;
    color: var(--soft);
    transition: transform 0.3s var(--ease), color 0.25s ease;
  }

  .feature-card:hover .feature-card__arrow {
    color: var(--accent);
    transform: translate(0.15rem, -0.15rem);
  }

  /* ------------------------------------------------------------------
     Sections, tags, contact
     ------------------------------------------------------------------ */
  .index-section { margin-top: clamp(2.3rem, 4.5vw, 3.2rem); }

  .index-more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 1.15rem;
    color: var(--soft);
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .index-more:hover,
  .index-more:focus-visible { color: var(--accent); gap: 0.45rem; }

  .index-tags {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    margin-top: clamp(2.3rem, 4.5vw, 3.2rem);
    border-top: 1px solid var(--line);
    padding-top: 1.3rem;
  }

  .index-tags__title {
    margin: 0;
    color: var(--soft);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .index-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index-tags a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.24rem 0.6rem;
    color: var(--muted);
    font-size: 0.76rem;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .index-tags a:hover,
  .index-tags a:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--ink);
  }

  .index-tags a span {
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 0.64rem;
  }

  .index-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.2rem;
    margin-top: clamp(2.3rem, 4.5vw, 3.2rem);
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 3vw, 2.1rem);
  }

  .index-contact h2 {
    margin: 0.55rem 0 0;
    color: var(--ink);
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .index-contact__copy {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.8;
  }

  .index-contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .index-action {
    display: inline-flex;
    min-height: 2.55rem;
    align-items: center;
    justify-content: center;
