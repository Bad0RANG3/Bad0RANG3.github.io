---
import { withBase } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到" description="你访问的页面不存在。">
  <div class="flex min-h-[65vh] items-center justify-center px-4">
    <div class="hard-card w-full max-w-lg rounded-[2rem] p-10 text-center">
      <p class="eyebrow justify-center">404</p>
      <h1 class="display-title mt-4 text-5xl sm:text-6xl">页面不见了</h1>
      <p class="mt-4 text-base-content/60">你访问的内容可能已经移动，或者链接本身有误。</p>
      <a href={withBase('/')} class="btn-brutal mt-8">返回首页</a>
    </div>
  </div>
</BaseLayout>
