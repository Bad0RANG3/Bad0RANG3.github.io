---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { getPublishedPosts } from '../lib/content';
import { formatDate } from '../lib/date';
import { withBase } from '../lib/urls';

const posts = await getPublishedPosts();
const metadata = posts.map((post) => ({ slug: post.slug, title: post.data.title, dateLabel: formatDate(post.data.date), url: withBase(`/posts/${post.slug}/`) }));
---
<BaseLayout title="本地书架" description="管理当前浏览器中的收藏与阅读进度。">
  <div class="site-frame py-5 sm:py-8">
    <PageHeader label="Your local shelf" title="本地书架" description="收藏和阅读进度只保存在当前浏览器，不会上传到服务器。" />
    <div class="mb-6 flex flex-wrap gap-3"><button id="clear-library" type="button" class="btn-brutal-outline text-sm">清除本地数据</button><span id="library-status" class="self-center text-sm text-base-content/55" role="status"></span></div>
    <div class="grid gap-8 lg:grid-cols-2"><section aria-labelledby="bookmarks-title"><div class="mb-4 flex items-end justify-between"><h2 id="bookmarks-title" class="display-title text-3xl">我的收藏</h2><span id="bookmark-count" class="chip-signal">0</span></div><div id="bookmarks-list"><noscript><EmptyState message="启用 JavaScript 后查看本地收藏。" /></noscript></div></section><section aria-labelledby="history-title"><div class="mb-4 flex items-end justify-between"><h2 id="history-title" class="display-title text-3xl">继续阅读</h2><span id="history-count" class="chip-lime">0</span></div><div id="history-list"><noscript><EmptyState message="启用 JavaScript 后查看阅读进度。" /></noscript></div></section></div>
  </div>
</BaseLayout>
<script is:inline define:vars={{ metadata }}>
  const safeRead = (key, fallback) => { try { const value = JSON.parse(localStorage.getItem(key) || 'null'); return value ?? fallback; } catch { return fallback; } };
  const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char]));
  const postMap = new Map(metadata.map((post) => [post.slug, post]));
  const empty = (message) => `<div class="hard-card rounded-[1.5rem] p-8 text-center text-sm text-base-content/55">${message}</div>`;
  const render = () => { const bookmarks = safeRead('b0-bookmarks', []).filter((slug) => postMap.has(slug)); const history = safeRead('b0-reading-history', []).filter((item) => item && postMap.has(item.slug)).sort((a,b) => (b.at || 0) - (a.at || 0)); document.getElementById('bookmark-count').textContent = bookmarks.length; document.getElementById('history-count').textContent = history.length; document.getElementById('bookmarks-list').innerHTML = bookmarks.length ? `<div class="space-y-3">${bookmarks.map((slug) => { const post=postMap.get(slug); return `<a href="${post.url}" class="block rounded-[1.25rem] border-2 border-base-content/10 bg-base-100/80 p-4 hover:border-primary/40"><strong class="block">${escapeHtml(post.title)}</strong><span class="mt-1 block text-xs text-base-content/45">${post.dateLabel}</span></a>`; }).join('')}</div>` : empty('还没有收藏文章。'); document.getElementById('history-list').innerHTML = history.length ? `<div class="space-y-3">${history.map((item) => { const post=postMap.get(item.slug); const progress=Math.round(Math.max(0, Math.min(1, Number(item.progress)||0))*100); return `<a href="${post.url}" class="block rounded-[1.25rem] border-2 border-base-content/10 bg-base-100/80 p-4 hover:border-primary/40"><div class="flex items-start justify-between gap-3"><strong>${escapeHtml(post.title)}</strong><span class="font-mono text-xs text-primary">${item.completed ? '已读' : `${progress}%`}</span></div><div class="mt-3 h-1.5 overflow-hidden rounded-full bg-base-200"><span class="block h-full bg-primary" style="width:${item.completed ? 100 : progress}%"></span></div></a>`; }).join('')}</div>` : empty('打开一篇文章后，这里会记录你的阅读进度。'); };
  document.getElementById('clear-library')?.addEventListener('click', () => { try { localStorage.removeItem('b0-bookmarks'); localStorage.removeItem('b0-reading-history'); document.getElementById('library-status').textContent = '已清除'; render(); } catch { document.getElementById('library-status').textContent = '浏览器不允许访问本地存储'; } });
  try { render(); } catch { document.getElementById('library-status').textContent = '无法读取本地数据'; }
  window.addEventListener('storage', render);
</script>
