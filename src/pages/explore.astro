---
import { withBase } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/blog/PostCard.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { getPublishedPosts, getFeaturedPosts, getCategoryGroups, getTagGroups, getSeriesGroups } from '../lib/content';
import { getThoughts } from '../lib/thoughts';

const posts = await getPublishedPosts();
const featured = (await getFeaturedPosts()).slice(0, 3);
const categories = await getCategoryGroups();
const tags = await getTagGroups();
const series = await getSeriesGroups();
const thoughts = (await getThoughts()).slice(0, 3);
const randomPool = posts.map((post) => ({ url: withBase(`/posts/${post.slug}/`) }));
---
<BaseLayout title="探索" description="从精选文章、主题、系列和项目开始探索这个个人空间。">
  <div class="site-frame py-5 sm:py-8">
    <PageHeader label="探索" title="探索" description="不知道从哪开始？看看主题、项目或精选文章。" />
    <section aria-labelledby="featured-title"><div class="mb-5 flex items-end justify-between gap-4"><h2 id="featured-title" class="display-title text-3xl">精选文章</h2><button id="random-post" type="button" class="btn-brutal-outline text-sm">随机打开一篇</button></div><div class="grid gap-5 md:grid-cols-3">{featured.map((post) => <PostCard post={post} />)}</div></section>
    <section class="mt-12" aria-labelledby="latest-title"><div class="mb-5 flex items-end justify-between"><h2 id="latest-title" class="display-title text-3xl">最近更新</h2><a href={withBase('/posts/')} class="link-underline text-sm font-black">全部文章 →</a></div><div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{posts.slice(0, 6).map((post) => <PostCard post={post} compact />)}</div></section>
    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      <section class="hard-card rounded-[1.5rem] p-6" aria-labelledby="category-title"><h2 id="category-title" class="text-2xl font-black">分类</h2><div class="mt-5 flex flex-wrap gap-2">{categories.map((group) => <a class="chip-signal" href={withBase(`/posts/?category=${encodeURIComponent(group.name)}`)}>{group.name} <span class="opacity-50">{group.posts.length}</span></a>)}</div></section>
      <section class="hard-card hard-card-teal rounded-[1.5rem] p-6" aria-labelledby="tag-title"><h2 id="tag-title" class="text-2xl font-black">热门标签</h2><div class="mt-5 flex flex-wrap gap-2">{tags.slice(0, 18).map((group) => <a class="chip-lime" href={withBase(`/tags/${encodeURIComponent(group.name)}/`)}>#{group.name}</a>)}</div></section>
      <section class="hard-card rounded-[1.5rem] p-6" aria-labelledby="series-title"><h2 id="series-title" class="text-2xl font-black">系列</h2><div class="mt-5 space-y-3">{series.length ? series.map((group) => <a href={withBase(`/series/${encodeURIComponent(group.name)}/`)} class="flex items-center justify-between border-b border-base-content/10 pb-3 text-sm font-bold hover:text-primary"><span>{group.name}</span><span class="text-base-content/45">{group.posts.length} 篇 →</span></a>) : <p class="text-sm text-base-content/55">暂时还没有系列。</p>}</div></section>
      <section class="hard-card hard-card-coral rounded-[1.5rem] p-6" aria-labelledby="more-title"><h2 id="more-title" class="text-2xl font-black">更多入口</h2><div class="mt-5 grid gap-2 sm:grid-cols-2">{[["/archive/","时间归档"],["/projects/","我的项目"],["/tools/","在线工具"],["/thoughts/","碎碎念"]].map(([href,label]) => <a href={withBase(href)} class="rounded-xl border-2 border-base-content/10 bg-base-100/60 px-4 py-3 text-sm font-bold hover:border-primary/40 hover:text-primary">{label} →</a>)}</div></section>
    </div>
    {thoughts.length > 0 && <section class="mt-12" aria-labelledby="thoughts-title"><h2 id="thoughts-title" class="display-title mb-5 text-3xl">最近的碎片</h2><div class="grid gap-4 md:grid-cols-3">{thoughts.map((thought) => <a href={withBase('/thoughts/')} class="rounded-[1.25rem] border-2 border-base-content/10 bg-base-100/70 p-5 hover:border-primary/40"><time class="font-mono text-xs text-base-content/40">{thought.data.date.toLocaleDateString('zh-CN')}</time><p class="mt-3 line-clamp-3 text-sm leading-7 text-base-content/65">{thought.body.slice(0, 180)}</p></a>)}</div></section>}
  </div>
</BaseLayout>
<script is:inline define:vars={{ randomPool }}>
  const randomButton = document.getElementById('random-post');
  randomButton?.addEventListener('click', () => { if (!randomPool.length) return; window.location.href = randomPool[Math.floor(Math.random() * randomPool.length)].url; });
</script>
