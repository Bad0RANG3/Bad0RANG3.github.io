---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import ContentCard from '../../components/ui/ContentCard.astro';
import { tools } from '../../config/tools';
import { toolPath } from '../../config/routes';
---

<BaseLayout title="工具" description="实用的在线小工具。">
  <div class="site-frame py-5 sm:py-8">
    <PageHeader label="Tools" title="在线工具" description="实用的在线小工具。" />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => (
        <ContentCard
          href={toolPath(tool.slug)}
          title={tool.name}
          description={tool.description}
          icon={tool.icon}
          tone="citrus"
        />
      ))}
    </div>
  </div>
</BaseLayout>
