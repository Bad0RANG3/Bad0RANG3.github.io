  dz.addEventListener('click',function(e){if(e.target===dz||(dz.contains(e.target)&&e.target.tagName!=='A')){fin.value='';fin.click();}});
  fin.addEventListener('click',function(e){e.stopPropagation();});
  fin.addEventListener('change',function(){if(fin.files.length>0){loadFiles(Array.from(fin.files));dz.classList.add('ready');}});
  dz.addEventListener('dragover',function(e){e.preventDefault();e.stopPropagation();dz.classList.add('active');});
  dz.addEventListener('dragleave',function(e){e.preventDefault();e.stopPropagation();dz.classList.remove('active');});
  dz.addEventListener('drop',function(e){e.preventDefault();e.stopPropagation();dz.classList.remove('active');var items=e.dataTransfer.items;if(!items)return;var files=[];
    function tr(it){if(it.kind!=='file')return Promise.resolve();var en=it.webkitGetAsEntry?it.webkitGetAsEntry():null;if(en&&en.isDirectory){return rd(en,files);}else{files.push(it.getAsFile());return Promise.resolve();}}
    function rd(en,out){return new Promise(function(rs){var r=en.createReader(),es=[];
      function rb(){r.readEntries(function(b){if(b.length===0){var ps=[];for(var i=0;i<es.length;i++){(function(e){if(e.isFile)ps.push(new Promise(function(rr){e.file(rr);}));else if(e.isDirectory)ps.push(rd(e,out));})(es[i]);}Promise.all(ps).then(rs);return;}es.push.apply(es,b);rb();});}rb();});}
    var ps=[];for(var i=0;i<items.length;i++)ps.push(tr(items[i]));Promise.all(ps).then(function(){if(files.length>0){loadFiles(files);dz.classList.add('ready');}});});
}

var kw=$('#kbdWrap');if(kw){kw.addEventListener('click',function(e){var ke=e.target.closest('.scfg-kbd-key');if(!ke||ke.classList.contains('disabled'))return;var k=ke.dataset.key;if(!k)return;_bk=k;renderKeyboard();updateBuyPreview();});kw.addEventListener('pointermove',function(e){var ke=e.target.closest('.scfg-kbd-key');if(!ke||ke.classList.contains('disabled')){hideKeyTip();return;}showKeyTip(tooltipText(ke.dataset.key),e.clientX,e.clientY);});kw.addEventListener('pointerleave',hideKeyTip);}
var km=$('#kbdMouse');if(km){km.addEventListener('click',function(e){var ke=e.target.closest('.scfg-kbd-key');if(!ke||ke.classList.contains('disabled'))return;var k=ke.dataset.key;if(!k)return;_bk=k;renderKeyboard();updateBuyPreview();});km.addEventListener('pointermove',function(e){var ke=e.target.closest('.scfg-kbd-key');if(!ke||ke.classList.contains('disabled')){hideKeyTip();return;}showKeyTip(tooltipText(ke.dataset.key),e.clientX,e.clientY);});km.addEventListener('pointerleave',hideKeyTip);}
var bc=$('#buyCats');if(bc){bc.addEventListener('click',function(e){var c=e.target.closest('.scfg-buy-cat');if(!c)return;_bc=c.dataset.cat;renderBuyItems();});}
var bg=$('#buyGrid');if(bg){bg.addEventListener('click',function(e){var it=e.target.closest('.scfg-buy-item');if(!it)return;var id=it.dataset.item;_bi.has(id)?_bi.delete(id):_bi.add(id);renderBuyItems();});}
var ba=$('#buyAdd');if(ba){ba.addEventListener('click',function(){if(!_bk){toast('请先在键盘上点击一个按键');return;}if(_bi.size===0){toast('请选择至少一个武器/装备');return;}var a=[];_bi.forEach(function(x){a.push(x);});var cmd=a.map(function(x){return'buy '+x;}).join('; ');var idx=S.buyBinds.findIndex(function(b){return b.key===_bk;});if(idx>=0)S.buyBinds[idx]={key:_bk,cmd:cmd};else S.buyBinds.push({key:_bk,cmd:cmd});_bk='';_bi.clear();renderKeyboard();renderBuyItems();renderSavedBinds();updateUI();toast('已添加绑定');});}
var bcl=$('#buyClear');if(bcl){bcl.addEventListener('click',function(){_bk='';_bi.clear();renderKeyboard();renderBuyItems();});}
var bsv=$('#buySaved');if(bsv){bsv.addEventListener('click',function(e){var d=e.target.closest('.scfg-sv-del');if(!d)return;S.buyBinds.splice(parseInt(d.dataset.idx),1);renderSavedBinds();updateUI();});}

var cbs=document.querySelectorAll('#optionsCard input[type=checkbox]');for(var i=0;i<cbs.length;i++){cbs[i].addEventListener('change',updateUI);}
var pni=$('#playerName');if(pni)pni.addEventListener('input',updateUI);

var bd=$('#btnDownload');if(bd){bd.addEventListener('click',function(){var r=this._r;if(!r)return;var blob=new Blob([r.cfg],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;var n=$('#playerName').value.trim()||(S.user&&S.user.name)||'Player';a.download=n+'_CSGO.cfg';document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);toast('已下载 CFG 文件');});}
var bcp=$('#btnCopy');if(bcp){bcp.addEventListener('click',function(){var r=this._r;if(!r)return;var t=r.cfg;if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(function(){toast('已复制到剪贴板');}).catch(function(){fc(t);});}else{fc(t);}});}
function fc(t){var ta=document.createElement('textarea');ta.value=t;ta.style.cssText='position:fixed;opacity:0';document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);toast('已复制到剪贴板');}
var br=$('#btnReset');if(br){br.addEventListener('click',function(){
  S.machine=S.user=S.keys=null;S.buyBinds=[];var ts=['machine','user','keys'];
  for(var i=0;i<ts.length;i++){var t=ts[i];S['_'+t+'N']=null;S['_'+t+'S']=null;S['_'+t+'E']=false;}
  $('#filelist').classList.remove('show');for(var j=0;j<ts.length;j++){var tt=ts[j],el=document.getElementById('fi-'+tt);if(el){el.classList.remove('ok','err');el.children[2].textContent='';el.children[3].textContent='';}}
  if(dz)dz.classList.remove('ready');if(fin)fin.value='';var p=$('#playerName');if(p)p.value='';
  _bk='';_bi.clear();renderKeyboard();renderBuyItems();renderSavedBinds();
  $('#pvPre').innerHTML='<span class="scfg-pv-m">// 等待选择文件夹...</span>';$('#btnDownload').disabled=true;$('#btnCopy').disabled=true;
  $('#statsBar').classList.add('hidden');$('#optionsCard').classList.add('hidden');$('#buyCard').classList.add('hidden');$('#outputCard').classList.add('hidden');updateKeyboardScale();toast('已重置');
});}

window.addEventListener('resize',updateKeyboardScale);
renderKeyboard();renderBuyItems();renderSavedBinds();updateKeyboardScale();
})();
</script>
