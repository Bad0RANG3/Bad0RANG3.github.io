---
import { withBase } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';
import { SOCIAL_ICONS, siteConfig } from '../config/site';
import { projects } from '../config/projects';
import { getPublishedPosts } from '../lib/content';

const { about, author, socials } = siteConfig;
const posts = await getPublishedPosts();
const year = new Date().getFullYear();

const skillIconId: Record<string, string> = {
  TypeScript: 'typescript', Python: 'py', 'C++': 'cpp', Kotlin: 'kotlin',
  React: 'react', Vue: 'vue', 'Node.js': 'node', Git: 'git', Docker: 'docker', Linux: 'linux',
  'VS Code': 'vscode', Figma: 'figma', 'After Effects': 'ae', Photoshop: 'ps',
  Wireshark: '/icons/skills/wireshark.png',
};

const getIconUrl = (name: string) => {
  const id = skillIconId[name];
  if (!id) return null;
  return withBase(id.startsWith('/') ? id : `/icons/skills/${id}.svg`);
};

const tools = [...about.techStack, ...about.devTools].map((item, index) => ({
  ...item,
  iconSrc: getIconUrl(item.name),
  number: String(index + 1).padStart(2, '0'),
}));

const socialCards = socials.map((social, index) => ({
  ...social,
  number: String(index + 1).padStart(2, '0'),
  iconSrc: SOCIAL_ICONS[social.name as keyof typeof SOCIAL_ICONS] ?? null,
}));

const stats = [
  { value: String(posts.length).padStart(2, '0'), label: '篇文章', note: 'WRITTEN' },
  { value: String(projects.length).padStart(2, '0'), label: '个项目', note: 'MADE' },
  { value: String(tools.length).padStart(2, '0'), label: '件工具', note: 'IN USE' },
];

const statusLines = about.currentStatus.split('\n');
---

<BaseLayout title="关于" description="认识 Bad0RANG3：开发、游戏、折腾软件，也认真收藏生活里的小发现。">
  <div class="profile-page site-frame">
    <header class="profile-hero reveal" aria-labelledby="profile-title">
      <div class="profile-hero__ruler" aria-hidden="true">
        <span>PERSONAL ARCHIVE</span><span>FILE / B03</span><span>{year}</span>
      </div>

      <div class="profile-hero__copy">
        <p class="profile-eyebrow"><i></i> 很高兴在这里遇见你</p>
        <h1 id="profile-title">
          <span>你好，我是</span>
          <strong>Bad0RANG3<em>.</em></strong>
        </h1>
        <p class="profile-intro">
          一个喜欢在计算机上折腾的普通菜鸟。这里收着我拆过的软件、写过的代码、玩过的游戏，
          也收着一些不想被时间冲走的小发现。
        </p>
        <div class="profile-actions">
          <a class="profile-action profile-action--primary" href={withBase('/posts/')}>
            翻翻我的文章 <Icon name="arrow-up-right" class="h-4 w-4" />
          </a>
          <a class="profile-action" href={`mailto:${author.email}`}>
            和我打个招呼 <Icon name="arrow-up-right" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <aside class="profile-photo" aria-label={`${author.name} 的个人照片卡`}>
        <span class="profile-photo__tape" aria-hidden="true"></span>
        <div class="profile-photo__image">
          <span class="profile-photo__ghost" aria-hidden="true">B03</span>
          <img src={withBase(author.avatar)} width="248" height="248" alt={author.name} loading="eager" />
        </div>
        <div class="profile-photo__caption">
          <div><strong>{author.name}</strong><span>maker · player · learner</span></div>
          <span class="profile-photo__status"><i></i>ONLINE</span>
        </div>
        <span class="profile-photo__scribble" aria-hidden="true">nice to meet you!</span>
      </aside>

      <dl class="profile-stats" aria-label="站点概览">
        {stats.map((stat) => (
          <div><dt>{stat.value}</dt><dd>{stat.label}<span>{stat.note}</span></dd></div>
        ))}
        <div class="profile-stats__note"><dt>∞</dt><dd>还在折腾<span>STILL CURIOUS</span></dd></div>
      </dl>
    </header>

    <main class="profile-notes">
      <section class="profile-card profile-story reveal" aria-labelledby="story-title">
        <header class="profile-card__head"><span>01</span><p>A LITTLE MORE</p></header>
        <div class="profile-story__layout">
          <div><h2 id="story-title">我想把「弄懂了」<br />变成「<em>留下来</em>」。</h2></div>
          <div class="profile-story__copy">
            <p>比起把工具用完就丢，我更喜欢追着那个「为什么」往下走。拆开、试错、重组，直到它真的在我手里跑起来。</p>
            <p>这个站点就是那段过程的切片。踩过的坑、跑通的配置、没做完的实验和偶尔冒出来的念头，都值得拥有一个位置。</p>
            <blockquote>如果其中某一行恰好帮到了你，它就没白写。</blockquote>
          </div>
        </div>
        <div class="profile-values" aria-label="我的做事方式">
          <div><span>01</span><strong>Explore</strong><p>对陌生事物保持好奇</p></div>
          <div><span>02</span><strong>Build</strong><p>把灵感做成可用的东西</p></div>
          <div><span>03</span><strong>Share</strong><p>记录过程，也分享答案</p></div>
        </div>
      </section>

      <section class="profile-card profile-now reveal" style="--reveal-delay:70ms" aria-labelledby="now-title">
        <header class="profile-card__head"><span>02</span><p>NOW RUNNING</p><i class="profile-live" aria-label="在线"></i></header>
        <h2 id="now-title">此刻正在运行</h2>
        <div class="profile-terminal">
          <div class="profile-terminal__bar"><span><i></i><i></i><i></i></span><span>now.cpp</span></div>
          <ol>
            {statusLines.map((line, index) => (
              <li><span>{String(index + 1).padStart(2, '0')}</span><code>{line || ' '}</code></li>
            ))}
          </ol>
        </div>
        <p class="profile-now__note">把好奇心编译成一些可以被使用的东西。</p>
      </section>

      <section class="profile-card profile-toolbox reveal" aria-labelledby="toolbox-title">
        <header class="profile-card__head"><span>03</span><p>TOOLBOX</p><strong>{String(tools.length).padStart(2, '0')} ITEMS</strong></header>
        <div class="profile-section-title">
          <h2 id="toolbox-title">常在手边的工具</h2>
          <p>它们不是履历关键词，而是真正参与过日常创作和实验的伙伴。</p>
        </div>
        <div class="profile-tools">
          {tools.map((tool) => (
            <a href={tool.url} target="_blank" rel="noopener noreferrer" class="profile-tool">
              <span class="profile-tool__number">{tool.number}</span>
              <span class="profile-tool__icon">{tool.iconSrc ? <img src={tool.iconSrc} alt="" loading="lazy" /> : tool.name.slice(0, 2)}</span>
              <strong>{tool.name}</strong><Icon name="arrow-up-right" class="profile-tool__arrow h-3.5 w-3.5" />
            </a>
          ))}
        </div>
      </section>

      <section class="profile-card profile-connect reveal" style="--reveal-delay:70ms" aria-labelledby="connect-title">
        <header class="profile-card__head"><span>04</span><p>FIND ME ONLINE</p></header>
        <div class="profile-connect__intro">
          <h2 id="connect-title">在这些地方，<br /><em>继续相遇。</em></h2>
          <p>分享过程、交换想法，或者只是来打个招呼。邮件我一直看。</p>
        </div>
        <div class="profile-socials">
          {socialCards.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer" class="profile-social">
              <span>{social.number}</span>
              <span class="profile-social__icon">{social.iconSrc ? <img src={withBase(social.iconSrc)} alt="" loading="lazy" /> : '?'}</span>
              <strong>{social.name}</strong><Icon name="arrow-up-right" class="h-3.5 w-3.5" />
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer class="profile-signoff reveal">
      <span>THANKS FOR STOPPING BY</span>
      <strong>保持好奇，保持浪漫，继续创造。</strong>
      <span>BAD0RANG3'S STUDIO · {year}</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .profile-page {
    --paper: color-mix(in srgb, var(--fx-surface-strong) 94%, transparent);
    --paper-soft: color-mix(in srgb, var(--fx-surface) 88%, transparent);
    --ink: var(--fx-text); --muted: var(--fx-muted); --faint: var(--fx-faint);
    --line: var(--fx-line); --pink: var(--fx-pink);
    padding-block: 1.5rem 6rem;
  }

  .profile-hero {
    position: relative; display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, .65fr);
    gap: clamp(2rem, 6vw, 5rem); overflow: hidden;
    border: 1px solid var(--line); border-radius: 1.7rem;
    padding: clamp(5.25rem, 8vw, 7rem) clamp(1.35rem, 5vw, 4.5rem) clamp(1.35rem, 3vw, 2.25rem);
    background:
      linear-gradient(90deg, transparent 49.8%, color-mix(in srgb, var(--line) 65%, transparent) 50%, transparent 50.2%),
      radial-gradient(circle at 79% 38%, color-mix(in srgb, var(--pink) 13%, transparent), transparent 26%), var(--paper);
    box-shadow: 10px 10px 0 color-mix(in srgb, var(--pink) 16%, transparent), 0 35px 80px -52px var(--fx-shadow);
  }

  .profile-hero::after {
    position: absolute; right: -2.5rem; bottom: -5rem;
    color: color-mix(in srgb, var(--pink) 8%, transparent); content: 'ABOUT';
    font-size: clamp(7rem, 18vw, 14rem); font-weight: 950; letter-spacing: -.1em; line-height: 1; pointer-events: none;
  }

  .profile-hero__ruler {
    position: absolute; inset: 0 0 auto; z-index: 1; display: flex; justify-content: space-between;
    border-bottom: 1px dashed var(--line); padding: .95rem clamp(1.35rem, 3vw, 2.25rem);
    color: var(--faint); font-size: .58rem; font-weight: 800; letter-spacing: .15em;
  }

  .profile-hero__copy { position: relative; z-index: 1; align-self: center; min-width: 0; }
  .profile-eyebrow { display: flex; align-items: center; gap: .65rem; margin: 0; color: var(--pink); font-size: .68rem; font-weight: 850; letter-spacing: .12em; }
  .profile-eyebrow i { width: 2rem; height: 1px; background: currentColor; }
  .profile-hero h1 { margin: 1.1rem 0 0; line-height: .87; }
  .profile-hero h1 span { display: block; color: var(--muted); font-size: clamp(1rem, 2vw, 1.35rem); font-weight: 750; letter-spacing: .02em; }
  .profile-hero h1 strong { display: block; margin-top: .5rem; color: var(--ink); font-size: clamp(3.25rem, 8vw, 6.7rem); font-weight: 950; letter-spacing: -.09em; }
  .profile-hero h1 em { color: var(--pink); font-style: normal; }
  .profile-intro { max-width: 42rem; margin: 1.6rem 0 0; color: var(--muted); font-size: clamp(.86rem, 1.4vw, 1rem); line-height: 2; }

  .profile-actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.65rem; }
  .profile-action {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 2.85rem;
    border: 1px solid var(--line); border-radius: 999px; padding: .7rem 1.15rem;
    background: color-mix(in srgb, var(--paper) 72%, transparent); color: var(--ink); font-size: .75rem; font-weight: 850;
    transition: transform .25s var(--ease), border-color .25s ease;
  }
  .profile-action:hover, .profile-action:focus-visible { border-color: var(--pink); transform: translateY(-3px); }
  .profile-action--primary { border-color: transparent; background: var(--pink); color: #251018; box-shadow: 0 14px 28px -18px var(--pink); }

  .profile-photo {
    position: relative; z-index: 1; align-self: center; rotate: 2.2deg;
    border: 1px solid color-mix(in srgb, var(--pink) 40%, var(--line)); padding: .75rem .75rem 1rem; background: var(--paper);
    box-shadow: .8rem 1rem 0 color-mix(in srgb, var(--pink) 12%, transparent), 0 28px 50px -35px var(--fx-shadow);
  }
  .profile-photo__tape {
    position: absolute; z-index: 3; top: -1rem; left: 50%; width: 5.4rem; height: 1.8rem;
    translate: -50%; rotate: -3deg; background: color-mix(in srgb, var(--fx-pink-soft) 45%, transparent); opacity: .72;
    clip-path: polygon(4% 4%, 96% 0, 100% 92%, 2% 100%);
  }
  .profile-photo__image { position: relative; display: grid; aspect-ratio: 1; overflow: hidden; place-items: center; background: color-mix(in srgb, var(--pink) 9%, var(--fx-bg)); }
  .profile-photo__image::after { position: absolute; inset: 0; border: 1px solid color-mix(in srgb, white 12%, transparent); content: ''; }
  .profile-photo__image img { position: relative; z-index: 1; width: 92%; height: 92%; object-fit: contain; filter: drop-shadow(0 1rem 1rem color-mix(in srgb, var(--fx-shadow) 80%, transparent)); }
  .profile-photo__ghost { position: absolute; top: .2rem; left: -.25rem; color: color-mix(in srgb, var(--pink) 22%, transparent); font-size: clamp(4rem, 8vw, 6.2rem); font-weight: 950; letter-spacing: -.12em; line-height: .85; }
  .profile-photo__caption { display: flex; align-items: end; justify-content: space-between; gap: .75rem; padding: .8rem .15rem 0; }
  .profile-photo__caption div { display: grid; gap: .15rem; }
  .profile-photo__caption strong { color: var(--ink); font-size: .78rem; }
  .profile-photo__caption span { color: var(--faint); font-size: .52rem; letter-spacing: .04em; }
  .profile-photo__status { display: flex; align-items: center; gap: .35rem; }
  .profile-photo__status i, .profile-live { width: .42rem; height: .42rem; border-radius: 50%; background: var(--pink); box-shadow: 0 0 0 .2rem color-mix(in srgb, var(--pink) 14%, transparent); animation: profile-pulse 2.5s ease-in-out infinite; }
  .profile-photo__scribble { position: absolute; right: -.4rem; bottom: -1.65rem; color: var(--pink); font-family: cursive; font-size: .78rem; rotate: -5deg; }

  .profile-stats { position: relative; z-index: 1; grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); margin: 2.2rem 0 0; border-top: 1px dashed var(--line); }
  .profile-stats > div { display: flex; align-items: end; gap: .65rem; border-left: 1px dashed var(--line); padding: 1.35rem 1rem .1rem; }
  .profile-stats > div:first-child { border-left: 0; padding-left: 0; }
  .profile-stats dt { color: var(--ink); font-size: clamp(1.55rem, 3vw, 2.2rem); font-weight: 950; letter-spacing: -.08em; line-height: 1; }
  .profile-stats dd { display: grid; gap: .15rem; margin: 0; color: var(--muted); font-size: .64rem; font-weight: 800; }
  .profile-stats dd span { color: var(--faint); font-size: .48rem; letter-spacing: .12em; }
  .profile-stats__note dt { color: var(--pink); }

  .profile-notes { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1rem; margin-top: clamp(2.5rem, 6vw, 4.5rem); }
  .profile-card { position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 1.45rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--paper-soft); box-shadow: 0 26px 64px -48px var(--fx-shadow); }
  .profile-card__head { display: flex; align-items: center; gap: .75rem; border-bottom: 1px dashed var(--line); padding-bottom: .8rem; }
  .profile-card__head > span { display: grid; width: 1.75rem; height: 1.75rem; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--pink) 14%, transparent); color: var(--pink); font-size: .57rem; font-weight: 900; }
  .profile-card__head p { margin: 0; color: var(--faint); font-size: .58rem; font-weight: 850; letter-spacing: .16em; }
  .profile-card__head > strong { margin-left: auto; color: var(--faint); font-size: .55rem; letter-spacing: .1em; }
  .profile-live { margin-left: auto; }

  .profile-story { grid-column: span 8; }
  .profile-story__layout { display: grid; grid-template-columns: minmax(15rem, .9fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 3.5rem); padding: clamp(1.5rem, 4vw, 3rem) 0; }
  .profile-story h2, .profile-connect h2 { margin: 0; color: var(--ink); font-size: clamp(1.8rem, 4vw, 3.35rem); font-weight: 900; letter-spacing: -.07em; line-height: 1.15; }
  .profile-story h2 em, .profile-connect h2 em { color: var(--pink); font-style: normal; }
  .profile-story__copy { color: var(--muted); font-size: .82rem; line-height: 1.95; }
  .profile-story__copy p { margin: 0 0 1rem; }
  .profile-story__copy blockquote { margin: 1.35rem 0 0; border-left: 2px solid var(--pink); padding: .2rem 0 .2rem 1rem; color: var(--ink); font-weight: 800; }
  .profile-values { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px dashed var(--line); }
  .profile-values > div { display: grid; gap: .15rem; border-left: 1px dashed var(--line); padding: 1.2rem 1rem 0; }
  .profile-values > div:first-child { border-left: 0; padding-left: 0; }
  .profile-values span { color: var(--pink); font-size: .56rem; font-weight: 850; }
  .profile-values strong { color: var(--ink); font-size: .9rem; }
  .profile-values p { margin: 0; color: var(--faint); font-size: .6rem; line-height: 1.5; }

  .profile-now { grid-column: span 4; }
  .profile-now h2 { margin: 1.4rem 0 1rem; color: var(--ink); font-size: 1.2rem; font-weight: 900; letter-spacing: -.04em; }
  .profile-terminal { overflow: hidden; border: 1px solid color-mix(in srgb, var(--pink) 25%, var(--line)); border-radius: .85rem; background: #151017; color: #f7e9f0; }
  .profile-terminal__bar { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(255 255 255 / 9%); padding: .55rem .7rem; color: #a98c9a; font-size: .52rem; }
  .profile-terminal__bar > span:first-child { display: flex; gap: .25rem; }
  .profile-terminal__bar i { width: .38rem; height: .38rem; border-radius: 50%; background: #6e5662; }
  .profile-terminal__bar i:first-child { background: #ff8fb6; }
  .profile-terminal ol { margin: 0; padding: .75rem 0; list-style: none; }
  .profile-terminal li { display: grid; grid-template-columns: 1.8rem minmax(0, 1fr); min-height: 1.25rem; padding: 0 .65rem; font-size: clamp(.52rem, .9vw, .66rem); line-height: 1.65; }
  .profile-terminal li > span { color: #735d68; user-select: none; }
  .profile-terminal code { overflow-wrap: anywhere; color: #eadce3; white-space: pre-wrap; }
  .profile-now__note { margin: 1rem 0 0; color: var(--faint); font-size: .66rem; line-height: 1.7; }

  .profile-toolbox { grid-column: span 7; }
  .profile-section-title { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding: 1.4rem 0; }
  .profile-section-title h2 { margin: 0; color: var(--ink); font-size: clamp(1.45rem, 3vw, 2.1rem); font-weight: 900; letter-spacing: -.05em; }
  .profile-section-title p { max-width: 19rem; margin: 0; color: var(--faint); font-size: .63rem; line-height: 1.65; }
  .profile-tools { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; }
  .profile-tool { display: grid; grid-template-columns: auto 2rem minmax(0, 1fr) auto; align-items: center; gap: .55rem; min-width: 0; border: 1px solid var(--line); border-radius: .8rem; padding: .62rem .65rem; background: color-mix(in srgb, var(--paper) 65%, transparent); color: var(--ink); transition: transform .22s var(--ease), border-color .22s ease, background .22s ease; }
  .profile-tool:hover, .profile-tool:focus-visible { z-index: 1; border-color: color-mix(in srgb, var(--pink) 55%, var(--line)); background: var(--paper); transform: translateY(-3px); }
  .profile-tool__number { color: var(--faint); font-size: .48rem; }
  .profile-tool__icon { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: .6rem; background: color-mix(in srgb, var(--pink) 10%, transparent); color: var(--pink); font-size: .55rem; font-weight: 900; }
  .profile-tool__icon img { width: 1.15rem; height: 1.15rem; object-fit: contain; }
  .profile-tool strong { min-width: 0; overflow: hidden; font-size: .65rem; text-overflow: ellipsis; white-space: nowrap; }
  .profile-tool__arrow { color: var(--faint); }

  .profile-connect { grid-column: span 5; }
  .profile-connect__intro { padding: 1.4rem 0 1.25rem; }
  .profile-connect__intro p { max-width: 24rem; margin: 1rem 0 0; color: var(--muted); font-size: .7rem; line-height: 1.8; }
  .profile-socials { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px dashed var(--line); }
  .profile-social { display: grid; grid-template-columns: auto 1.65rem minmax(0, 1fr) auto; align-items: center; gap: .55rem; min-width: 0; border-bottom: 1px dashed var(--line); padding: .68rem .45rem; color: var(--ink); transition: color .2s ease, padding .2s var(--ease); }
  .profile-social:nth-child(odd) { border-right: 1px dashed var(--line); padding-left: 0; padding-right: .75rem; }
  .profile-social:nth-child(even) { padding-left: .75rem; }
  .profile-social:hover, .profile-social:focus-visible { color: var(--pink); padding-inline-start: .45rem; }
  .profile-social > span:first-child { color: var(--faint); font-size: .48rem; }
  .profile-social__icon { display: grid; width: 1.65rem; height: 1.65rem; place-items: center; border-radius: .5rem; background: color-mix(in srgb, var(--pink) 10%, transparent); }
  .profile-social__icon img { width: .95rem; height: .95rem; object-fit: contain; opacity: .82; }
  .profile-social strong { min-width: 0; overflow: hidden; font-size: .62rem; text-overflow: ellipsis; white-space: nowrap; }

  .profile-signoff { display: grid; justify-items: center; gap: .85rem; margin-top: clamp(4rem, 8vw, 7rem); text-align: center; }
  .profile-signoff::before { width: 1px; height: 3rem; background: linear-gradient(transparent, var(--pink)); content: ''; }
  .profile-signoff span { color: var(--faint); font-size: .55rem; font-weight: 800; letter-spacing: .16em; }
  .profile-signoff strong { color: var(--ink); font-size: clamp(1.25rem, 3.4vw, 2rem); font-weight: 900; letter-spacing: -.04em; }
  @keyframes profile-pulse { 50% { opacity: .45; box-shadow: 0 0 0 .42rem color-mix(in srgb, var(--pink) 5%, transparent); } }

  @media (max-width: 900px) {
    .profile-hero { grid-template-columns: minmax(0, 1fr) minmax(13rem, .55fr); gap: 1.75rem; }
    .profile-hero h1 strong { font-size: clamp(3rem, 9vw, 5rem); }
