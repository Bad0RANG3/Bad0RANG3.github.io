---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icons.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { siteConfig } from '../config/site';

const { author, about, socials } = siteConfig;

const socialIconFiles: Record<string, string> = {
  GitHub: '/github.svg', X: '/x.svg', Instagram: '/instagram.svg',
  抖音: '/tiktok.svg', Email: '/email.svg', Telegram: '/telegram.svg',
  YouTube: '/youtube.svg', BiliBili: '/bilibili.svg',
};
const socialCards = socials.map(s => ({ ...s, iconSrc: socialIconFiles[s.name] ?? null }));

const skillIconId: Record<string, string> = {
  HTML5: 'html', CSS3: 'css', JavaScript: 'js', TypeScript: 'ts',
  Python: 'py', Java: 'java', Kotlin: 'kotlin', 'C++': 'cpp', 'C#': 'cs',
  C: 'c', Rust: 'rust', Git: 'git', Docker: 'docker', 'Vue.js': 'vue',
  'Tailwind CSS': 'tailwind', Flask: 'flask', 'Spring Boot': 'spring',
  MySQL: 'mysql', PostgreSQL: 'postgres',
  'Arch Linux': 'arch', 'Windows 11': 'windows', 'VS Code': 'vscode',
  Unity: 'unity', 'After Effects': 'ae', Photoshop: 'ps', Figma: 'figma',
  'IDA Pro': '/ida.ico', Wireshark: '/Wireshark.ico',
};
const getIconUrl = (n: string) => {
  const id = skillIconId[n]; if (!id) return null;
  return id.startsWith('/') ? id : `https://skillicons.dev/icons?i=${id}`;
};

const statusLines = about.currentStatus.split('\n');

---

<BaseLayout title="关于" description="了解博主和常用技术栈。">
  <div class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:py-12">

    <!-- ═══ ROW 1: Avatar + Intro — full width ═══ -->
    <section class="reveal card bg-base-100 shadow-sm overflow-hidden">
      <div class="card-body gap-6 p-6 sm:p-8 lg:flex-row lg:items-start">
        <div class="relative shrink-0 mx-auto lg:mx-0">
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-br from-primary/30 to-secondary/30 blur-md"></div>
          <img class="relative h-24 w-24 rounded-2xl object-cover shadow-lg sm:h-32 sm:w-32" src={author.avatar} alt={author.name} width="128" height="128" loading="eager" />
        </div>
        <div class="text-center lg:text-left">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">About</p>
          <h1 class="mt-2 text-3xl font-extrabold sm:text-4xl">{about.greeting}</h1>
          <p class="mt-2 text-lg text-base-content/60">{about.subtitle}</p>
          <p class="mt-3 leading-7 text-base-content/70">{author.intro}</p>
        </div>
      </div>
    </section>

    <!-- ═══ ROW 2: Socials (left) | Status (right) — side by side on desktop ═══ -->
    <div class="grid gap-6 lg:grid-cols-2">
      <section class="reveal card bg-base-100 shadow-sm">
        <div class="card-body p-6 sm:p-8">
          <SectionHeader label="Online" title="社交坐标" />
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            {socialCards.map((s, i) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" style={`--reveal-delay:${i * 45}ms`} class="reveal flex items-center gap-3 rounded-xl p-4 transition-colors hover:bg-base-200 group">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-base-200 transition-transform duration-300 group-hover:scale-110">
                  {s.iconSrc ? <img src={s.iconSrc} alt={s.name} class="h-6 w-6" loading="lazy" /> : <span class="text-xl">?</span>}
                </span>
                <div><p class="font-semibold">{s.name}</p></div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="reveal card bg-base-100 shadow-sm">
        <div class="card-body p-6 sm:p-8">
          <SectionHeader label="Now" title="当前状态" />
          <div class="mockup-code overflow-x-auto">
            {statusLines.map((l, i) => <pre data-prefix={i + 1}><code>{l || ' '}</code></pre>)}
          </div>
        </div>
      </section>
    </div>

    <!-- ═══ ROW 3: Tech Stack (left) | Dev Tools (right) — side by side on desktop ═══ -->
    <div class="grid gap-6 lg:grid-cols-2">
      <section class="reveal card bg-base-100 shadow-sm">
        <div class="card-body p-6 sm:p-8">
          <SectionHeader label="Stack" title="技术栈" />
          <div class="grid gap-3 sm:grid-cols-2">
            {about.techStack.map((t, i) => {
              const u = getIconUrl(t.name);
              return <div style={`--reveal-delay:${i * 40}ms`}><a href={t.url} target="_blank" rel="noopener noreferrer" class="reveal flex items-center gap-3 rounded-xl p-3 transition-colors hover:bg-base-200 group"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-base-200 transition-transform duration-300 group-hover:scale-110">{u ? <img src={u} alt={t.name} class="h-6 w-6" loading="lazy" /> : <span class="text-xs text-base-content/40">?</span>}</span><span class="text-sm font-medium">{t.name}</span></a></div>;
            })}
          </div>
        </div>
      </section>

      <section class="reveal card bg-base-100 shadow-sm">
        <div class="card-body p-6 sm:p-8">
          <SectionHeader label="Tools" title="开发工具" />
          <div class="grid gap-3 sm:grid-cols-2">
            {about.devTools.map((t, i) => {
              const u = getIconUrl(t.name);
              return <div style={`--reveal-delay:${i * 35}ms`}><a href={t.url} target="_blank" rel="noopener noreferrer" class="reveal flex items-center gap-3 rounded-xl p-3 transition-colors hover:bg-base-200 group"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-base-200 transition-transform duration-300 group-hover:scale-110">{u ? <img src={u} alt={t.name} class="h-6 w-6" loading="lazy" /> : <span class="text-xs text-base-content/40">?</span>}</span><span class="text-sm font-medium">{t.name}</span></a></div>;
            })}
          </div>
        </div>
      </section>
    </div>

    <!-- ═══ ROW 4: Interests — full width ═══ -->
    <section class="reveal card bg-base-100 shadow-sm">
      <div class="card-body p-6 sm:p-8">
        <SectionHeader label="Fun" title="兴趣与游戏" />
        <div class="flex flex-wrap gap-3">
          {about.interests.map((x, i) => (
            <span style={`--reveal-delay:${i * 50}ms`} class="reveal badge badge-lg badge-ghost">{x}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ ROW 5: Quotes — full width ═══ -->
    <section class="reveal card bg-base-100 shadow-sm">
      <div class="card-body p-6 sm:p-8">
        <SectionHeader label="Quotes" title="语录" />
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {about.quotes.map((q, i) => (
            <div style={`--reveal-delay:${i * 55}ms`} class="reveal rounded-xl bg-base-200 p-4">
              <p class="text-sm italic leading-7 text-base-content/70">{q}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
