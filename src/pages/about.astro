---
import { withBase } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { projects } from '../config/projects';
import { getPublishedPosts } from '../lib/content';

const { about, author, socials } = siteConfig;
const posts = await getPublishedPosts();
const year = new Date().getFullYear();

const tools = [...about.techStack, ...about.devTools];
const summary = [
  { value: posts.length, label: '篇文章' },
  { value: projects.length, label: '个项目' },
  { value: tools.length, label: '件常用工具' },
];

const values = [
  { title: '探索', text: '对陌生事物保持好奇。' },
  { title: '构建', text: '把灵感做成能用的东西。' },
  { title: '分享', text: '记录过程，也分享答案。' },
];
---

<BaseLayout title="关于" description="认识 Bad0RANG3：开发、游戏、折腾软件，也认真收藏生活里的小发现。">
  <div class="about site-frame">
    <header class="about-head">
      <div class="about-head__text">
        <p class="about-kicker">关于</p>
        <h1>Bad0RANG3<span>.</span></h1>
        <p class="about-lede">
          一个喜欢在计算机上折腾的普通菜鸟。这里收着我拆过的软件、写过的代码、玩过的游戏，
          也收着一些不想被时间冲走的小发现。
        </p>
        <p class="about-summary">
          {summary.map((item, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <span><strong>{item.value}</strong>{item.label}</span>
            </>
          ))}
        </p>
      </div>
      <img
        class="about-avatar"
        src={withBase(author.avatar)}
        width="112"
        height="112"
        alt={`${author.name} 的头像`}
        loading="eager"
      />
    </header>

    <section class="about-section" aria-labelledby="about-story">
      <h2 id="about-story" class="about-section__label">简介</h2>
      <div class="about-section__body">
        <div class="about-prose">
          <p>
            比起把工具用完就丢，我更喜欢追着那个「为什么」往下走。拆开、试错、重组，直到它真的在我手里跑起来。
          </p>
          <p>
            这个站点就是那段过程的切片。踩过的坑、跑通的配置、没做完的实验和偶尔冒出来的念头，都值得拥有一个位置。
          </p>
          <p class="about-quote">如果其中某一行恰好帮到了你，它就没白写。</p>
        </div>

        <ul class="about-values">
          {values.map((value) => (
            <li><strong>{value.title}</strong><span>{value.text}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-now">
      <h2 id="about-now" class="about-section__label">现在</h2>
      <div class="about-section__body">
        <pre class="about-code"><code>{about.currentStatus}</code></pre>
        <p class="about-note">把好奇心编译成一些可以被使用的东西。</p>
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-tools">
      <h2 id="about-tools" class="about-section__label">工具</h2>
      <div class="about-section__body">
        <dl class="about-tools">
          <div>
            <dt>技术栈</dt>
            <dd>
              {about.techStack.map((tool) => (
                <a href={tool.url} target="_blank" rel="noopener noreferrer">{tool.name}</a>
              ))}
            </dd>
          </div>
          <div>
            <dt>日常工具</dt>
            <dd>
              {about.devTools.map((tool) => (
                <a href={tool.url} target="_blank" rel="noopener noreferrer">{tool.name}</a>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-contact">
      <h2 id="about-contact" class="about-section__label">联系</h2>
      <div class="about-section__body">
        <p class="about-note">分享过程、交换想法，或者只是来打个招呼。邮件我一直看。</p>
        <ul class="about-contact">
          {socials.map((social) => {
            const external = !social.url.startsWith('mailto:');
            return (
              <li>
                <a
                  href={social.url}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <span>{social.name}</span>
                  <span class="about-contact__arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <footer class="about-foot">
      <span>保持好奇，保持浪漫，继续创造。</span>
      <span>© {year} Bad0RANG3</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .about {
    --ink: var(--fx-text);
    --muted: var(--fx-muted);
    /* --fx-faint is 3.34:1 on the light surface, so quiet *text* uses the
       site's --text-faint instead (4.76:1 light, 5.44:1 dark). */
    --faint: var(--text-faint);
    --line: var(--fx-line);
    --accent: var(--fx-accent);
    max-width: 48rem;
    padding-block: clamp(1.5rem, 4vw, 2.75rem) clamp(3.5rem, 8vw, 6rem);
  }

  /* Links stay plain until hovered: the page is mostly a reading surface, and
     a row of underlines would read as noise. */
  .about a {
    text-decoration-line: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.24em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .about a:hover,
  .about a:focus-visible {
    /* Darkening to ink keeps hover legible in the light theme; the pink is
       left to the underline, which is a non-text graphic. */
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
  }

  .about-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(1.5rem, 5vw, 3.5rem);
  }

  .about-kicker {
    margin: 0;
    color: var(--faint);
    font-size: var(--type-meta);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-label);
  }

  .about-head h1 {
    margin: 0.9rem 0 0;
    color: var(--ink);
    /* Lower floor than the rest of the display type, because "Bad0RANG3." is a
       single unbreakable word: it sets `.about-head__text`'s min-content width,
       which at the old 2.4rem floor was ~226px and pushed the avatar 4px past a
       320px frame. At 2rem the word measures ~188px, leaving the avatar room on
       the same row. Only the narrow end changes — 6vw keeps every wider
       viewport on exactly the size it had. */
    font-size: clamp(2rem, 6vw, 3.4rem);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
  }

  .about-head h1 span {
    color: var(--accent);
  }

  .about-lede {
    max-width: 32rem;
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: var(--leading-prose);
  }

  .about-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.5rem 0 0;
    color: var(--faint);
    font-size: var(--type-meta);
  }

  .about-summary span {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .about-summary strong {
    color: var(--ink);
    font-weight: var(--weight-strong);
    font-variant-numeric: tabular-nums;
  }

  .about-avatar {
    flex: none;
    width: clamp(4.5rem, 12vw, 7rem);
    height: clamp(4.5rem, 12vw, 7rem);
    border: 1px solid var(--line);
    border-radius: 50%;
    object-fit: cover;
  }

  .about-section {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem 2rem;
    margin-top: clamp(2.75rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .about-section__label {
    margin: 0;
    color: var(--faint);
    font-size: var(--type-meta);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-label);
    line-height: 1.6;
  }

  .about-section__body {
    min-width: 0;
  }

  .about-prose p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: var(--type-small);
    line-height: 2;
  }

  .about-prose p:last-child {
    margin-bottom: 0;
  }

  .about-prose .about-quote {
    margin-top: 1.75rem;
    border-left: 2px solid var(--line);
    padding-left: 1.1rem;
    color: var(--ink);
    font-size: var(--type-small);
  }

  .about-values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-values li {
    display: grid;
    gap: 0.3rem;
  }

  .about-values strong {
    color: var(--ink);
    font-size: var(--type-small);
    font-weight: var(--weight-strong);
  }

  .about-values span {
    color: var(--faint);
    font-size: var(--type-meta);
    line-height: 1.7;
  }

  .about-code {
    overflow-x: auto;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 1rem 1.15rem;
    background: color-mix(in srgb, var(--fx-surface-strong) 70%, transparent);
    color: var(--ink);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--type-small);
    line-height: 1.85;
  }

  .about-code code {
    font: inherit;
  }

  .about-note {
    margin: 1rem 0 0;
    color: var(--faint);
    font-size: var(--type-small);
    line-height: 1.8;
  }

  .about-section__body > .about-note:first-child {
    margin-top: 0;
  }

  .about-tools {
    display: grid;
    gap: 1.35rem;
    margin: 0;
  }

  .about-tools div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }

  .about-tools dt {
    color: var(--faint);
    font-size: var(--type-meta);
  }

  .about-tools dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
  }

  .about-tools a {
    color: var(--muted);
    font-size: var(--type-small);
  }

  .about-contact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-contact a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: 0.6rem 0;
    color: var(--muted);
    font-size: var(--type-small);
    text-decoration: none;
  }

  .about-contact__arrow {
    color: var(--faint);
    font-size: var(--type-meta);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .about-contact a:hover,
  .about-contact a:focus-visible {
    color: var(--ink);
    /* The row already has a divider; an underline on top reads as clutter. */
    text-decoration-line: none;
  }

  .about-contact a:hover .about-contact__arrow,
  .about-contact a:focus-visible .about-contact__arrow {
    color: var(--accent);
    transform: translate(0.1rem, -0.1rem);
  }

  .about-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: clamp(3rem, 7vw, 4.5rem);
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    color: var(--faint);
    font-size: var(--type-meta);
  }

  @media (max-width: 640px) {
    .about-section {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .about-values {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .about-tools div {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .about-contact {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .about-head {
      gap: 1rem;
    }
  }

  /* The longest line of the status snippet is wider than a 320px screen, and
     shrinking the type enough to fit would make it unreadable. Wrapping keeps
     it visible without an inner scrollbar. */
  @media (max-width: 380px) {
    .about-code {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about a,
    .about-contact__arrow {
      transition: none;
    }
  }
</style>
