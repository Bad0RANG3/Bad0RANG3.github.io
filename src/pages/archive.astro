---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArchiveGroups } from '../lib/content';
import { formatDate } from '../lib/date';
const groups = await getArchiveGroups();
---
<BaseLayout title="归档" description="按时间浏览博客文章归档。">
  <div class="mx-auto max-w-3xl px-4 py-8 sm:py-12">
    <div class="mb-10 space-y-3">
      <p data-reveal class="reveal text-sm font-semibold uppercase tracking-[0.2em] text-primary">Archive</p>
      <h1 data-reveal class="reveal text-4xl font-extrabold sm:text-5xl" style="--reveal-delay:80ms">时间归档</h1>
      <p data-reveal class="reveal text-base-content/60" style="--reveal-delay:150ms">按年份整理所有已发布文章。</p>
    </div>
    <div class="space-y-8">
      {groups.map((g,gi)=><section data-reveal class="reveal card bg-base-100 shadow-sm" style={`--reveal-delay:${gi*90}ms`}><div class="card-body"><div class="mb-6 flex items-center gap-4"><h2 class="text-2xl font-extrabold">{g.year}</h2><span class="badge badge-primary">{g.posts.length} 篇</span></div><div class="space-y-2">{g.posts.map((p,i)=><a data-reveal href={`/posts/${p.slug}`} style={`--reveal-delay:${80+i*50}ms`} class="reveal flex flex-col gap-2 rounded-xl p-3 transition-colors hover:bg-base-200 sm:flex-row sm:items-center sm:justify-between"><div><h3 class="font-semibold">{p.data.title}</h3><p class="text-sm text-base-content/50">{p.data.description}</p></div><time class="shrink-0 text-sm text-base-content/40">{formatDate(p.data.date)}</time></a>)}</div></div></section>)}
    </div>
  </div>
</BaseLayout>
