---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { getAllTags, getPostsByTag } from '../../lib/content';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(t => ({ params: { tag: t } }));
}

let tag: string;
try {
  tag = decodeURIComponent(Astro.params.tag ?? '');
} catch {
  return Astro.redirect('/404');
}

const posts = await getPostsByTag(tag);
---

<BaseLayout title={`标签：${tag}`} description={`查看与 ${tag} 相关的文章。`}>
  <div class="site-frame py-5 sm:py-8">
    <PageHeader
      label="Tag archive"
      title={`#${tag}`}
    />
    {posts.length === 0 ? (
      <EmptyState message="暂无文章" />
    ) : (
      <div class="grid gap-5 sm:gap-6 md:grid-cols-2 xl:grid-cols-3">
        {posts.map((p, i) => (
          <div style={`--reveal-delay:${i * 70}ms`}><PostCard post={p} /></div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
