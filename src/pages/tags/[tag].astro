---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getAllTags, getPostsByTag } from '../../lib/content';
export async function getStaticPaths() { const tags = await getAllTags(); return tags.map(t => ({ params: { tag: t } })); }
const tag = decodeURIComponent(Astro.params.tag ?? '');
const posts = await getPostsByTag(tag);
---
<BaseLayout title={`标签：${tag}`} description={`查看与 ${tag} 相关的文章。`}>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
    <div class="mb-10 space-y-3">
      <p class="reveal text-sm font-semibold uppercase tracking-[0.2em] text-primary">Tag archive</p>
      <h1 class="reveal text-4xl font-extrabold sm:text-5xl" style="--reveal-delay:80ms"><span class="text-primary">#</span>{tag}</h1>
      <p class="reveal text-base-content/60" style="--reveal-delay:150ms">共 <span class="font-semibold text-primary">{posts.length}</span> 篇</p>
    </div>
    {posts.length===0 ? <div class="card bg-base-100 shadow-sm"><div class="card-body items-center text-base-content/50">暂无文章</div></div> : <div class="grid gap-5 sm:gap-6 md:grid-cols-2 xl:grid-cols-3">{posts.map((p,i)=><div style={`--reveal-delay:${i*70}ms`}><PostCard post={p}/></div>)}</div>}
  </div>
</BaseLayout>
