---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import ContentCard from '../../components/ui/ContentCard.astro';
import { getTagGroups } from '../../lib/content';
import { formatDate } from '../../lib/date';

const groups = await getTagGroups();
---

<BaseLayout title="标签" description="按主题浏览文章。">
  <div class="site-frame py-5 sm:py-8">
    <PageHeader label="Tags" title="标签" description="按主题浏览文章。" />
    {groups.length === 0 ? <EmptyState message="还没有标签。" /> : (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {groups.map((group, index) => (
          <div style={`--reveal-delay:${index * 45}ms`}>
            <ContentCard
              href={`/tags/${encodeURIComponent(group.name)}/`}
              title={`#${group.name}`}
              description={group.posts[0].data.title}
              meta={`${group.posts.length} 篇 · 更新 ${formatDate(group.posts[0].data.updatedDate ?? group.posts[0].data.date)}`}
              headingTag="h2"
            />
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
