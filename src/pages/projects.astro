---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/profile/ProjectCard.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { projects } from '../config/projects';
---

<BaseLayout title="项目" description="工具、实验和持续维护的项目记录。">
  <div class="site-frame py-5 sm:py-8">
    <PageHeader
      label="Projects"
      title="项目"
      description="工具、实验和持续维护的项目记录。"
    />

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((project, index) => (
        <div class="min-w-0" style={`--reveal-delay:${index * 60}ms`}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
