---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/profile/ProjectCard.astro';
import { projects } from '../config/projects';
import { siteConfig } from '../config/site';

const types = [...new Set(projects.map((project) => project.type))];
const statuses = [...new Set(projects.map((project) => project.status))];
const tags = [...new Set(projects.flatMap((project) => project.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout title={`项目 · ${siteConfig.title}`} description="Bad0RANG3 的项目、工具和实验作品。可按类型、状态和技术标签筛选。">
  <div class="site-frame py-8 sm:py-12">
    <header class="reveal mb-8 max-w-3xl">
      <h1 class="display-title mt-3 text-4xl sm:text-6xl">我正在做什么</h1>
      <p class="mt-5 text-base leading-8 text-base-content/65 sm:text-lg">这里放我的工具、实验和长期项目。不一定都很大，但都是真在用的东西。</p>
    </header>

    <section class="reveal mb-8 rounded-[1.5rem] border-2 border-base-content/10 bg-base-100/80 p-4 sm:p-5" aria-labelledby="project-filter-title" data-project-filters>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h2 id="project-filter-title" class="mt-1 text-lg font-black">筛选项目</h2>
        </div>
        <p class="text-sm text-base-content/55" aria-live="polite" data-project-filter-result>{projects.length} 个项目</p>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <label class="form-control gap-1.5 text-sm font-bold">
          <span class="text-base-content/65">类型</span>
          <select class="select select-bordered w-full border-2 border-base-content/15 bg-base-100" data-project-filter="type">
            <option value="">全部类型</option>
            {types.map((type) => <option value={type}>{type}</option>)}
          </select>
        </label>
        <label class="form-control gap-1.5 text-sm font-bold">
          <span class="text-base-content/65">状态</span>
          <select class="select select-bordered w-full border-2 border-base-content/15 bg-base-100" data-project-filter="status">
            <option value="">全部状态</option>
            {statuses.map((status) => <option value={status}>{status}</option>)}
          </select>
        </label>
        <label class="form-control gap-1.5 text-sm font-bold">
          <span class="text-base-content/65">技术 / 标签</span>
          <select class="select select-bordered w-full border-2 border-base-content/15 bg-base-100" data-project-filter="tag">
            <option value="">全部标签</option>
            {tags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
        </label>
      </div>
      <button type="button" class="btn btn-sm btn-ghost mt-4 border-2 border-base-content/15 font-bold" data-project-filter-reset hidden>清除筛选</button>
    </section>

    <p class="mb-5 hidden rounded-xl border-2 border-dashed border-base-content/15 p-5 text-sm leading-6 text-base-content/60" data-project-empty>没有符合当前条件的项目。请调整筛选条件。</p>
    <div class="grid gap-5 md:grid-cols-2" data-project-grid>
      {projects.map((project, index) => (
        <div class="reveal" style={`--reveal-delay:${index * 60}ms`}>
          <ProjectCard project={project} featured={project.featured} />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const filters = document.querySelector('[data-project-filters]');
    if (!(filters instanceof HTMLElement) || filters.dataset.bound === '1') return;
    filters.dataset.bound = '1';

    const type = filters.querySelector('[data-project-filter="type"]');
    const status = filters.querySelector('[data-project-filter="status"]');
    const tag = filters.querySelector('[data-project-filter="tag"]');
    const reset = filters.querySelector('[data-project-filter-reset]');
    const result = filters.querySelector('[data-project-filter-result]');
    const empty = document.querySelector('[data-project-empty]');
    const cards = [...document.querySelectorAll('[data-project-card]')];

    const apply = () => {
      const values = {
        type: type instanceof HTMLSelectElement ? type.value : '',
        status: status instanceof HTMLSelectElement ? status.value : '',
        tag: tag instanceof HTMLSelectElement ? tag.value : '',
      };
      let count = 0;
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const matches = (!values.type || card.dataset.projectType === values.type)
          && (!values.status || card.dataset.projectStatus === values.status)
          && (!values.tag || (card.dataset.projectTags || '').split('|').includes(values.tag));
        const container = card.parentElement;
        if (container instanceof HTMLElement) container.hidden = !matches;
        else card.hidden = !matches;
        if (matches) count += 1;
      });
      if (result) result.textContent = `${count} 个项目`;
      if (empty instanceof HTMLElement) empty.hidden = count !== 0;
      if (reset instanceof HTMLButtonElement) reset.hidden = !Object.values(values).some(Boolean);
    };

    [type, status, tag].forEach((control) => control?.addEventListener('change', apply));
    reset?.addEventListener('click', () => {
      [type, status, tag].forEach((control) => { if (control instanceof HTMLSelectElement) control.value = ''; });
      apply();
    });
  })();
</script>
