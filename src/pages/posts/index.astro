---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { getPublishedPosts } from '../../lib/content';
import { STAGGER } from '../../constants';

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description="全部文章列表。">
  <div class="site-frame py-5 sm:py-8">
    <PageHeader
      label="文章"
      title="文章"
    />

    {posts.length === 0 ? (
      <EmptyState message="还没有文章哦" />
    ) : (
      <div class="grid gap-4 sm:gap-5 md:grid-cols-2 xl:grid-cols-3">
        {posts.map((post, i) => (
          <div style={`--reveal-delay:${STAGGER.LIST_START + i * STAGGER.LIST_STEP}ms`}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
