---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description="浏览博客中的全部文章。">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
    <PageHeader label="Posts" title="全部文章" description={`共发布 ${posts.length} 篇文章`} />

    {posts.length === 0 ? (
      <EmptyState message="还没有文章哦" />
    ) : (
      <div class="grid gap-5 sm:gap-6 md:grid-cols-2 xl:grid-cols-3">
        {posts.map((p, i) => (
          <div style={`--reveal-delay:${i * 70}ms`}><PostCard post={p} /></div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
