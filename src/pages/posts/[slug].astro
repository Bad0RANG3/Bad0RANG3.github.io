---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/blog/PostMeta.astro';
import TagList from '../../components/blog/TagList.astro';
import Comments from '../../components/Comments.astro';
import Icon from '../../components/icons/Icons.astro';
import { getPublishedPosts } from '../../lib/content';
import { STAGGER } from '../../constants';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const isResourceList = post.data.category === '资源清单';
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.cover}
  type="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
>
  <article class:list={['mx-auto px-4 py-8 sm:py-12', isResourceList ? 'max-w-5xl' : 'max-w-3xl']}>
    <header class="mb-10 text-center">
      <div class="reveal mb-5 flex flex-wrap items-center justify-center gap-2">
        {post.data.featured && <span class="badge badge-primary badge-sm gap-1"><Icon name="star" class="h-3 w-3" />精选</span>}
        {post.data.category && <span class="badge badge-ghost badge-sm">{post.data.category}</span>}
      </div>
      <h1 class="reveal mb-5 text-3xl font-extrabold leading-tight sm:text-4xl md:text-5xl" style={`--reveal-delay:${STAGGER.POST_HEADING}ms`}>{post.data.title}</h1>
      <p class="reveal mx-auto mb-5 max-w-2xl text-base-content/60" style={`--reveal-delay:${STAGGER.SUBTITLE}ms`}>{post.data.description}</p>
      <div class="space-y-4">
        <div class="reveal" style={`--reveal-delay:${STAGGER.POST_META}ms`}><PostMeta date={post.data.date} updatedDate={post.data.updatedDate} centered long /></div>
        <div class="reveal flex justify-center" style={`--reveal-delay:${STAGGER.POST_TAGS}ms`}><TagList tags={post.data.tags} /></div>
      </div>
    </header>

    {isResourceList && (
      <div class="reveal card bg-base-100 shadow-sm mb-8" style={`--reveal-delay:${STAGGER.POST_GUIDE}ms`}>
        <div class="card-body gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Guide</p>
            <h2 class="mt-2 text-lg font-bold">这篇文章怎么读更省时间</h2>
            <p class="mt-2 max-w-3xl text-sm leading-7 text-base-content/60">这是一篇偏"资源导航"型长文，推荐先看上方的快速入口，再按自己的场景跳到对应分区。</p>
          </div>
          <div class="shrink-0 rounded-2xl bg-primary/10 px-4 py-3 text-sm text-primary">建议桌面端阅读，表格更完整。</div>
        </div>
      </div>
    )}

    {post.data.cover && (
      <img src={post.data.cover} alt={post.data.title} class="reveal mb-10 w-full rounded-2xl object-cover shadow-lg" style={`--reveal-delay:${STAGGER.POST_COVER}ms`} loading="lazy" />
    )}

    <div class:list={['reveal prose max-w-none', isResourceList && 'prose-resource-list']} style={`--reveal-delay:${STAGGER.POST_CONTENT}ms`}>
      <Content />
    </div>

    <!-- Comments -->
    <div class="max-w-3xl mx-auto"><Comments /></div>
  </article>
</BaseLayout>
