---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Icon from '../components/icons/Icons.astro';
import { getThoughts } from '../lib/thoughts';
import { formatDate } from '../lib/date';

const thoughts = await getThoughts();
const rendered = await Promise.all(thoughts.map(async t => {
  const { Content } = await t.render();
  return { ...t, Content };
}));
---

<BaseLayout title="碎碎念" description="随手记录的想法、吐槽和日常。">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
    <PageHeader label="Thoughts" title="碎碎念" description={`随手记录的想法、吐槽和日常。${thoughts.length} 条。`} />

    {rendered.length === 0 ? (
      <EmptyState message="还没有碎碎念哦" />
    ) : (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {rendered.map((t, i) => (
          <div class="reveal card bg-base-100 shadow-sm" style={`--reveal-delay:${i * 60}ms`}>
            <div class="card-body gap-3 p-5 sm:p-6">
              <div class="flex items-center gap-3 text-sm text-base-content/40">
                <Icon name="calendar" class="h-4 w-4" />
                <time datetime={t.data.date.toISOString()}>{formatDate(t.data.date)}</time>
              </div>
              <div class="prose max-w-none text-base-content/80 text-sm"><t.Content /></div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
