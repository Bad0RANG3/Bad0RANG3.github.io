---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { getThoughts } from '../lib/thoughts';
import { formatDate } from '../lib/date';

const thoughts = await getThoughts();
const rendered = await Promise.all(
  thoughts.map(async (t) => ({
    ...t,
    Content: (await t.render()).Content,
  }))
);
---

<BaseLayout title="碎碎念" description="随手记录的想法、吐槽和日常。">
  <div class="site-frame py-5 sm:py-8">
    <PageHeader label="Thoughts" title="碎碎念" />

    {rendered.length === 0 ? (
      <EmptyState message="还没有碎碎念哦" />
    ) : (
      <div class="mx-auto grid max-w-3xl gap-4">
        {rendered.map((t, i) => (
          <article
            class:list={[
              'reveal rounded-[1.5rem] border-2 border-base-content/10 bg-base-100/80 p-5 transition-all hover:-translate-y-0.5',
              i % 2 === 0 ? 'shadow-[6px_6px_0_0] shadow-primary/35' : 'shadow-[6px_6px_0_0] shadow-accent/35',
            ]}
            style={`--reveal-delay:${i * 100}ms`}
          >
            <time class="font-mono text-sm font-medium tabular-nums text-base-content/35" datetime={t.data.date.toISOString()}>
              {formatDate(t.data.date)}
            </time>
            <div class="mt-3 text-base leading-7 text-base-content/75">
              <t.Content />
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
