---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { getThoughts } from '../lib/thoughts';
import { formatDate } from '../lib/date';

const thoughts = await getThoughts();
const rendered = await Promise.all(thoughts.map(async t => {
  const { Content } = await t.render();
  return { ...t, Content };
}));
---

<BaseLayout title="碎碎念" description="随手记录的想法、吐槽和日常。">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
    <PageHeader label="Thoughts" title="碎碎念" description={`随手记录的想法、吐槽和日常。${thoughts.length} 条。`} />

    {rendered.length === 0 ? (
      <EmptyState message="还没有碎碎念哦" />
    ) : (
      <div class="mx-auto max-w-2xl grid gap-3">
        {rendered.map((t, i) => (
          <article class="reveal card bg-base-100 shadow-sm rounded-2xl p-5 hover:shadow-md transition-all duration-300" style={`--reveal-delay:${i * 100}ms`}>
            <time class="text-sm font-medium text-base-content/25 tabular-nums" datetime={t.data.date.toISOString()}>
              {formatDate(t.data.date)}
            </time>
            <div class="mt-3 text-base text-base-content/75 leading-7">
              <t.Content />
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
