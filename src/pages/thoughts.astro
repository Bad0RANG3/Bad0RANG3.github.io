---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { thoughtAnchor } from '../config/routes';
import { getThoughts } from '../lib/content';
import { formatDate } from '../lib/date';

const thoughts = await getThoughts();
const rendered = await Promise.all(
  thoughts.map(async (t) => ({
    ...t,
    Content: (await t.render()).Content,
  }))
);
---

<BaseLayout title="碎碎念" description="随手记录的想法、吐槽和日常。">
  <div class="site-frame page-shell">
    <PageHeader label="Thoughts" title="碎碎念" />

    {rendered.length === 0 ? (
      <EmptyState message="还没有碎碎念哦" />
    ) : (
      <div class="mx-auto grid max-w-3xl gap-4">
        {rendered.map((t, i) => (
          <article
            id={thoughtAnchor(t.slug)}
            class="thought-entry reveal scroll-mt-24"
            style={`--reveal-delay:${i * 100}ms`}
          >
            <time class="font-mono text-sm font-medium tabular-nums text-base-content/70" datetime={t.data.date.toISOString()}>
              {formatDate(t.data.date)}
            </time>
            <div class="prose mt-3 max-w-none">
              <t.Content />
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
