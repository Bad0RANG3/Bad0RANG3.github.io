---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import ContentCard from '../../components/ui/ContentCard.astro';
import { getPostReadingMinutes, getSeriesGroups, type Post } from '../../lib/content';

const groups = await getSeriesGroups();
const totalMinutes = (posts: Post[]) => posts.reduce((sum, post) => sum + getPostReadingMinutes(post), 0);
---

<BaseLayout title="系列" description="按顺序阅读同一主题的文章。">
  <div class="site-frame py-5 sm:py-8">
    <PageHeader label="Series" title="文章系列" description="按顺序阅读同一主题的文章。" />
    {groups.length === 0 ? <EmptyState message="还没有系列文章。" /> : (
      <div class="grid gap-5 md:grid-cols-2">
        {groups.map((group, index) => {
          const minutes = totalMinutes(group.posts);
          const firstPost = group.posts[0];
          return (
            <div style={`--reveal-delay:${index * 60}ms`}>
              <ContentCard
                href={`/series/${encodeURIComponent(group.name)}/`}
                title={group.name}
                description={`从《${firstPost.data.title}》开始，按顺序读完这个主题。`}
                meta={`${group.posts.length} 篇 · 约 ${minutes} 分钟阅读`}
                tone="teal"
                headingTag="h2"
              />
            </div>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
