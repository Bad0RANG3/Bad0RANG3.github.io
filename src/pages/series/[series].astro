---
import { withBase } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { getPostReadingMinutes, getSeriesGroups } from '../../lib/content';
import { formatDate } from '../../lib/date';

export async function getStaticPaths() {
  const groups = await getSeriesGroups();
  return groups.map((group) => ({ params: { series: group.name }, props: { group } }));
}

const { group } = Astro.props;
const totalMinutes = group.posts.reduce((sum, post) => sum + getPostReadingMinutes(post), 0);
const firstPost = group.posts[0];
const difficultyLevels = [...new Set(group.posts.map((post) => post.data.difficulty).filter(Boolean))];
---
<BaseLayout title={`系列：${group.name}`} description={`按顺序阅读《${group.name}》系列文章。`}>
  <div class="site-frame py-5 sm:py-8">
    <PageHeader label="Series archive" title={group.name} description={`${group.posts.length} 篇文章，按系列顺序排列。`} />

    {group.posts.length === 0 ? <EmptyState message="这个系列还没有文章" /> : (
      <>
        <section class="reveal hard-card hard-card-citrus mx-auto mb-8 max-w-3xl rounded-[1.75rem] p-6 sm:p-8">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">Reading route</p>
              <h2 class="mt-2 text-2xl font-black">一条完整的阅读路径</h2>
            </div>
            <a href={withBase(`/posts/${firstPost.slug}/`)} class="brutal-button brutal-button-primary">从第一篇开始 →</a>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border-2 border-base-content/10 bg-base-100/70 p-4"><span class="eyebrow">Articles</span><strong class="mt-1 block text-2xl font-black">{group.posts.length}</strong></div>
            <div class="rounded-2xl border-2 border-base-content/10 bg-base-100/70 p-4"><span class="eyebrow">Reading time</span><strong class="mt-1 block text-2xl font-black">约 {totalMinutes} 分钟</strong></div>
            <div class="rounded-2xl border-2 border-base-content/10 bg-base-100/70 p-4"><span class="eyebrow">Difficulty</span><strong class="mt-1 block text-lg font-black">{difficultyLevels.length > 0 ? difficultyLevels.join(' / ') : '自由阅读'}</strong></div>
          </div>
          <div class="mt-6" aria-label={`系列进度，共 ${group.posts.length} 篇`}>
            <div class="mb-2 flex items-center justify-between text-xs font-black uppercase tracking-[0.14em] text-base-content/45"><span>Series progress</span><span>0 / {group.posts.length}</span></div>
            <div class="h-3 overflow-hidden rounded-full border-2 border-base-content/15 bg-base-100/70"><div class="h-full w-0 rounded-full bg-primary"></div></div>
          </div>
        </section>

        <ol class="mx-auto max-w-3xl space-y-4">
          {group.posts.map((post, index) => (
            <li class="reveal" style={`--reveal-delay:${index * 65}ms`}>
              <a href={withBase(`/posts/${post.slug}/`)} class="group flex gap-4 rounded-[1.5rem] border-2 border-base-content/10 bg-base-100/80 p-5 transition hover:-translate-x-1 hover:border-primary/40 sm:gap-6 sm:p-6">
                <span class="font-mono text-2xl font-black text-primary">{String(post.data.seriesOrder ?? index + 1).padStart(2, '0')}</span>
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-2">
                    <span class="text-lg font-black transition group-hover:text-primary">{post.data.title}</span>
                    {index === 0 && <span class="chip-signal">起点</span>}
                  </span>
                  <span class="mt-2 block text-sm leading-6 text-base-content/55">{post.data.description}</span>
                  <span class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-bold text-base-content/40">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    <span>约 {getPostReadingMinutes(post)} 分钟</span>
                    {post.data.difficulty && <span>{post.data.difficulty}</span>}
                    {post.data.hasCode && <span>源码</span>}
                    {post.data.hasDownload && <span>下载</span>}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </>
    )}
  </div>
</BaseLayout>
