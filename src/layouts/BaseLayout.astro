---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';
import { siteConfig } from '../config/site';
import { ANIMATION, LAYOUT, SITE, ROUTES } from '../constants';
import { siteUrl, withBase } from '../lib/urls';

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  canonical?: string;
  noindex?: boolean;
  lang?: string;
  articleSection?: string;
  keywords?: string[];
  breadcrumbs?: Breadcrumb[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  ogImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  canonical,
  noindex = false,
  lang = SITE.LANG,
  articleSection,
  keywords = [],
  breadcrumbs,
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const siteRootUrl = siteUrl('/');
const canonicalUrl = canonical ? siteUrl(canonical) : siteUrl(currentPath);
const socialImageUrl = siteUrl(ogImage);
const authorImageUrl = siteUrl(siteConfig.author.avatar);
const pageExitDuration = ANIMATION.PAGE_EXIT_DURATION;
const backToTopThreshold = LAYOUT.BACK_TO_TOP_THRESHOLD;
const pageBreadcrumbs = breadcrumbs ?? [
  { name: '首页', path: '/' },
  ...(currentPath === withBase('/') ? [] : [{ name: title, path: currentPath }]),
];

const personJsonLd = {
  '@type': 'Person',
  '@id': `${siteRootUrl}#person`,
  name: siteConfig.author.name,
  url: siteRootUrl,
  image: authorImageUrl,
};
const websiteJsonLd = {
  '@type': 'WebSite',
  '@id': `${siteRootUrl}#website`,
  name: siteConfig.title,
  description: siteConfig.description,
  url: siteRootUrl,
  inLanguage: SITE.LANG,
  publisher: { '@id': `${siteRootUrl}#person` },
};
const webpageJsonLd = {
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageTitle,
  description,
  inLanguage: lang,
  isPartOf: { '@id': `${siteRootUrl}#website` },
  primaryImageOfPage: { '@type': 'ImageObject', url: socialImageUrl, caption: ogImageAlt ?? title },
};
const breadcrumbJsonLd = pageBreadcrumbs.length > 1 ? {
  '@type': 'BreadcrumbList',
  itemListElement: pageBreadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: siteUrl(crumb.path),
  })),
} : undefined;
const articleJsonLd = type === 'article' ? {
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: title,
  description,
  image: { '@type': 'ImageObject', url: socialImageUrl, caption: ogImageAlt ?? title },
  url: canonicalUrl,
  inLanguage: lang,
  datePublished: publishedTime,
  dateModified: modifiedTime || publishedTime,
  author: { '@id': `${siteRootUrl}#person` },
  publisher: { '@id': `${siteRootUrl}#person` },
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
  ...(articleSection ? { articleSection } : {}),
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
} : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personJsonLd, websiteJsonLd, webpageJsonLd, ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []), ...(articleJsonLd ? [articleJsonLd] : [])],
};
---

<!doctype html>
<html lang={lang} data-theme={SITE.THEME} data-theme-ready="false">
<head>


  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content={siteConfig.author.name}>
  <meta name="theme-color" id="meta-theme-color" content={SITE.THEME_COLOR}>
  <meta name="color-scheme" content="light dark">
  <script is:inline define:vars={{ themeStorageKey: SITE.THEME_STORAGE_KEY, themeLight: SITE.THEME, themeDark: 'paper-dark', themeColorLight: SITE.THEME_COLOR, themeColorDark: SITE.THEME_COLOR_DARK }}>
    // @ts-nocheck
    (function () {
      try {
        var key = themeStorageKey;
        var stored = localStorage.getItem(key);
        var theme = stored === 'paper-dark' || stored === 'paper'
          ? stored
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? themeDark : themeLight);
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme === themeDark ? 'dark' : 'light';
        var meta = document.getElementById('meta-theme-color') || document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === themeDark ? themeColorDark : themeColorLight);
      } catch (e) {}
      document.documentElement.setAttribute('data-theme-ready', 'true');
    })();
  </script>
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"}>

  <link rel="canonical" href={canonicalUrl}>
  <link rel="manifest" href={withBase('/manifest.webmanifest')}>
  <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href={withBase(ROUTES.RSS)}>
  <link rel="alternate" type="application/atom+xml" title={`${siteConfig.title} Atom`} href={withBase('/atom.xml')}>
  <link rel="alternate" type="application/feed+json" title={`${siteConfig.title} JSON Feed`} href={withBase('/feed.json')}>
  <link rel="icon" href={withBase('/ico.ico')} type="image/x-icon">

  <!-- Open Graph -->
  <meta property="og:type" content={type}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={socialImageUrl}>
  <meta property="og:image:alt" content={ogImageAlt ?? title}>
  <meta property="og:site_name" content={siteConfig.title}>
  <meta property="og:locale" content={SITE.LOCALE}>
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
  {articleSection && <meta property="article:section" content={articleSection}>}
  {keywords.map((keyword) => <meta property="article:tag" content={keyword}>)}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={socialImageUrl}>
  <meta name="twitter:image:alt" content={ogImageAlt ?? title}>
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')}>}

  <!-- JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</head>

<body class="flex flex-col min-h-screen bg-base-100 text-base-content overflow-x-hidden">
  <SiteHeader currentPath={currentPath} />
  <main id="main-content" class="page-enter w-full flex-1">
    <slot />
  </main>
  <SiteFooter />
  <SearchModal />

  <!-- Back to top -->
  <button id="back-to-top" class="fixed bottom-6 right-6 z-50 btn btn-circle btn-primary border-2 border-base-content shadow-[4px_4px_0_0] shadow-base-content" aria-label="回到顶部" title="回到顶部">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 15l-6-6-6 6"/></svg>
  </button>

  <script is:inline define:vars={{ pageExitDuration, backToTopThreshold }}>
    // @ts-nocheck
    /* ── Page transition + back-to-top + table wrapping ── */
    (function(){
      const PAGE_EXIT_DURATION = pageExitDuration;
      const BACK_TO_TOP_THRESHOLD = backToTopThreshold;
      let navigationLocked = false;

      const getPageRoot = () => {
        const el = document.querySelector('.page-enter');
        return el instanceof HTMLElement ? el : null;
      };

      const triggerPageEnter = () => {
        const root = getPageRoot();
        if (!root) return;
        root.style.animation = 'none';
        void root.offsetWidth;
        root.style.animation = '';
      };

      /* Smooth SPA-like navigation */
      const handleTransition = (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        const a = t.closest('a');
        if (!(a instanceof HTMLAnchorElement)) return;
        if (navigationLocked || e.defaultPrevented) return;
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (a.target && a.target !== '_self') return;
        if (a.hasAttribute('download')) return;
        const href = a.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;

        let url;
        try { url = new URL(a.href, window.location.href); } catch(_) { return; }
        if (url.origin !== window.location.origin) return;
        if (url.pathname === window.location.pathname && url.search === window.location.search) return;

        const root = getPageRoot();
        if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        e.preventDefault();
        navigationLocked = true;
        root.classList.add('is-leaving');
        setTimeout(() => { window.location.assign(url.toString()); }, PAGE_EXIT_DURATION);
      };

      /* Keep article tables readable on narrow screens without widening the page. */
      const wrapTables = () => {
        document.querySelectorAll('.prose table').forEach((tbl) => {
          if (tbl.parentElement && tbl.parentElement.classList.contains('table-wrapper')) return;
          const wrapper = document.createElement('div');
          wrapper.className = 'table-wrapper';
          tbl.parentNode.insertBefore(wrapper, tbl);
          wrapper.appendChild(tbl);
        });
      };

      /* Init */
      const init = () => {
        navigationLocked = false;
        const root = getPageRoot();
        if (root) root.classList.remove('is-leaving');
        triggerPageEnter();
        wrapTables();
      };

      document.addEventListener('click', handleTransition);
      document.addEventListener('astro:page-load', init);
      window.addEventListener('pageshow', () => {
        navigationLocked = false;
        const root = getPageRoot();
        if (root) {
          root.classList.remove('is-leaving');
          triggerPageEnter();
        }
      });
      init();

      /* Back to top */
      const backBtn = document.getElementById('back-to-top');
      if (backBtn) {
        const toggleBtn = () => { backBtn.classList.toggle('visible', window.scrollY > BACK_TO_TOP_THRESHOLD); };
        window.addEventListener('scroll', toggleBtn, { passive: true });
        backBtn.addEventListener('click', () => { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      }
    })();
  </script>

  <script is:inline define:vars={{ themeStorageKey: SITE.THEME_STORAGE_KEY, themeLight: SITE.THEME, themeDark: 'paper-dark', themeColorLight: SITE.THEME_COLOR, themeColorDark: SITE.THEME_COLOR_DARK }}>
    // @ts-nocheck
    (function () {
      var KEY = themeStorageKey;
      var LIGHT = themeLight;
      var DARK = themeDark;

      function currentTheme() {
        return document.documentElement.getAttribute('data-theme') === DARK ? DARK : LIGHT;
      }

      function updateToggleUI(theme) {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var isDark = theme === DARK;
        btn.setAttribute('aria-label', isDark ? '切换亮色模式' : '切换深色模式');
        btn.setAttribute('title', isDark ? '切换到亮色' : '切换到深色');
        btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
      }

      function applyTheme(theme, persist) {
        var next = theme === DARK ? DARK : LIGHT;
        document.documentElement.setAttribute('data-theme', next);
        document.documentElement.style.colorScheme = next === DARK ? 'dark' : 'light';
        var meta = document.getElementById('meta-theme-color') || document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', next === DARK ? themeColorDark : themeColorLight);
        if (persist) {
          try { localStorage.setItem(KEY, next); } catch (e) {}
        }
        updateToggleUI(next);
        window.dispatchEvent(new CustomEvent('b0-theme-change', { detail: { theme: next } }));
      }

      function bindToggle() {
        var btn = document.getElementById('theme-toggle');
        if (!btn || btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', function () {
          applyTheme(currentTheme() === DARK ? LIGHT : DARK, true);
        });
        updateToggleUI(currentTheme());
      }

      bindToggle();
      document.addEventListener('astro:page-load', bindToggle);
      window.addEventListener('pageshow', function () { updateToggleUI(currentTheme()); });
    })();
  </script>

  <script is:inline define:vars={{ serviceWorkerUrl: withBase('/sw.js'), serviceWorkerScope: withBase('/') }}>
    if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost')) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register(serviceWorkerUrl, { scope: serviceWorkerScope }).catch(() => {});
      });
    }
  </script>

</body>
</html>
