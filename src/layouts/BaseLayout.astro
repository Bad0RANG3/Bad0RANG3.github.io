---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
}

const { title = siteConfig.title, description = siteConfig.description, ogImage = siteConfig.ogImage, type = 'website' } = Astro.props;
const currentPath = Astro.url.pathname;
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const canonicalUrl = new URL(currentPath, siteConfig.siteUrl).toString();
const socialImageUrl = new URL(ogImage, siteConfig.siteUrl).toString();
---

<!doctype html>
<html lang="zh" data-theme="winter">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href="/rss.xml">
  <link rel="icon" href="/ico.ico" type="image/x-icon">
  <noscript><style>.page-enter,.reveal{opacity:1!important;transform:none!important}</style></noscript>
  <meta property="og:type" content={type}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={socialImageUrl}>
  <meta property="og:site_name" content={siteConfig.title}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={socialImageUrl}>
  <script is:inline>
    (function(){
      var t=localStorage.getItem('theme');
      var p=window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', (t?t==='dracula':p)?'dracula':'winter');
    })();
  </script>
</head>
<body class="flex flex-col min-h-screen bg-base-100 text-base-content">
  <SiteHeader currentPath={currentPath} />
  <main class="page-enter flex-grow" data-page-enter data-reveal-root>
    <slot />
  </main>
  <SiteFooter />

  <button id="back-to-top" class="fixed bottom-6 right-6 z-50 btn btn-circle btn-primary shadow-lg" aria-label="回到顶部" title="回到顶部">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 15l-6-6-6 6"/></svg>
  </button>

  <script is:inline>
    var PAGE_EXIT_DURATION=160,navigationLocked=!1;
    var getPageRoot=function(){var e=document.querySelector('[data-page-enter]');return e instanceof HTMLElement?e:null};
    var initPageEnter=function(){var e=getPageRoot();if(!e)return;e.classList.remove('is-leaving','is-visible');void e.offsetWidth;e.classList.add('is-visible')};
    var initReveal=function(){if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){document.querySelectorAll('[data-reveal]').forEach(function(e){e.classList.add('is-visible')});return}var e=new IntersectionObserver(function(t){t.forEach(function(t){if(t.isIntersecting){t.target.classList.add('is-visible');e.unobserve(t.target)}})},{threshold:0.1,rootMargin:'0px 0px -6% 0px'});document.querySelectorAll('[data-reveal]').forEach(function(t){e.observe(t)})};
    var wrapTables=function(){document.querySelectorAll('.prose-resource-list table').forEach(function(e){if(e.parentElement&&e.parentElement.classList.contains('table-wrapper'))return;var t=document.createElement('div');t.className='table-wrapper';e.parentNode.insertBefore(t,e);t.appendChild(e)})};
    var handleTransition=function(e){var t=e.target;if(!(t instanceof Element))return;var n=t.closest('a');if(!(n instanceof HTMLAnchorElement))return;if(navigationLocked||e.defaultPrevented)return;if(e.button!==0||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;if(n.target&&n.target!=='_self')return;if(n.hasAttribute('download'))return;var o=n.getAttribute('href');if(!o||o.startsWith('#')||o.startsWith('mailto:')||o.startsWith('tel:'))return;var r=new URL(n.href,window.location.href);if(r.origin!==window.location.origin)return;if(r.pathname===window.location.pathname&&r.search===window.location.search)return;var i=getPageRoot();if(!i||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;e.preventDefault();navigationLocked=!0;i.classList.remove('is-visible');i.classList.add('is-leaving');setTimeout(function(){window.location.assign(r.toString())},PAGE_EXIT_DURATION)};
    var init=function(){navigationLocked=!1;initPageEnter();initReveal();wrapTables()};
    document.addEventListener('click',handleTransition);document.addEventListener('astro:page-load',init);window.addEventListener('pageshow',function(){navigationLocked=!1});init();
(function(){var b=document.getElementById('back-to-top');if(!b)return;var t=function(){b.classList.toggle('visible',window.scrollY>300)};window.addEventListener('scroll',t,{passive:!0});b.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'})})})();
  </script>
</body>
</html>
