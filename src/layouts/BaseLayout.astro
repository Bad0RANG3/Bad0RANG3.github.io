---
import '../styles/theme.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SearchModal from '../components/search/SearchModal.astro';
import { ROUTES } from '../config/routes';
import { SITE, siteConfig } from '../config/site';
import { LAYOUT } from '../config/ui';
import { siteUrl, withBase } from '../lib/urls';

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  canonical?: string;
  noindex?: boolean;
  lang?: string;
  articleSection?: string;
  keywords?: string[];
  breadcrumbs?: Breadcrumb[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  ogImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  canonical,
  noindex = false,
  lang = SITE.LANG,
  articleSection,
  keywords = [],
  breadcrumbs,
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const siteRootUrl = siteUrl('/');
const canonicalUrl = canonical ? siteUrl(canonical) : siteUrl(currentPath);
const socialImageUrl = siteUrl(ogImage);
const authorImageUrl = siteUrl(siteConfig.author.avatar);
const backToTopThreshold = LAYOUT.BACK_TO_TOP_THRESHOLD;
const themeLight = 'paper';
const themeDark = 'paper-dark';
const themeColorLight = SITE.THEME_COLOR;
const themeColorDark = SITE.THEME_COLOR_DARK;
const isProduction = import.meta.env.PROD;
const latinRange = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const latinExtRange = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const japaneseFontFaces = [
  ['yuruka-kana.woff2', 'U+3000-303F,U+3040-309F,U+30A0-30FF,U+31F0-31FF,U+FF00-FFEF'],
  ['yuruka-cjk1.woff2', 'U+4E00-77FF'],
  ['yuruka-cjk2.woff2', 'U+7800-9FFF'],
].map(([file, range]) => `@font-face{font-family:"Yuruka Article";src:url("${withBase(`/fonts/${file}`)}") format("woff2");font-weight:400 700;font-style:normal;font-display:swap;unicode-range:${range};}`).join('');
// JetBrains Mono is self-hosted so the site never blocks on a third-party CDN
// (and the smoke test's no-external-font policy stays green). Google serves it
// as a variable font, so one file per subset and style covers every weight.
const monoFontFaces = [
  ['jetbrains-mono-latin.woff2', 'normal', latinRange],
  ['jetbrains-mono-latin-ext.woff2', 'normal', latinExtRange],
  ['jetbrains-mono-latin-italic.woff2', 'italic', latinRange],
  ['jetbrains-mono-latin-ext-italic.woff2', 'italic', latinExtRange],
].map(([file, style, range]) => `@font-face{font-family:"JetBrains Mono";src:url("${withBase(`/fonts/${file}`)}") format("woff2");font-weight:100 800;font-style:${style};font-display:swap;unicode-range:${range};}`).join('');
const fontFaces = monoFontFaces + japaneseFontFaces;
const primaryFontHref = withBase('/fonts/jetbrains-mono-latin.woff2');
const pageBreadcrumbs = breadcrumbs ?? [
  { name: '首页', path: '/' },
  ...(currentPath === withBase(ROUTES.HOME) ? [] : [{ name: title, path: currentPath }]),
];

const personJsonLd = {
  '@type': 'Person',
  '@id': `${siteRootUrl}#person`,
  name: siteConfig.author.name,
  url: siteRootUrl,
  image: authorImageUrl,
};
const websiteJsonLd = {
  '@type': 'WebSite',
  '@id': `${siteRootUrl}#website`,
  name: siteConfig.title,
  description: siteConfig.description,
  url: siteRootUrl,
  inLanguage: SITE.LANG,
  publisher: { '@id': `${siteRootUrl}#person` },
};
const webpageJsonLd = {
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageTitle,
  description,
  inLanguage: lang,
  isPartOf: { '@id': `${siteRootUrl}#website` },
  primaryImageOfPage: { '@type': 'ImageObject', url: socialImageUrl, caption: ogImageAlt ?? title },
};
const breadcrumbJsonLd = pageBreadcrumbs.length > 1 ? {
  '@type': 'BreadcrumbList',
  itemListElement: pageBreadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: siteUrl(crumb.path),
  })),
} : undefined;
const articleJsonLd = type === 'article' ? {
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: title,
  description,
  image: { '@type': 'ImageObject', url: socialImageUrl, caption: ogImageAlt ?? title },
  url: canonicalUrl,
  inLanguage: lang,
  datePublished: publishedTime,
  dateModified: modifiedTime || publishedTime,
  author: { '@id': `${siteRootUrl}#person` },
  publisher: { '@id': `${siteRootUrl}#person` },
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
  ...(articleSection ? { articleSection } : {}),
  ...(keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
} : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personJsonLd, websiteJsonLd, webpageJsonLd, ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []), ...(articleJsonLd ? [articleJsonLd] : [])],
};
---

<!doctype html>
<html lang={lang} data-theme={SITE.THEME} data-theme-ready="false">
<head>


  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content={siteConfig.author.name}>
  <meta name="theme-color" id="meta-theme-color" content={SITE.THEME_COLOR}>
  <meta name="color-scheme" content="light dark">
  <ClientRouter />
  <style is:inline set:html={fontFaces}></style>
  <script is:inline define:vars={{ themeStorageKey: SITE.THEME_STORAGE_KEY, themeLight, themeDark, themeColorLight, themeColorDark }}>
    // @ts-nocheck
    /* Theme controller.
       Lives in <head> and binds document-level listeners once. Astro's
       ClientRouter de-duplicates identical inline scripts, so a per-page
       script would stop running after the first navigation; delegating and
       reacting to the transition events keeps the theme correct everywhere. */
    (function () {
      var LIGHT = themeLight;
      var DARK = themeDark;
      var media = window.matchMedia('(prefers-color-scheme: dark)');

      function systemTheme() { return media.matches ? DARK : LIGHT; }

      function storedTheme() {
        try {
          var stored = localStorage.getItem(themeStorageKey);
          if (stored === DARK || stored === LIGHT) return stored;
        } catch (e) {}
        return systemTheme();
      }

      function currentTheme() {
        return document.documentElement.getAttribute('data-theme') === DARK ? DARK : LIGHT;
      }

      function updateToggleUI(theme) {
        var button = document.getElementById('theme-toggle');
        if (!button) return;
        var isDark = theme === DARK;
        button.setAttribute('aria-label', isDark ? '切换亮色模式' : '切换深色模式');
        button.setAttribute('title', isDark ? '切换到亮色' : '切换到深色');
        button.setAttribute('aria-pressed', isDark ? 'true' : 'false');
      }

      function paint(doc, theme) {
        var root = doc.documentElement;
        root.setAttribute('data-theme', theme);
        root.style.colorScheme = theme === DARK ? 'dark' : 'light';
        root.setAttribute('data-theme-ready', 'true');
        var meta = doc.getElementById('meta-theme-color') || doc.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === DARK ? themeColorDark : themeColorLight);
      }

      function applyTheme(theme, persist) {
        var next = theme === DARK ? DARK : LIGHT;
        paint(document, next);
        if (persist) {
          try { localStorage.setItem(themeStorageKey, next); } catch (e) {}
        }
        updateToggleUI(next);
        window.dispatchEvent(new CustomEvent('b0-theme-change', { detail: { theme: next } }));
      }

      function syncTheme() { applyTheme(storedTheme(), false); }

      // Always repaint on execution: this script can re-run once during the
      // first ClientRouter navigation. Painting is idempotent.
      paint(document, storedTheme());

      // Register listeners only once per page session.
      if (window.__b0ThemeBound) return;
      window.__b0ThemeBound = true;

      // Paint the incoming document before ClientRouter swaps it in, so the
      // SSR light default never flashes over a dark preference.
      document.addEventListener('astro:before-swap', function (event) {
        var incoming = event.newDocument;
        if (incoming && incoming.documentElement) paint(incoming, storedTheme());
      });

      // Belt-and-suspenders: re-assert after the swap in case anything else
      // touched the root attributes.
      document.addEventListener('astro:after-swap', function () {
        paint(document, storedTheme());
      });

      // Last line of defence: if any other script (older cached bundle, an
      // extension, a transition race) rewrites data-theme, snap it back to the
      // preference we actually resolved. Idempotent, so it cannot loop.
      new MutationObserver(function () {
        var wanted = storedTheme();
        if (document.documentElement.getAttribute('data-theme') !== wanted) paint(document, wanted);
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      // Delegated so the control keeps working after the header is replaced.
      document.addEventListener('click', function (event) {
        var target = event.target;
        var button = target instanceof Element ? target.closest('#theme-toggle') : null;
        if (button) applyTheme(currentTheme() === DARK ? LIGHT : DARK, true);
      });

      media.addEventListener?.('change', function () {
        try {
          if (localStorage.getItem(themeStorageKey)) return;
        } catch (e) {}
        applyTheme(systemTheme(), false);
      });

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', syncTheme, { once: true });
      else syncTheme();
      document.addEventListener('astro:page-load', syncTheme);
      window.addEventListener('pageshow', syncTheme);
    })();
  </script>
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"}>

  <link rel="canonical" href={canonicalUrl}>
  <link rel="manifest" href={withBase(ROUTES.MANIFEST)}>
  <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href={withBase(ROUTES.RSS)}>
  <link rel="alternate" type="application/atom+xml" title={`${siteConfig.title} Atom`} href={withBase(ROUTES.ATOM)}>
  <link rel="alternate" type="application/feed+json" title={`${siteConfig.title} JSON Feed`} href={withBase(ROUTES.JSON_FEED)}>
  <link rel="preload" as="font" type="font/woff2" crossorigin href={primaryFontHref}>
  <link rel="icon" href={withBase('/ico.ico')} type="image/x-icon">

  <!-- Open Graph -->
  <meta property="og:type" content={type}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={socialImageUrl}>
  <meta property="og:image:alt" content={ogImageAlt ?? title}>
  <meta property="og:site_name" content={siteConfig.title}>
  <meta property="og:locale" content={SITE.LOCALE}>
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
  {articleSection && <meta property="article:section" content={articleSection}>}
  {keywords.map((keyword) => <meta property="article:tag" content={keyword}>)}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={socialImageUrl}>
  <meta name="twitter:image:alt" content={ogImageAlt ?? title}>
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')}>}

  <!-- JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</head>

  <body class="site-body flex min-h-screen flex-col overflow-x-hidden bg-base-100 text-base-content">
  <div class="site-atmosphere" aria-hidden="true" transition:persist="site-atmosphere">
    <canvas id="sakura-canvas"></canvas>
    <span class="atmosphere-orb atmosphere-orb--pink"></span>
    <span class="atmosphere-orb atmosphere-orb--violet"></span>
    <span class="atmosphere-orb atmosphere-orb--blue"></span>
    <span class="atmosphere-grid"></span>
    <span class="atmosphere-noise"></span>
  </div>
  <img
    class="site-mascot"
    src={withBase('/mascot/chibi-girl.webp')}
    alt=""
    width="640"
    height="640"
    aria-hidden="true"
    decoding="async"
    transition:persist="site-mascot"
  />
  <SiteHeader currentPath={currentPath} />
  <main id="main-content" class="page-enter w-full flex-1">
    <slot />
  </main>
  <SiteFooter />
  <SearchModal />

  <script is:inline>
    (() => {
      const canvas = document.getElementById('sakura-canvas');
      if (!(canvas instanceof HTMLCanvasElement) || canvas.dataset.bound === '1') return;
      canvas.dataset.bound = '1';
      const context = canvas.getContext('2d');
      if (!context) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let blossoms = [];
      let motes = [];
      let frame = 0;
      let width = 0;
      let height = 0;
      let ratio = 1;
      const seed = () => {
        // A denser, faster scene that still caps its work on large displays.
        const amount = Math.min(96, Math.max(42, Math.round((width * height) / 36000)));
        blossoms = Array.from({ length: amount }, (_, index) => ({
          x: Math.random() * width,
          y: Math.random() * height,
          radius: 16 + Math.random() * 38,
          depth: 0.38 + Math.random() * 0.62,
          speed: 0.18 + Math.random() * 0.34,
          sway: 0.00042 + Math.random() * 0.00058,
          phase: Math.random() * Math.PI * 2,
          alpha: 0.08 + Math.random() * 0.15,
          spin: (Math.random() - 0.5) * 0.0026,
          angle: Math.random() * Math.PI,
          tone: index % 3,
        }));

        motes = Array.from({ length: Math.min(36, Math.max(18, Math.round(width / 58))) }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          size: 1 + Math.random() * 2.8,
          speed: 0.18 + Math.random() * 0.36,
          phase: Math.random() * Math.PI * 2,
          alpha: 0.08 + Math.random() * 0.14,
        }));
      };

      const resize = () => {
        ratio = Math.min(window.devicePixelRatio || 1, 1.4);
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
        seed();
      };

      const drawBlossom = (flower, time) => {
        const driftX = Math.sin(time * flower.sway + flower.phase) * 34 * flower.depth;
        const driftY = Math.cos(time * flower.sway * 0.72 + flower.phase) * 20 * flower.depth;
        const colors = [
          ['#ff91af', '#ffd3df'],
          ['#e56e91', '#ffb6c9'],
          ['#b174b7', '#efafd5'],
        ];
        const [outer, inner] = colors[flower.tone];

        context.save();
        context.translate(flower.x + driftX, flower.y + driftY);
        context.rotate(flower.angle);
        const edgeDistance = Math.abs((flower.x / Math.max(width, 1)) - 0.5) * 2;
        context.globalAlpha = flower.alpha * (0.42 + edgeDistance * 0.58);
        context.lineWidth = Math.max(0.7, flower.radius * 0.018);
        context.strokeStyle = outer;

        for (let petal = 0; petal < 5; petal += 1) {
          context.save();
          context.rotate((Math.PI * 2 * petal) / 5);
          context.beginPath();
          context.ellipse(0, -flower.radius * 0.37, flower.radius * 0.25, flower.radius * 0.46, 0, 0, Math.PI * 2);
          context.fillStyle = petal % 2 === 0 ? outer : inner;
          context.fill();
          context.stroke();
          context.restore();
        }

        context.beginPath();
        context.arc(0, 0, flower.radius * 0.13, 0, Math.PI * 2);
        context.fillStyle = '#ffe2c5';
        context.fill();
        context.restore();
      };

      const drawMote = (mote, time) => {
        context.save();
        context.translate(mote.x + Math.sin(time * 0.00045 + mote.phase) * 18, mote.y);
        context.rotate(mote.phase + time * 0.00016);
        context.globalAlpha = mote.alpha;
        context.fillStyle = '#ffd1df';
        context.beginPath();
        context.ellipse(0, 0, mote.size * 1.8, mote.size, Math.PI / 4, 0, Math.PI * 2);
        context.fill();
        context.restore();
      };

      const render = () => {
        const time = performance.now();
        context.clearRect(0, 0, width, height);
        blossoms.forEach((flower) => {
          drawBlossom(flower, time);
          if (!reduceMotion.matches) {
            flower.y += flower.speed;
            flower.angle += flower.spin;
          }
          if (flower.y - flower.radius > height + 50) {
            flower.x = Math.random() * width;
            flower.y = -flower.radius - Math.random() * height * 0.18;
          }
        });

        motes.forEach((mote) => {
          drawMote(mote, time);
          if (!reduceMotion.matches) mote.y += mote.speed;
          if (mote.y > height + 12) {
            mote.x = Math.random() * width;
            mote.y = -12;
          }
        });

        if (!reduceMotion.matches) frame = requestAnimationFrame(render);
      };

      const refresh = () => {
        cancelAnimationFrame(frame);
        resize();
        render();
      };

      window.addEventListener('resize', refresh, { passive: true });
      reduceMotion.addEventListener?.('change', refresh);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(frame);
        else refresh();
      });
      refresh();
    })();
  </script>

  <!-- Back to top -->
  <button id="back-to-top" class="back-to-top fixed bottom-6 right-6 z-50" aria-label="回到顶部" title="回到顶部" transition:persist="back-to-top">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 15l-6-6-6 6"/></svg>
  </button>

  <script is:inline define:vars={{ backToTopThreshold }}>
    // @ts-nocheck
    /* ── Page transition + back-to-top + table wrapping ── */
    (function(){
      const BACK_TO_TOP_THRESHOLD = backToTopThreshold;

      const getPageRoot = () => {
        const el = document.querySelector('.page-enter');
        return el instanceof HTMLElement ? el : null;
      };

      const triggerPageEnter = () => {
        const root = getPageRoot();
        if (!root) return;
        root.style.animation = 'none';
        void root.offsetWidth;
        root.style.animation = '';
      };

      /* Keep article tables readable on narrow screens without widening the page. */
      const wrapTables = () => {
        document.querySelectorAll('.prose table').forEach((tbl) => {
          if (tbl.parentElement && tbl.parentElement.classList.contains('table-wrapper')) return;
          const wrapper = document.createElement('div');
          wrapper.className = 'table-wrapper';
          tbl.parentNode.insertBefore(wrapper, tbl);
          wrapper.appendChild(tbl);
        });
      };

      /* Init */
      const init = () => {
        const root = getPageRoot();
        if (root) root.classList.remove('is-leaving');
        triggerPageEnter();
        wrapTables();
      };

      document.addEventListener('astro:page-load', init);
      window.addEventListener('pageshow', () => {
        const root = getPageRoot();
        if (root) {
          root.classList.remove('is-leaving');
          triggerPageEnter();
        }
      });
      init();

      /* Back to top */
      const backBtn = document.getElementById('back-to-top');
      if (backBtn) {
        const toggleBtn = () => { backBtn.classList.toggle('visible', window.scrollY > BACK_TO_TOP_THRESHOLD); };
        window.addEventListener('scroll', toggleBtn, { passive: true });
        backBtn.addEventListener('click', () => { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      }
    })();
  </script>

  <script is:inline define:vars={{ isProduction, serviceWorkerUrl: withBase(ROUTES.SERVICE_WORKER), serviceWorkerScope: withBase(ROUTES.HOME) }}>
    if (!isProduction && 'serviceWorker' in navigator) {
      navigator.serviceWorker.getRegistrations().then((registrations) => {
        registrations.forEach((registration) => registration.unregister());
      }).catch(() => {});
    } else if ('serviceWorker' in navigator && location.protocol === 'https:') {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register(serviceWorkerUrl, { scope: serviceWorkerScope }).catch(() => {});
      });
    }
  </script>

</body>
</html>
